<ovo:OvoWindow
    Height="450"
    Icon="avares://OvoUi.Test/Assets/icon_256.png"
    IsFullScreenTransitionAnimationEnabled="False"
    IsTitleBarVisible="False"
    Title="Custom Title Bar"
    Width="800"
    ovo:OvoTitleBar.IsMinimizeButtonVisible="False"
    ovo:OvoTitleBar.TitleBarHeight="48"
    x:Class="OvoUi.Test.TitleBarExample"
    xmlns="https://github.com/avaloniaui"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="*,Auto">
        <TextBox AcceptsReturn="True" Margin="16" />
        <ovo:OvoTitleBar
            ControlButtonMargin="0,0,8,0"
            Grid.Row="1"
            IsMinimizeButtonVisible="True"
            TitleBarHeight="40">
            <ovo:OvoTitleBar.LeadingContent>
                <TextBlock
                    Margin="12,0"
                    Text="Custom Title Bar"
                    VerticalAlignment="Center" />
            </ovo:OvoTitleBar.LeadingContent>
        </ovo:OvoTitleBar>
    </Grid>
</ovo:OvoWindow>
