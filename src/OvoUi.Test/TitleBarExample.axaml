<ovo:OvoWindow
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    x:Class="OvoUi.Test.TitleBarExample"
    Title="Custom Title Bar"
    Width="800"
    Height="450"
    IsTitleBarVisible="False"
    ovo:OvoTitleBar.TitleBarHeight="48"
    ovo:OvoTitleBar.IsMinimizeButtonVisible="False">
    <Grid RowDefinitions="*,Auto">
        <TextBox Margin="16" AcceptsReturn="True" />
        <ovo:OvoTitleBar
            Grid.Row="1"
            TitleBarHeight="40"
            ControlButtonMargin="0,0,8,0"
            IsMinimizeButtonVisible="True">
            <ovo:OvoTitleBar.LeadingContent>
                <TextBlock Margin="12,0" VerticalAlignment="Center" Text="Custom Title Bar" />
            </ovo:OvoTitleBar.LeadingContent>
        </ovo:OvoTitleBar>
    </Grid>
</ovo:OvoWindow>
