<Window
    Title="OvoUi.Test"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="OvoUi.Test.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel Spacing="20">
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <ColorPicker HsvColor="hsv(180,80%,70%)" Theme="{StaticResource SimpleColorPicker}" />
                <ColorPicker HsvColor="hsv(180,80%,70%)" Theme="{StaticResource HexSimpleColorPicker}" />
                <ovo:OvoColorPicker
                    HsvColor="hsv(180,80%,70%)"
                    SelectedIndex="1"
                    Theme="{StaticResource HexSimpleColorPicker}" />
            </StackPanel>
        </StackPanel>
        <StackPanel
            HorizontalAlignment="Left"
            Orientation="Horizontal"
            VerticalAlignment="Top">
            <Button Click="Dark" Content="Dark" />
            <Button Click="Light" Content="Light" />
        </StackPanel>
    </Grid>
</Window>
