<Window
    Title="OvoUi.Test"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="OvoUi.Test.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            Spacing="10"
            VerticalAlignment="Center">
            <TextBox MinWidth="200" PlaceholderText="Input" />
            <TextBox
                Classes="clear"
                MinWidth="200"
                PlaceholderText="Input" />
            <TextBox
                Classes="border"
                MinWidth="200"
                PlaceholderText="Input" />
            <TextBox
                Classes="border clear"
                MinWidth="200"
                PlaceholderText="Input" />
            <TextBox
                Classes="border_focus"
                MinWidth="200"
                PlaceholderText="Input" />
            <TextBox
                Classes="reveal_password"
                MinWidth="200"
                PlaceholderText="Input" />
            <TextBox Classes="text_area" PlaceholderText="Input" />
            <TextBox PlaceholderText="Input" Theme="{StaticResource LooklessTextBoxTheme}" />
            <TextBox PlaceholderText="Input" Theme="{StaticResource BorderTextBoxTheme}" />
            <TextBox MinWidth="200" PlaceholderText="Input" />
        </StackPanel>
        <StackPanel
            HorizontalAlignment="Left"
            Orientation="Horizontal"
            VerticalAlignment="Top">
            <Button Click="Dark" Content="Dark" />
            <Button Click="Light" Content="Light" />
        </StackPanel>
    </Grid>
</Window>
