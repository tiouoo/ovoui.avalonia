<Window
    Title="OvoUi.Test"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="OvoUi.Test.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            Spacing="10"
            VerticalAlignment="Center">
            <DatePicker Classes="border_focus clear" />
            <CalendarDatePicker Classes="border_focus clear" HorizontalAlignment="Stretch" />
            <ComboBox Classes="border_focus" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Apple" />
                <ComboBoxItem Content="Banana" />
                <ComboBoxItem Content="Cherry" />
                <ComboBoxItem Content="Date" />
            </ComboBox>

            <AutoCompleteBox Classes="clear" Name="AutoCompleteBox" />
            <HyperlinkButton Content="Hello" />
            <HyperlinkButton Classes="underline" Content="Hello" />
            <HyperlinkButton Classes="underline_focus" Content="Hello" />
            <HyperlinkButton Classes="del" Content="Hello" />

        </StackPanel>
        <StackPanel
            HorizontalAlignment="Left"
            Orientation="Horizontal"
            VerticalAlignment="Top">
            <Button Click="Dark" Content="Dark" />
            <Button Click="Light" Content="Light" />
        </StackPanel>
    </Grid>
</Window>
