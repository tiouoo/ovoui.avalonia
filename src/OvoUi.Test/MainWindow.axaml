<ovo:OvoWindow
    Title="OvoUi.Avalonia.Test"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="OvoUi.Test.MainWindow"
    x:DataType="test:MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:test="clr-namespace:OvoUi.Test"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            Margin="20"
            Orientation="Horizontal"
            Spacing="20"
            VerticalAlignment="Center">
            <ovo:TreeComboBox Width="300">
                <ovo:TreeComboBoxItem Header="Hello">
                    <ovo:TreeComboBoxItem Header="Hello World" />
                </ovo:TreeComboBoxItem>
                <ovo:TreeComboBoxItem Header="World" />
            </ovo:TreeComboBox>
            <Button Click="Button_OnClick1" Content="Open Window" />

        </StackPanel>
        <StackPanel
            HorizontalAlignment="Left"
            Orientation="Horizontal"
            VerticalAlignment="Top">
            <Button Click="Dark" Content="Dark" />
            <Button Click="Light" Content="Light" />
        </StackPanel>
    </Grid>
</ovo:OvoWindow>
