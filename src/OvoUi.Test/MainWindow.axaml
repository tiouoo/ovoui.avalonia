<ovo:OvoWindow
    Title="OvoUi.Avalonia.Test"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="OvoUi.Test.MainWindow"
    x:DataType="test:MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:test="clr-namespace:OvoUi.Test"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            Margin="20"
            Spacing="20"
            VerticalAlignment="Center">
            <ovo:TreeComboBox Width="300">
                <ovo:TreeComboBoxItem Header="Hello">
                    <ovo:TreeComboBoxItem Header="Hello World" />
                </ovo:TreeComboBoxItem>
                <ovo:TreeComboBoxItem Header="World" />
            </ovo:TreeComboBox>
            <Button Click="Button_OnClick1" Content="Open Window" />

            <TextBox PlaceholderText="Hii" />

            <Border
                Margin="20"
                MinHeight="400"
                MinWidth="600">
                <Menu VerticalAlignment="Top">
                    <MenuItem Header="File">
                        <MenuItem
                            Header="Open"
                            Icon="🗎"
                            InputGesture="Ctrl + O">
                            <MenuItem Header="Recent file 1" Icon="🗎" />
                            <MenuItem Header="Recent file 2" Icon="🗎" />
                            <MenuItem Header="Recent file 3" Icon="🗎" />
                            <MenuItem Header="Recent file 4" Icon="🗎" />
                            <Separator />
                            <MenuItem
                                Header="Clear recent files"
                                Icon="🗙"
                                InputGesture="Ctrl + Alt + O" />
                        </MenuItem>
                        <MenuItem
                            Header="Save"
                            Icon="💾"
                            InputGesture="Ctrl + S" />
                        <MenuItem
                            Header="Fullscreen"
                            HotKey="F11"
                            Icon="⛶"
                            InputGesture="F11" />
                        <MenuItem
                            Header="Close"
                            Icon="🗙"
                            InputGesture="Alt + F4" />
                    </MenuItem>

                    <MenuItem Header="View">
                        <MenuItem Header="Grid options">
                            <MenuItem Header="Show grid lines" />
                            <MenuItem Header="Show grid separator" />
                            <MenuItem Header="Show grid " />
                        </MenuItem>
                        <MenuItem Header="Title bar" />
                    </MenuItem>

                    <MenuItem Header="Help">
                        <MenuItem Header="About" />
                        <MenuItem Header="Website" />
                        <MenuItem Header="Discussions" />
                        <MenuItem Header="Donate" />
                    </MenuItem>
                </Menu>
            </Border>
        </StackPanel>
        <StackPanel
            HorizontalAlignment="Left"
            Orientation="Horizontal"
            VerticalAlignment="Top">
            <Button Click="Dark" Content="Dark" />
            <Button Click="Light" Content="Light" />
        </StackPanel>
    </Grid>
</ovo:OvoWindow>
