<UserControl
    x:Class="OvoUi.Demo.Pages.ShimmerPage"
    x:CompileBindings="False"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="ShimmerText">
        <ovo:ControlShowcase Header="Animated text" SourceKey="shows-shimmer-text">
            <StackPanel Spacing="16">
                <ToggleSwitch
                    Content="Animate"
                    IsChecked="True"
                    Name="Active" />
                <ovo:ShimmerText
                    FontSize="28"
                    FontWeight="SemiBold"
                    IsActive="{Binding #Active.IsChecked}"
                    Text="Generating a thoughtful response..." />
                <ovo:ShimmerText
                    BaseColor="#60646C"
                    Duration="0:0:0.8"
                    FontSize="20"
                    HighlightColor="#E5484D"
                    IsActive="{Binding #Active.IsChecked}"
                    Text="Custom colors and duration" />
                <ovo:ShimmerSelectableText
                    FontSize="18"
                    IsActive="{Binding #Active.IsChecked}"
                    Text="This shimmering text remains selectable." />
            </StackPanel>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>