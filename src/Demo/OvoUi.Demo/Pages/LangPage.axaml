<UserControl
    x:Class="OvoUi.Demo.Pages.LangPage"
    x:DataType="models:LangDemoViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:models="using:OvoUi.Demo.Models"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="OvoUi.Lang">
        <ovo:ControlShowcase Header="Language · shared across independent JSON and RESX managers" SourceKey="lang-picker">
            <ovo:CulturePicker
                Cultures="{Binding Cultures}"
                HorizontalAlignment="Left"
                Managers="{Binding Managers}"
                MinWidth="210" />
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="JSON · Translate and ViewModel stream bindings" SourceKey="lang-json">
            <StackPanel Spacing="10">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="{ovo:Translate {x:Static models:DemoLanguage+Keys.App_Title}}" />
                <TextBlock Text="{Binding Greeting^}" TextWrapping="Wrap" />
                <TextBlock Text="{ovo:Translate {x:Static models:DemoLanguage+Keys.Greeting}}" TextWrapping="Wrap" />
            </StackPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Explicit Chinese file · whole-file replacement and per-key fallback" SourceKey="lang-fallback">
            <StackPanel Spacing="10">
                <TextBlock
                    Opacity="0.65"
                    Text="Select 简体中文: Greeting uses the explicit file; the next lines fall back to zh-Hans and the default file."
                    TextWrapping="Wrap" />
                <TextBlock Text="{ovo:Translate {x:Static models:DemoLanguage+Keys.ParentOnly}}" TextWrapping="Wrap" />
                <TextBlock Text="{ovo:Translate {x:Static models:DemoLanguage+Keys.DefaultOnly}}" TextWrapping="Wrap" />
            </StackPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="RESX · same API" SourceKey="lang-resx">
            <TextBlock Text="{ovo:Translate {x:Static models:DemoResxLanguage+Keys.Greeting}}" />
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Reactive formatting · numbers follow the selected culture" SourceKey="lang-format">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <NumericUpDown
                        Maximum="100"
                        Minimum="1"
                        Value="{Binding PageNumber}"
                        Width="120" />
                    <NumericUpDown
                        Increment="0.5"
                        Maximum="1000000"
                        Minimum="0"
                        Value="{Binding Amount}"
                        Width="180" />
                </StackPanel>
                <TextBlock Text="{Binding FormattedText^}" />
                <TextBlock>
                    <TextBlock.Text>
                        <ovo:FormatTranslate FormatKey="{x:Static models:DemoLanguage+Keys.Page_Template}">
                            <ovo:TranslateEntry Binding="{Binding PageNumber}" />
                            <ovo:TranslateEntry Binding="{Binding Amount}" />
                        </ovo:FormatTranslate>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Runtime override · patch the selected language and restore it" SourceKey="lang-runtime">
            <StackPanel Spacing="10">
                <TextBox PlaceholderText="Your translation" Text="{Binding CustomGreeting}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Click="ApplyOverride">Apply override</Button>
                    <Button Click="ClearOverrides">Restore translations</Button>
                </StackPanel>
                <TextBlock Text="{Binding TranslationList}" TextWrapping="Wrap" />
                <TextBlock
                    Opacity="0.65"
                    Text="In your IDE, hover DemoLanguage.Instance.Greeting or DemoLanguage.Keys.Greeting to see all configured translations."
                    TextWrapping="Wrap" />
            </StackPanel>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>