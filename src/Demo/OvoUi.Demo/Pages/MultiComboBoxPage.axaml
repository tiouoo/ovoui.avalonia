<UserControl
    x:Class="OvoUi.Demo.Pages.MultiComboBoxPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="MultiComboBox">
        <ovo:ControlShowcase Header="Multiple selection" SourceKey="multi-combo-selection">
            <WrapPanel ItemSpacing="16" LineSpacing="16">
                <ovo:MultiComboBox PlaceholderText="Choose technologies" Width="340">
                    <ovo:MultiComboBoxItem>Avalonia</ovo:MultiComboBoxItem>
                    <ovo:MultiComboBoxItem>.NET</ovo:MultiComboBoxItem>
                    <ovo:MultiComboBoxItem>C#</ovo:MultiComboBoxItem>
                    <ovo:MultiComboBoxItem>Skia</ovo:MultiComboBoxItem>
                </ovo:MultiComboBox>
                <ovo:MultiComboBox
                    Classes="clearButton"
                    InnerLeftContent="Tags"
                    InnerRightContent="Optional"
                    PlaceholderText="Select values"
                    Width="340">
                    <ovo:MultiComboBoxItem>Desktop</ovo:MultiComboBoxItem>
                    <ovo:MultiComboBoxItem>Mobile</ovo:MultiComboBoxItem>
                    <ovo:MultiComboBoxItem>Browser</ovo:MultiComboBoxItem>
                </ovo:MultiComboBox>
            </WrapPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Popup content and states" SourceKey="multi-combo-popup">
            <WrapPanel ItemSpacing="16" LineSpacing="16">
                <ovo:MultiComboBox
                    PlaceholderText="With popup header"
                    PopupInnerBottomContent="Select any number"
                    PopupInnerTopContent="Available platforms"
                    Width="340">
                    <ovo:MultiComboBoxItem>Windows</ovo:MultiComboBoxItem>
                    <ovo:MultiComboBoxItem>macOS</ovo:MultiComboBoxItem>
                    <ovo:MultiComboBoxItem>Linux</ovo:MultiComboBoxItem>
                </ovo:MultiComboBox>
                <ovo:MultiComboBox
                    IsEnabled="False"
                    PlaceholderText="Disabled"
                    Width="340" />
            </WrapPanel>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>