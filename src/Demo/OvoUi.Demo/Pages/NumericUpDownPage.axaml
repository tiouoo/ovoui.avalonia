<UserControl
    x:Class="OvoUi.Demo.Pages.NumericUpDownPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:o="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="NumericUpDown">
        <o:ControlShowcase Header="Ranges and increments" SourceKey="numeric-up-down-ranges">
            <StackPanel Spacing="10">
                <TextBlock>For more style, see ButtonSpinner.</TextBlock>
                <WrapPanel ItemSpacing="16" LineSpacing="16">
                    <NumericUpDown
                        Maximum="100"
                        Minimum="0"
                        Value="25"
                        Width="280" />
                    <NumericUpDown
                        Increment="10"
                        Maximum="100"
                        Minimum="0"
                        Value="50"
                        Width="280" />
                    <NumericUpDown
                        FormatString="0.0"
                        Increment="0.1"
                        Maximum="10"
                        Minimum="-10"
                        Value="1.5"
                        Width="280" />
                </WrapPanel>
            </StackPanel>
        </o:ControlShowcase>
        <o:ControlShowcase Header="Spinner and content" SourceKey="numeric-up-down-content">
            <WrapPanel ItemSpacing="16" LineSpacing="16">
                <NumericUpDown
                    ButtonSpinnerLocation="Left"
                    Value="10"
                    Width="280" />
                <NumericUpDown
                    ShowButtonSpinner="False"
                    Value="10"
                    Width="280" />
                <NumericUpDown
                    InnerLeftContent="Price"
                    InnerRightContent="USD"
                    Value="99"
                    Width="280" />
                <NumericUpDown
                    IsReadOnly="True"
                    Value="42"
                    Width="280" />
                <NumericUpDown
                    IsEnabled="False"
                    Value="42"
                    Width="280" />
            </WrapPanel>
        </o:ControlShowcase>
    </demo:DemoPage>
</UserControl>