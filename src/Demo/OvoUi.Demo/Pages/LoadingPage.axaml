<UserControl
    x:Class="OvoUi.Demo.Pages.LoadingPage"
    x:CompileBindings="False"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="Loading">
        <ovo:ControlShowcase Header="Indicator sizes and styles" SourceKey="loading-indicator-sizes">
            <WrapPanel
                ItemSpacing="28"
                LineSpacing="16"
                VerticalAlignment="Center">
                <ovo:LoadingIcon Classes="small" />
                <ovo:LoadingIcon />
                <ovo:LoadingIcon Classes="large" />
                <ovo:LoadingIcon
                    Height="32"
                    Theme="{StaticResource LoadingIconTrailTheme}"
                    Width="32" />
                <ovo:LoadingIcon
                    Foreground="#E5484D"
                    Height="32"
                    Width="32" />
            </WrapPanel>
        </ovo:ControlShowcase>

        <ovo:ControlShowcase Header="Loading container" SourceKey="loading-container-overlay">
            <StackPanel Spacing="14">
                <ToggleSwitch
                    Content="Loading"
                    IsChecked="True"
                    Name="IsLoading" />
                <ovo:LoadingContainer
                    IsLoading="{Binding #IsLoading.IsChecked}"
                    LoadingMessage="Loading project activity..."
                    MinHeight="230">
                    <Border
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="Project activity" />
                            <ProgressBar Maximum="100" Value="72" />
                            <TextBlock Text="Build completed successfully." />
                            <TextBlock Text="Deploying artifacts to the staging environment." />
                            <Button Content="View deployment" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </ovo:LoadingContainer>
            </StackPanel>
        </ovo:ControlShowcase>

        <ovo:ControlShowcase Header="Custom indicator and message" SourceKey="loading-custom-content">
            <ovo:LoadingContainer IsLoading="True" MinHeight="180">
                <ovo:LoadingContainer.Indicator>
                    <ovo:LoadingIcon
                        Foreground="#2F9E44"
                        Height="40"
                        Theme="{StaticResource LoadingIconTrailTheme}"
                        Width="40" />
                </ovo:LoadingContainer.Indicator>
                <ovo:LoadingContainer.LoadingMessage>
                    <TextBlock
                        FontWeight="SemiBold"
                        Margin="0,10,0,0"
                        Text="Preparing preview" />
                </ovo:LoadingContainer.LoadingMessage>
                <Border Background="{DynamicResource LayerFillColorDefaultBrush}" Height="180" />
            </ovo:LoadingContainer>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>