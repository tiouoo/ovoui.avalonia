<UserControl
    x:Class="OvoUi.Demo.Pages.DisableContainerPage"
    x:CompileBindings="False"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:o="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="DisableContainer">
        <o:ControlShowcase Header="Interactive container" SourceKey="shows-disable-container">
            <StackPanel Spacing="16">
                <ToggleSwitch
                    Content="Enable account editor"
                    IsChecked="True"
                    Name="EnabledSwitch" />

                <o:DisableContainer>
                    <o:DisableContainer.DisabledTip>
                        <StackPanel MaxWidth="260" Spacing="4">
                            <TextBlock FontWeight="Bold" Text="Account editor disabled" />
                            <TextBlock
                                Text="Turn on the switch above to edit fields and use the actions."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </o:DisableContainer.DisabledTip>
                    <Border
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource OvoCornerRadius}"
                        IsEnabled="{Binding #EnabledSwitch.IsChecked}"
                        Padding="20">
                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="16"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                            RowSpacing="12">
                            <TextBlock Text="Profile" FontSize="18" FontWeight="Bold" Grid.ColumnSpan="2" />

                            <TextBlock Grid.Row="1" Text="Display name" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Grid.Row="1" Text="Alex Morgan" />

                            <TextBlock Grid.Row="2" Text="Role" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Grid.Row="2" SelectedIndex="1">
                                <ComboBoxItem Content="Viewer" />
                                <ComboBoxItem Content="Editor" />
                                <ComboBoxItem Content="Administrator" />
                            </ComboBox>

                            <TextBlock Grid.Row="3" Text="Quota" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Grid.Row="3" Orientation="Horizontal" Spacing="12">
                                <Slider Maximum="100" Value="64" Width="220" />
                                <TextBlock Text="64%" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Grid.Row="4" Text="Permissions" VerticalAlignment="Center" />
                            <WrapPanel Grid.Column="1" Grid.Row="4" ItemSpacing="16">
                                <CheckBox Content="Publish" IsChecked="True" />
                                <CheckBox Content="Export" />
                                <CheckBox Content="Invite users" IsChecked="True" />
                            </WrapPanel>

                            <StackPanel
                                Grid.Column="1"
                                Grid.Row="5"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="10">
                                <Button Content="Reset" />
                                <Button Classes="accent" Content="Save changes" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </o:DisableContainer>
            </StackPanel>
        </o:ControlShowcase>
    </demo:DemoPage>
</UserControl>

