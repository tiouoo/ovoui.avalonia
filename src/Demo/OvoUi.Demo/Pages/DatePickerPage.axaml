<UserControl
    x:Class="OvoUi.Demo.Pages.DatePickerPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="DatePicker">
        <ovo:ControlShowcase Header="Date parts" SourceKey="date-picker-parts">
            <WrapPanel ItemSpacing="16" LineSpacing="16">
                <DatePicker />
                <DatePicker Classes="connect" />
                <DatePicker DayFormat="d (ddd)" YearVisible="False" />
                <DatePicker DayVisible="False" />
                <DatePicker MonthVisible="False" />
            </WrapPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Themes and states" SourceKey="date-picker-themes">
            <WrapPanel ItemSpacing="16" LineSpacing="16">
                <DatePicker Classes="clear" />
                <DatePicker Theme="{StaticResource SolidDatePickerTheme}" />
                <DatePicker Theme="{StaticResource BorderDatePickerTheme}" />
                <DatePicker IsEnabled="False" />
            </WrapPanel>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>