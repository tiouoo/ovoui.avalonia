<UserControl
    x:Class="OvoUi.Demo.Pages.ElasticWrapPanelPage"
    x:DataType="pages:ElasticWrapPanelDemoViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:o="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:pages="clr-namespace:OvoUi.Demo.Pages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="o|ElasticWrapPanel.demo &gt; Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
        </Style>
    </UserControl.Styles>
    <demo:DemoPage Text="ElasticWrapPanel">
        <o:ControlShowcase Header="Interactive layout" SourceKey="layout-elastic-wrap-interactive">
            <o:ControlShowcase.CodeBlocks>
                <o:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                <o:ShowcaseCodeBlock Code="{Binding SourceCode}" Header="C#" Language="csharp" />
            </o:ControlShowcase.CodeBlocks>
            <Grid ColumnDefinitions="280,*" ColumnSpacing="20">
                <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock FontWeight="SemiBold" Text="Panel settings" />
                        <TextBlock Text="Orientation" />
                        <ComboBox ItemsSource="{Binding Orientations}" SelectedItem="{Binding SelectedOrientation}" />
                        <TextBlock Text="Horizontal scrollbar" />
                        <ComboBox ItemsSource="{Binding ScrollBarVisibilities}" SelectedItem="{Binding HorizontalVisibility}" />
                        <TextBlock Text="Vertical scrollbar" />
                        <ComboBox ItemsSource="{Binding ScrollBarVisibilities}" SelectedItem="{Binding VerticalVisibility}" />
                        <CheckBox Content="Fill horizontally" IsChecked="{Binding IsFillHorizontal}" />
                        <CheckBox Content="Fill vertically" IsChecked="{Binding IsFillVertical}" />
                        <TextBlock Text="{Binding ItemWidth, StringFormat='Item width: {0:F0}'}" />
                        <Slider Maximum="220" Minimum="24" Value="{Binding ItemWidth}" />
                        <TextBlock Text="{Binding ItemHeight, StringFormat='Item height: {0:F0}'}" />
                        <Slider Maximum="160" Minimum="24" Value="{Binding ItemHeight}" />
                        <TextBlock Text="{Binding ItemSpacing, StringFormat='Item spacing: {0:F0}'}" />
                        <Slider Maximum="40" Minimum="-10" Value="{Binding ItemSpacing}" />
                        <TextBlock Text="{Binding LineSpacing, StringFormat='Line spacing: {0:F0}'}" />
                        <Slider Maximum="40" Minimum="-10" Value="{Binding LineSpacing}" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="1" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontWeight="SemiBold" Text="Live preview" />
                        <TextBlock Grid.Column="1" Text="{Binding #interactivePanel.LineCount, StringFormat='Lines: {0}'}" />
                    </Grid>
                    <Border
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="430"
                        Padding="8">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="{Binding HorizontalVisibility}"
                            VerticalScrollBarVisibility="{Binding VerticalVisibility}">
                            <o:ElasticWrapPanel
                                Classes="demo"
                                IsFillHorizontal="{Binding IsFillHorizontal}"
                                IsFillVertical="{Binding IsFillVertical}"
                                ItemHeight="{Binding ItemHeight}"
                                ItemSpacing="{Binding ItemSpacing}"
                                ItemWidth="{Binding ItemWidth}"
                                LineSpacing="{Binding LineSpacing}"
                                Name="interactivePanel"
                                Orientation="{Binding SelectedOrientation}">
                                <Border Background="#22F93920"><TextBlock Text="One" /></Border>
                                <Border Background="#22E91E63"><TextBlock Text="Two" /></Border>
                                <Border Background="#229E28B3"><TextBlock Text="Three" /></Border>
                                <Border Background="#226A3AC7"><TextBlock Text="Four" /></Border>
                                <Border Background="#223F51B5"><TextBlock Text="Five" /></Border>
                                <Border Background="#220064FA"><TextBlock Text="Six" /></Border>
                                <Border Background="#220095EE"><TextBlock Text="Seven" /></Border>
                                <Border Background="#2205A4B6"><TextBlock Text="Eight" /></Border>
                                <Border Background="#2200B3A1"><TextBlock Text="Nine" /></Border>
                                <Border Background="#223BB346"><TextBlock Text="Ten" /></Border>
                                <Border Background="#227BB63C"><TextBlock Text="Eleven" /></Border>
                                <Border Background="#22FAC800"><TextBlock Text="Twelve" /></Border>
                                <Border Background="#22FC8800"><TextBlock Text="Thirteen" /></Border>
                                <Border Background="#226B7075"><TextBlock Text="Fourteen" /></Border>
                            </o:ElasticWrapPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Grid>
        </o:ControlShowcase>

        <o:ControlShowcase Header="Interactive FixToRB" SourceKey="layout-elastic-wrap-fix-to-rb">
            <Grid ColumnDefinitions="280,*" ColumnSpacing="20">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="Fixed item settings" />
                    <CheckBox Content="Automatic width" IsChecked="{Binding AutoWidth}" />
                    <TextBlock Text="{Binding ManualItemSelfWidth, StringFormat='Fixed width: {0:F0}'}" />
                    <Slider IsEnabled="{Binding !AutoWidth}" Maximum="420" Minimum="100" Value="{Binding ManualItemSelfWidth}" />
                    <CheckBox Content="Automatic height" IsChecked="{Binding AutoHeight}" />
                    <TextBlock Text="{Binding ManualItemSelfHeight, StringFormat='Fixed height: {0:F0}'}" />
                    <Slider IsEnabled="{Binding !AutoHeight}" Maximum="160" Minimum="32" Value="{Binding ManualItemSelfHeight}" />
                    <TextBlock Text="Horizontal alignment" />
                    <ComboBox ItemsSource="{Binding HorizontalAlignments}" SelectedItem="{Binding FixedHorizontalAlignment}" />
                    <TextBlock Text="Vertical alignment" />
                    <ComboBox ItemsSource="{Binding VerticalAlignments}" SelectedItem="{Binding FixedVerticalAlignment}" />
                </StackPanel>

                <Border
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Grid.Column="1"
                    MinHeight="300"
                    Padding="8">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="{Binding HorizontalVisibility}"
                        VerticalScrollBarVisibility="{Binding VerticalVisibility}">
                        <o:ElasticWrapPanel
                            Classes="demo"
                            IsFillHorizontal="{Binding IsFillHorizontal}"
                            IsFillVertical="{Binding IsFillVertical}"
                            ItemHeight="{Binding ItemHeight}"
                            ItemSpacing="{Binding ItemSpacing}"
                            ItemWidth="{Binding ItemWidth}"
                            LineSpacing="{Binding LineSpacing}"
                            Orientation="{Binding SelectedOrientation}">
                            <Border Background="#223F8CFF"><TextBlock Text="Item 1" /></Border>
                            <Border Background="#223F8CFF"><TextBlock Text="Item 2" /></Border>
                            <Border Background="#223F8CFF"><TextBlock Text="Item 3" /></Border>
                            <UniformGrid
                                Height="{Binding ItemSelfHeight}"
                                HorizontalAlignment="{Binding FixedHorizontalAlignment}"
                                MinWidth="100"
                                o:ElasticWrapPanel.FixToRB="True"
                                VerticalAlignment="{Binding FixedVerticalAlignment}"
                                Width="{Binding ItemSelfWidth}">
                                <Button Content="Search" />
                                <Button Content="Export" />
                            </UniformGrid>
                            <Border Background="#22F0B114"><TextBlock Text="Item 4" /></Border>
                            <Border Background="#22F0B114"><TextBlock Text="Item 5" /></Border>
                            <UniformGrid
                                Height="{Binding ItemSelfHeight}"
                                HorizontalAlignment="{Binding FixedHorizontalAlignment}"
                                MinWidth="100"
                                o:ElasticWrapPanel.FixToRB="True"
                                VerticalAlignment="{Binding FixedVerticalAlignment}"
                                Width="{Binding ItemSelfWidth}">
                                <Button Content="Cancel" />
                                <Button Content="Apply" />
                            </UniformGrid>
                        </o:ElasticWrapPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </o:ControlShowcase>

        <o:ControlShowcase Header="Automatic item sizing" SourceKey="layout-elastic-wrap-auto-size">
            <o:ElasticWrapPanel Classes="demo" ItemSpacing="8" LineSpacing="8">
                <Border Background="#22F93920" Width="90"><TextBlock Text="Short" /></Border>
                <Border Background="#220095EE" Width="180"><TextBlock Text="Wider item" /></Border>
                <Border Background="#223BB346" Height="72" Width="130"><TextBlock Text="Taller item" /></Border>
                <Border Background="#22FC8800" Width="220"><TextBlock Text="Content-sized item" /></Border>
            </o:ElasticWrapPanel>
        </o:ControlShowcase>
    </demo:DemoPage>
</UserControl>
