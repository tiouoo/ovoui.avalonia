<UserControl
    x:Class="OvoUi.Demo.Pages.GridPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:o="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="Grid">
        <o:ControlShowcase Header="Rows, columns, and spanning" SourceKey="layout-grid-tracks">
            <Grid
                ColumnDefinitions="160,*,Auto"
                ColumnSpacing="10"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="10">
                <Border
                    Background="#2878D4"
                    Grid.RowSpan="3"
                    Padding="16">
                    <TextBlock Foreground="White" Text="Navigation" />
                </Border>
                <Border
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Padding="16">
                    <TextBlock FontWeight="SemiBold" Text="Header spans two columns" />
                </Border>
                <Border
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    Grid.Column="1"
                    Grid.Row="1"
                    Padding="16">
                    <TextBlock Text="Star-sized content" />
                </Border>
                <Button
                    Content="Auto column"
                    Grid.Column="2"
                    Grid.Row="1" />
                <ProgressBar
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Grid.Row="2"
                    Maximum="100"
                    Value="68" />
            </Grid>
        </o:ControlShowcase>
        <o:ControlShowcase Header="Responsive form" SourceKey="layout-grid-form">
            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="14"
                MaxWidth="560"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="12">
                <TextBlock Text="Project" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="OvoUi" />
                <TextBlock
                    Grid.Row="1"
                    Text="Environment"
                    VerticalAlignment="Center" />
                <ComboBox
                    Grid.Column="1"
                    Grid.Row="1"
                    SelectedIndex="0">
                    <ComboBoxItem>Development</ComboBoxItem>
                    <ComboBoxItem>Production</ComboBoxItem>
                </ComboBox>
                <Button
                    Classes="accent"
                    Content="Deploy"
                    Grid.Column="1"
                    Grid.Row="2"
                    HorizontalAlignment="Right" />
            </Grid>
        </o:ControlShowcase>
    </demo:DemoPage>
</UserControl>