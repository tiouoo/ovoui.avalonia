<UserControl
    x:Class="OvoUi.Demo.Pages.TagInputPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="TagInput">
        <ovo:ControlShowcase Header="Tag entry" SourceKey="tag-input-entry">
            <StackPanel
                HorizontalAlignment="Left"
                Spacing="16"
                Width="560">
                <ovo:TagInput PlaceholderText="Type a tag, then press Enter" />
                <ovo:TagInput
                    AllowDuplicates="False"
                    PlaceholderText="Comma-separated tags"
                    Separator="," />
                <ovo:TagInput AllowDuplicates="True" PlaceholderText="Duplicates allowed" />
            </StackPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Focus behavior and states" SourceKey="tag-input-states">
            <StackPanel
                HorizontalAlignment="Left"
                Spacing="16"
                Width="560">
                <ovo:TagInput LostFocusBehavior="Add" PlaceholderText="Commit value on focus loss" />
                <ovo:TagInput LostFocusBehavior="Clear" PlaceholderText="Clear value on focus loss" />
                <ovo:TagInput IsEnabled="False" PlaceholderText="Disabled" />
            </StackPanel>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>