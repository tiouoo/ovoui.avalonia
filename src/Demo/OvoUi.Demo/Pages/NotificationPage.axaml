<UserControl
    x:Class="OvoUi.Demo.Pages.NotificationPage"
    x:CompileBindings="False"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:o="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="Notification">
        <o:ControlShowcase Header="Interactive configuration" SourceKey="feedback-notification-configurator">
            <o:ControlShowcase.CodeBlocks>
                <o:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                <o:ShowcaseCodeBlock
                    Code="{Binding ConfiguratorCode}"
                    Header="C#"
                    Language="csharp" />
            </o:ControlShowcase.CodeBlocks>
            <StackPanel Spacing="14">
                <Grid
                    ColumnDefinitions="150,*"
                    ColumnSpacing="12"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    RowSpacing="10">
                    <TextBlock Text="Title" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding NotificationTitle}" />
                    <TextBlock
                        Grid.Row="1"
                        Text="Content"
                        VerticalAlignment="Top" />
                    <TextBox
                        AcceptsReturn="True"
                        Grid.Column="1"
                        Grid.Row="1"
                        MinHeight="72"
                        Text="{Binding NotificationContent}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Row="2"
                        Text="Type and position"
                        VerticalAlignment="Center" />
                    <StackPanel
                        Grid.Column="1"
                        Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="10">
                        <ComboBox
                            ItemsSource="{Binding Types}"
                            MinWidth="150"
                            SelectedItem="{Binding SelectedType}" />
                        <ComboBox
                            ItemsSource="{Binding Positions}"
                            MinWidth="170"
                            SelectedItem="{Binding SelectedPosition}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Row="3"
                        Text="Duration (seconds)"
                        VerticalAlignment="Center" />
                    <NumericUpDown
                        Grid.Column="1"
                        Grid.Row="3"
                        Increment="1"
                        Maximum="60"
                        Minimum="0"
                        Value="{Binding ExpirationSeconds}" />
                </Grid>
                <WrapPanel ItemSpacing="16" LineSpacing="8">
                    <CheckBox Content="Icon" IsChecked="{Binding IsIconVisible}" />
                    <CheckBox Content="Close button" IsChecked="{Binding IsCloseButtonVisible}" />
                    <CheckBox Content="Collapse button" IsChecked="{Binding IsCollapseButtonVisible}" />
                    <CheckBox Content="Click to close" IsChecked="{Binding IsTouchClose}" />
                    <CheckBox Content="Colorful" IsChecked="{Binding IsColorful}" />
                    <CheckBox Content="Action buttons" IsChecked="{Binding IncludeActions}" />
                    <CheckBox Content="Inline actions" IsChecked="{Binding IsButtonsInline}" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button
                        Classes="accent"
                        Click="ShowConfigured"
                        Content="Show notification" />
                    <TextBlock Text="{Binding LastInteraction, StringFormat='Last interaction: {0}'}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </o:ControlShowcase>

        <o:ControlShowcase Header="Content, appearance, and actions" SourceKey="feedback-notification-presets">
            <o:ControlShowcase.CodeBlocks>
                <o:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                <o:ShowcaseCodeBlock
                    Code="{Binding PresetsCode}"
                    Header="C#"
                    Language="csharp" />
            </o:ControlShowcase.CodeBlocks>
            <StackPanel Spacing="12">
                <WrapPanel ItemSpacing="10" LineSpacing="10">
                    <Button Click="ShowInformation" Content="Information" />
                    <Button Click="ShowSuccess" Content="Success" />
                    <Button Click="ShowWarning" Content="Warning" />
                    <Button Click="ShowError" Content="Error" />
                    <Button Click="ShowTitleOnly" Content="Title only" />
                    <Button Click="ShowLongContent" Content="Long and multiline" />
                </WrapPanel>
                <WrapPanel ItemSpacing="10" LineSpacing="10">
                    <Button Click="ShowInlineActions" Content="Inline actions" />
                    <Button Click="ShowStackedActions" Content="Stacked actions" />
                    <Button Click="ShowLightStyle" Content="Light style" />
                    <Button Click="ShowDefaultStyle" Content="Default style" />
                    <Button Click="ShowColorfulStyle" Content="Colorful style" />
                    <Button Click="ShowClickable" Content="Click callback" />
                </WrapPanel>
            </StackPanel>
        </o:ControlShowcase>

        <o:ControlShowcase Header="Position and lifetime" SourceKey="feedback-notification-lifetime">
            <o:ControlShowcase.CodeBlocks>
                <o:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                <o:ShowcaseCodeBlock
                    Code="{Binding LifetimeCode}"
                    Header="C#"
                    Language="csharp" />
            </o:ControlShowcase.CodeBlocks>
            <StackPanel Spacing="12">
                <WrapPanel ItemSpacing="10" LineSpacing="10">
                    <Button Click="MoveTopLeft" Content="Top left" />
                    <Button Click="MoveTopCenter" Content="Top center" />
                    <Button Click="MoveTopRight" Content="Top right" />
                    <Button Click="MoveBottomLeft" Content="Bottom left" />
                    <Button Click="MoveBottomCenter" Content="Bottom center" />
                    <Button Click="MoveBottomRight" Content="Bottom right" />
                </WrapPanel>
                <WrapPanel ItemSpacing="10" LineSpacing="10">
                    <Button Click="ShowTimeout" Content="Timeout" />
                    <Button Click="ShowPersistent" Content="Persistent" />
                    <Button Click="ShowTracked" Content="Show tracked" />
                    <Button Click="CloseTracked" Content="Close tracked" />
                    <Button Click="ShowDisplaced" Content="Displaced" />
                    <Button Click="CloseAll" Content="Close all" />
                </WrapPanel>
                <TextBlock Text="{Binding LastCloseReason, StringFormat='Last close reason: {0}'}" />
            </StackPanel>
        </o:ControlShowcase>
    </demo:DemoPage>
</UserControl>