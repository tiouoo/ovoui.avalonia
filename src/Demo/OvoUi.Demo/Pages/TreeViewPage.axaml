<UserControl
    x:Class="OvoUi.Demo.Pages.TreeViewPage"
    x:CompileBindings="False"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:o="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="TreeView">
        <o:ControlShowcase Header="TreeView examples" SourceKey="shows-tree-view">
            <o:ControlShowcase.CodeBlocks>
                <o:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                <o:ShowcaseCodeBlock
                    Code="{Binding SourceCode}"
                    Header="C#"
                    Language="csharp" />
            </o:ControlShowcase.CodeBlocks>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                <TreeView>
                    <TreeViewItem Header="Components" IsExpanded="True">
                        <TreeViewItem Header="Inputs" />
                        <TreeViewItem Header="Shows" IsExpanded="True">
                            <TreeViewItem Header="TreeView" />
                            <TreeViewItem Header="DataGrid" />
                        </TreeViewItem>
                    </TreeViewItem>
                </TreeView>
                <TreeView Grid.Column="1" ItemsSource="{Binding Nodes}">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" />
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </o:ControlShowcase>
    </demo:DemoPage>
</UserControl>

