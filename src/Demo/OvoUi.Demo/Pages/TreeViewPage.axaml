<UserControl
    x:DataType="pages:TreeViewPage"
    x:Class="OvoUi.Demo.Pages.TreeViewPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:pages="using:OvoUi.Demo.Pages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="TreeView">
        <ovo:ControlShowcase Header="TreeView examples" SourceKey="shows-tree-view">
            <ovo:ControlShowcase.CodeBlocks>
                <ovo:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                <ovo:ShowcaseCodeBlock
                    Code="{Binding SourceCode}"
                    Header="C#"
                    Language="csharp" />
            </ovo:ControlShowcase.CodeBlocks>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                <TreeView>
                    <TreeViewItem Header="Components" IsExpanded="True">
                        <TreeViewItem Header="Inputs" />
                        <TreeViewItem Header="Shows" IsExpanded="True">
                            <TreeViewItem Header="TreeView" />
                            <TreeViewItem Header="DataGrid" />
                        </TreeViewItem>
                    </TreeViewItem>
                </TreeView>
                <TreeView Grid.Column="1" ItemsSource="{Binding Nodes}">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" />
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>