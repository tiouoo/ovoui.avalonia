<UserControl
    x:Class="OvoUi.Demo.Pages.ContentDialogPage"
    x:CompileBindings="False"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:o="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="ContentDialog">
        <o:ControlShowcase Header="Interactive configuration" SourceKey="feedback-content-dialog-configurator">
            <o:ControlShowcase.CodeBlocks>
                <o:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                <o:ShowcaseCodeBlock
                    Code="{Binding ConfiguratorCode}"
                    Header="C#"
                    Language="csharp" />
            </o:ControlShowcase.CodeBlocks>
            <Grid
                ColumnDefinitions="180,*"
                ColumnSpacing="12"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                RowSpacing="10">
                <TextBlock Text="Title" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding DialogTitle}" />
                <TextBlock
                    Grid.Row="1"
                    Text="Content"
                    VerticalAlignment="Top" />
                <TextBox
                    AcceptsReturn="True"
                    Grid.Column="1"
                    Grid.Row="1"
                    MinHeight="72"
                    Text="{Binding DialogContent}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Row="2"
                    Text="Primary button"
                    VerticalAlignment="Center" />
                <TextBox
                    Grid.Column="1"
                    Grid.Row="2"
                    Text="{Binding PrimaryText}" />
                <TextBlock
                    Grid.Row="3"
                    Text="Secondary button"
                    VerticalAlignment="Center" />
                <TextBox
                    Grid.Column="1"
                    Grid.Row="3"
                    Text="{Binding SecondaryText}" />
                <TextBlock
                    Grid.Row="4"
                    Text="Close button"
                    VerticalAlignment="Center" />
                <TextBox
                    Grid.Column="1"
                    Grid.Row="4"
                    Text="{Binding CloseText}" />
                <TextBlock
                    Grid.Row="5"
                    Text="Default button"
                    VerticalAlignment="Center" />
                <ComboBox
                    Grid.Column="1"
                    Grid.Row="5"
                    ItemsSource="{Binding DefaultButtons}"
                    SelectedItem="{Binding DefaultButton}" />
                <TextBlock
                    Grid.Row="6"
                    Text="Layout"
                    VerticalAlignment="Center" />
                <CheckBox
                    Content="Full size"
                    Grid.Column="1"
                    Grid.Row="6"
                    IsChecked="{Binding FullSizeDesired}" />
                <StackPanel
                    Grid.ColumnSpan="2"
                    Grid.Row="7"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Button
                        Classes="accent"
                        Click="ShowConfigured"
                        Content="Show configured dialog" />
                    <TextBlock Text="{Binding LastResult, StringFormat='Last result: {0}'}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </o:ControlShowcase>

        <o:ControlShowcase Header="Common content" SourceKey="feedback-content-dialog-content">
            <o:ControlShowcase.CodeBlocks>
                <o:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                <o:ShowcaseCodeBlock
                    Code="{Binding ContentCode}"
                    Header="C#"
                    Language="csharp" />
            </o:ControlShowcase.CodeBlocks>
            <StackPanel Spacing="12">
                <WrapPanel ItemSpacing="10" LineSpacing="10">
                    <Button Click="ShowDeleteConfirm" Content="Delete confirmation" />
                    <Button Click="ShowSaveChanges" Content="Save changes" />
                    <Button Click="ShowInputDialog" Content="Text input" />
                    <Button Click="ShowRichContent" Content="Rich content" />
                    <Button Click="ShowCloseOnly" Content="Close only" />
                </WrapPanel>
                <TextBlock Text="{Binding PresetResult, StringFormat='Preset result: {0}'}" />
            </StackPanel>
        </o:ControlShowcase>

        <o:ControlShowcase Header="Asynchronous validation" SourceKey="feedback-content-dialog-deferral">
            <o:ControlShowcase.CodeBlocks>
                <o:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                <o:ShowcaseCodeBlock
                    Code="{Binding DeferralCode}"
                    Header="C#"
                    Language="csharp" />
            </o:ControlShowcase.CodeBlocks>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Click="ShowValidatedDialog" Content="Validate CONFIRM" />
                <TextBlock Text="{Binding ValidationResult}" VerticalAlignment="Center" />
            </StackPanel>
        </o:ControlShowcase>
    </demo:DemoPage>
</UserControl>