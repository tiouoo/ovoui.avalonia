<UserControl
    x:Class="OvoUi.Demo.Pages.SmoothScrollPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:o="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="SmoothScroll">
        <o:ControlShowcase Header="Available scrolling behavior" SourceKey="layout-smooth-scroll-available">
            <StackPanel Spacing="12">
                <TextBlock Text="OvoUi currently uses Avalonia ScrollViewer for scrolling. Enable inertia for touch and precision-wheel input." TextWrapping="Wrap" />
                <ScrollViewer
                    Height="260"
                    HorizontalScrollBarVisibility="Auto"
                    IsScrollChainingEnabled="False"
                    IsScrollInertiaEnabled="True"
                    VerticalScrollBarVisibility="Auto">
                    <Grid Height="520" Width="900">
                        <Grid.Background>
                            <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                                <GradientStop Color="#FF5E9C" Offset="0" />
                                <GradientStop Color="#2C4F7C" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <UniformGrid
                            ColumnSpacing="8"
                            Columns="3"
                            Margin="24"
                            RowSpacing="8"
                            Rows="3">
                            <Border Background="#88FDF398" CornerRadius="8" />
                            <Border Background="#8898CDFD" CornerRadius="8" />
                            <Border Background="#88F6A0B5" CornerRadius="8" />
                            <Border Background="#88A4E0A7" CornerRadius="8" />
                            <Border Background="#88C39BD6" CornerRadius="8" />
                            <Border Background="#88F0A868" CornerRadius="8" />
                            <Border Background="#887FB8A0" CornerRadius="8" />
                            <Border Background="#88E5B3D4" CornerRadius="8" />
                            <Border Background="#889FD2DB" CornerRadius="8" />
                        </UniformGrid>
                    </Grid>
                </ScrollViewer>
            </StackPanel>
        </o:ControlShowcase>

        <o:ControlShowcase Header="Prototype API differences" SourceKey="layout-smooth-scroll-differences">
            <StackPanel Spacing="8">
                <TextBlock Text="ScrollView, ZoomFactor, ZoomTo, and ScrollViewerSmoothTheme are not public OvoUi APIs." TextWrapping="Wrap" />
                <TextBlock Text="Those prototype-only usages are intentionally omitted until an OvoUi zoom or smooth-scroll control is implemented." TextWrapping="Wrap" />
            </StackPanel>
        </o:ControlShowcase>
    </demo:DemoPage>
</UserControl>