<UserControl
    x:Class="OvoUi.Demo.Pages.DataValidationErrorsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:o="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:system="using:System"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="DataValidationErrors">
        <o:ControlShowcase Header="Validation states" SourceKey="data-validation-control-states">
            <WrapPanel ItemSpacing="20" LineSpacing="16">
                <TextBox PlaceholderText="Default error" Width="260">
                    <DataValidationErrors.Error>
                        <system:Exception>
                            <x:Arguments>
                                <x:String>A project name is required.</x:String>
                            </x:Arguments>
                        </system:Exception>
                    </DataValidationErrors.Error>
                </TextBox>
                <TextBox
                    Classes="Small"
                    PlaceholderText="Small"
                    Width="260">
                    <DataValidationErrors.Error>
                        <system:Exception>
                            <x:Arguments>
                                <x:String>This value is invalid.</x:String>
                            </x:Arguments>
                        </system:Exception>
                    </DataValidationErrors.Error>
                </TextBox>
                <TextBox
                    Classes="Large"
                    PlaceholderText="Large"
                    Width="260">
                    <DataValidationErrors.Error>
                        <system:Exception>
                            <x:Arguments>
                                <x:String>This value is invalid.</x:String>
                            </x:Arguments>
                        </system:Exception>
                    </DataValidationErrors.Error>
                </TextBox>
                <NumericUpDown Value="120" Width="260">
                    <DataValidationErrors.Error>
                        <system:Exception>
                            <x:Arguments>
                                <x:String>Enter a value from 1 to 100.</x:String>
                            </x:Arguments>
                        </system:Exception>
                    </DataValidationErrors.Error>
                </NumericUpDown>
                <ComboBox PlaceholderText="Select an environment" Width="260">
                    <ComboBoxItem Content="Development" />
                    <ComboBoxItem Content="Production" />
                    <DataValidationErrors.Error>
                        <system:Exception>
                            <x:Arguments>
                                <x:String>Select an environment.</x:String>
                            </x:Arguments>
                        </system:Exception>
                    </DataValidationErrors.Error>
                </ComboBox>
                <CalendarDatePicker PlaceholderText="Release date" Width="260">
                    <DataValidationErrors.Error>
                        <system:Exception>
                            <x:Arguments>
                                <x:String>Choose a future date.</x:String>
                            </x:Arguments>
                        </system:Exception>
                    </DataValidationErrors.Error>
                </CalendarDatePicker>
            </WrapPanel>
        </o:ControlShowcase>

        <o:ControlShowcase Header="Inline and tooltip presentation" SourceKey="data-validation-presentations">
            <StackPanel
                HorizontalAlignment="Left"
                Spacing="18"
                Width="420">
                <TextBox Text="duplicate-project">
                    <DataValidationErrors.Error>
                        <system:Exception>
                            <x:Arguments>
                                <x:String>That project name is already in use.</x:String>
                            </x:Arguments>
                        </system:Exception>
                    </DataValidationErrors.Error>
                </TextBox>
                <TextBox Text="hover-to-inspect">
                    <TextBox.Styles>
                        <Style Selector="TextBox /template/ DataValidationErrors">
                            <Setter Property="Theme" Value="{DynamicResource TooltipDataValidationErrors}" />
                        </Style>
                    </TextBox.Styles>
                    <DataValidationErrors.Error>
                        <system:Exception>
                            <x:Arguments>
                                <x:String>The tooltip theme keeps the layout compact.</x:String>
                            </x:Arguments>
                        </system:Exception>
                    </DataValidationErrors.Error>
                </TextBox>
            </StackPanel>
        </o:ControlShowcase>
    </demo:DemoPage>
</UserControl>