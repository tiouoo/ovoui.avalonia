<UserControl
    x:Class="OvoUi.Demo.Pages.PathPickerPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="PathPicker">
        <ovo:ControlShowcase Header="Picker types" SourceKey="path-picker-types">
            <StackPanel
                HorizontalAlignment="Left"
                Spacing="16"
                Width="620">
                <ovo:PathPicker Title="Choose a file" UsePickerType="OpenFile" />
                <ovo:PathPicker
                    AllowMultiple="True"
                    Title="Choose multiple files"
                    UsePickerType="OpenFile" />
                <ovo:PathPicker Title="Choose a folder" UsePickerType="OpenFolder" />
                <ovo:PathPicker
                    DefaultFileExtension="txt"
                    SuggestedFileName="document"
                    Title="Save a file"
                    UsePickerType="SaveFile" />
            </StackPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Themes" SourceKey="path-picker-themes">
            <StackPanel
                HorizontalAlignment="Left"
                Spacing="16"
                Width="620">
                <ovo:PathPicker Title="Default path picker" />
                <ovo:PathPicker Theme="{DynamicResource ButtonPathPicker}" Title="Button path picker" />
                <ovo:PathPicker
                    AllowMultiple="True"
                    Theme="{DynamicResource ListPathPicker}"
                    Title="List path picker" />
            </StackPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Custom button content" SourceKey="path-picker-content">
            <ovo:PathPicker
                HorizontalAlignment="Left"
                Title="Choose an image"
                VerticalAlignment="Center"
                Width="620">
                <ovo:PathPicker.ButtonContent>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <PathIcon
                            Data="M9.5 3A6.5 6.5 0 1 0 16 9.5 6.5 6.5 0 0 0 9.5 3zm0 11A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14zm5.85.44 4.1 4.1-1.41 1.41-4.1-4.1z"
                            Height="16"
                            Width="16" />
                        <TextBlock Text="Browse" />
                    </StackPanel>
                </ovo:PathPicker.ButtonContent>
            </ovo:PathPicker>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>