<UserControl
    x:Class="OvoUi.Demo.Pages.PopConfirmPage"
    x:DataType="pages:PopConfirmDemoViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:pages="using:OvoUi.Demo.Pages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="PopConfirm">
        <ovo:ControlShowcase Header="Confirmation commands" SourceKey="pop-confirm-commands">
            <ovo:ControlShowcase.CodeBlocks>
                <ovo:ShowcaseCodeBlock Header="axaml" Language="axaml" />
                <ovo:ShowcaseCodeBlock
                    Code="{Binding SourceCode}"
                    CodeHeight="360"
                    Header="C#"
                    Language="csharp" />
            </ovo:ControlShowcase.CodeBlocks>
            <StackPanel Spacing="14">
                <WrapPanel ItemSpacing="16" LineSpacing="12">
                    <ovo:PopConfirm
                        CancelCommand="{Binding CancelCommand}"
                        ConfirmCommand="{Binding DeleteCommand}"
                        PopupContent="This action cannot be undone."
                        PopupHeader="Delete this deployment?">
                        <Button Classes="warn" Content="Delete deployment" />
                    </ovo:PopConfirm>
                    <ovo:PopConfirm
                        CancelCommand="{Binding CancelCommand}"
                        ConfirmCommand="{Binding PublishCommand}"
                        Placement="Right"
                        PopupContent="The release will become visible to all users."
                        PopupHeader="Publish release?">
                        <Button Content="Publish release" />
                    </ovo:PopConfirm>
                </WrapPanel>
                <TextBlock Text="{Binding LastAction, StringFormat='Last action: {0}'}" />
            </StackPanel>
        </ovo:ControlShowcase>

        <ovo:ControlShowcase Header="Trigger modes and custom content" SourceKey="pop-confirm-trigger-modes">
            <StackPanel Spacing="14">
                <WrapPanel ItemSpacing="20" LineSpacing="12">
                    <ovo:PopConfirm
                        CancelCommand="{Binding CancelCommand}"
                        ConfirmCommand="{Binding ArchiveCommand}"
                        PopupContent="Click outside or choose an action."
                        PopupHeader="Click trigger"
                        TriggerMode="Click">
                        <TextBlock Foreground="{DynamicResource SystemAccentBrush}" Text="Archive from text" />
                    </ovo:PopConfirm>
                    <ovo:PopConfirm
                        CancelCommand="{Binding CancelCommand}"
                        ConfirmCommand="{Binding ArchiveCommand}"
                        PopupContent="The popup opens when this button receives focus."
                        PopupHeader="Focus trigger"
                        TriggerMode="Focus">
                        <Button Content="Focus to confirm" />
                    </ovo:PopConfirm>
                </WrapPanel>
            </StackPanel>
        </ovo:ControlShowcase>

        <ovo:ControlShowcase Header="Asynchronous confirmation" SourceKey="pop-confirm-async-command">
            <ovo:ControlShowcase.CodeBlocks>
                <ovo:ShowcaseCodeBlock Header="axaml" Language="axaml" />
                <ovo:ShowcaseCodeBlock
                    Code="{Binding SourceCode}"
                    CodeHeight="360"
                    Header="C#"
                    Language="csharp" />
            </ovo:ControlShowcase.CodeBlocks>
            <StackPanel Spacing="12">
                <ovo:PopConfirm
                    CancelCommand="{Binding CancelCommand}"
                    ConfirmCommand="{Binding AsyncConfirmCommand}"
                    PopupContent="The popup remains open while the command is running."
                    PopupHeader="Run remote operation?">
                    <Button Content="Run operation" />
                </ovo:PopConfirm>
                <TextBlock Text="{Binding LastAction}" />
            </StackPanel>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>