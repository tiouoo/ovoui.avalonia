<UserControl
    x:Class="OvoUi.Demo.Pages.TabWindowPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:pages="using:OvoUi.Demo.Pages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:DataType="pages:TabWindowPage">
    <demo:DemoPage Text="OvoTabHost">
        <ovo:ControlShowcase Header="Tab workspace" SourceKey="tab-workspace">
            <ovo:ControlShowcase.CodeBlocks>
                <ovo:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                <ovo:ShowcaseCodeBlock Header="C#" Language="csharp" Code="{Binding SourceCode}" />
            </ovo:ControlShowcase.CodeBlocks>
            <Grid RowDefinitions="Auto,Auto,420" RowSpacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="OpenWindow_OnClick" Name="OpenWindowButton">
                        Open tab window
                    </Button>
                    <Button Click="AddTabs_OnClick">
                        Add tabs
                    </Button>
                </StackPanel>
                <WrapPanel Grid.Row="1">
                    <TextBlock Text="Detach when leaving" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <ComboBox ItemsSource="{Binding DragBoundaries}"
                              SelectedItem="{Binding #TabHost.DetachBoundary, Mode=TwoWay}"
                              MinWidth="120" Margin="0,0,16,8" />
                    <TextBlock Text="Attach when entering" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <ComboBox ItemsSource="{Binding DragBoundaries}"
                              SelectedItem="{Binding #TabHost.AttachBoundary, Mode=TwoWay}"
                              MinWidth="120" Margin="0,0,16,8" />
                    <CheckBox Content="Live detach and attach"
                              IsChecked="{Binding #TabHost.IsLiveDragEnabled, Mode=TwoWay}"
                              ToolTip.Tip="Off: drag a preview and release to open a window. On: detach and attach immediately."
                              Margin="0,0,0,8" />
                </WrapPanel>
                <ovo:OvoTabHost
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Grid.Row="2"
                    Name="TabHost">
                    <ovo:OvoTabHost.EmptyContent>
                        <TextBlock
                            HorizontalAlignment="Center"
                            Opacity="0.65"
                            Text="No open tabs"
                            VerticalAlignment="Center" />
                    </ovo:OvoTabHost.EmptyContent>
                </ovo:OvoTabHost>
            </Grid>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>
