<UserControl
    x:Class="OvoUi.Demo.Pages.TabWindowPage"
    x:DataType="pages:TabWindowPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:pages="using:OvoUi.Demo.Pages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="OvoTabHost">
        <ovo:ControlShowcase Header="Tab workspace" SourceKey="tab-workspace">
            <ovo:ControlShowcase.CodeBlocks>
                <ovo:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                <ovo:ShowcaseCodeBlock
                    Code="{Binding SourceCode}"
                    Header="C#"
                    Language="csharp" />
            </ovo:ControlShowcase.CodeBlocks>
            <Grid RowDefinitions="Auto,Auto,420" RowSpacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="OpenWindow_OnClick" Name="OpenWindowButton">
                        Open tab window
                    </Button>
                    <Button Click="AddTabs_OnClick">
                        Add tabs
                    </Button>
                </StackPanel>
                <WrapPanel Grid.Row="1">
                    <TextBlock
                        Margin="0,0,8,8"
                        Text="Detach when leaving"
                        VerticalAlignment="Center" />
                    <ComboBox
                        ItemsSource="{Binding DragBoundaries}"
                        Margin="0,0,16,8"
                        MinWidth="120"
                        SelectedItem="{Binding #TabHost.DetachBoundary, Mode=TwoWay}" />
                    <TextBlock
                        Margin="0,0,8,8"
                        Text="Attach when entering"
                        VerticalAlignment="Center" />
                    <ComboBox
                        ItemsSource="{Binding DragBoundaries}"
                        Margin="0,0,16,8"
                        MinWidth="120"
                        SelectedItem="{Binding #TabHost.AttachBoundary, Mode=TwoWay}" />
                    <CheckBox
                        Content="Live detach and attach"
                        IsChecked="{Binding #TabHost.IsLiveDragEnabled, Mode=TwoWay}"
                        Margin="0,0,0,8"
                        ToolTip.Tip="Off: drag a preview and release to open a window. On: detach and attach immediately." />
                </WrapPanel>
                <ovo:OvoTabHost
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Grid.Row="2"
                    Name="TabHost">
                    <ovo:OvoTabHost.EmptyContent>
                        <TextBlock
                            HorizontalAlignment="Center"
                            Opacity="0.65"
                            Text="No open tabs"
                            VerticalAlignment="Center" />
                    </ovo:OvoTabHost.EmptyContent>
                </ovo:OvoTabHost>
            </Grid>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>