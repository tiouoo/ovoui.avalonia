<UserControl
    x:Class="OvoUi.Demo.Pages.MessageBoxPage"
    x:CompileBindings="False"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:o="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="MessageBox">
        <o:ControlShowcase Header="Interactive configuration" SourceKey="feedback-message-box-configurator">
            <o:ControlShowcase.CodeBlocks>
                <o:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                <o:ShowcaseCodeBlock
                    Code="{Binding ConfiguratorCode}"
                    Header="C#"
                    Language="csharp" />
            </o:ControlShowcase.CodeBlocks>
            <StackPanel Spacing="14">
                <Grid
                    ColumnDefinitions="150,*"
                    ColumnSpacing="12"
                    RowDefinitions="Auto,Auto,Auto"
                    RowSpacing="10">
                    <TextBlock Text="Title" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding MessageTitle}" />
                    <TextBlock
                        Grid.Row="1"
                        Text="Message"
                        VerticalAlignment="Top" />
                    <TextBox
                        AcceptsReturn="True"
                        Grid.Column="1"
                        Grid.Row="1"
                        MinHeight="80"
                        Text="{Binding MessageContent}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Row="2"
                        Text="Icon and buttons"
                        VerticalAlignment="Center" />
                    <StackPanel
                        Grid.Column="1"
                        Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="10">
                        <ComboBox
                            ItemsSource="{Binding Icons}"
                            MinWidth="150"
                            SelectedItem="{Binding SelectedIcon}" />
                        <ComboBox
                            ItemsSource="{Binding ButtonSets}"
                            MinWidth="150"
                            SelectedItem="{Binding SelectedButtons}" />
                    </StackPanel>
                </Grid>
                <WrapPanel ItemSpacing="16" LineSpacing="8">
                    <CheckBox Content="Overlay" IsChecked="{Binding UseOverlay}" />
                    <CheckBox Content="Show title" IsChecked="{Binding ShowTitle}" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button
                        Classes="accent"
                        Click="ShowConfigured"
                        Content="Show message box" />
                    <TextBlock Text="{Binding LastResult, StringFormat='Last result: {0}'}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </o:ControlShowcase>

        <o:ControlShowcase Header="Message presets" SourceKey="feedback-message-box-presets">
            <o:ControlShowcase.CodeBlocks>
                <o:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                <o:ShowcaseCodeBlock
                    Code="{Binding PresetsCode}"
                    Header="C#"
                    Language="csharp" />
            </o:ControlShowcase.CodeBlocks>
            <StackPanel Spacing="12">
                <WrapPanel ItemSpacing="10" LineSpacing="10">
                    <Button Click="ShowInformation" Content="Information" />
                    <Button Click="ShowSuccess" Content="Success" />
                    <Button Click="ShowWarning" Content="Warning" />
                    <Button Click="ShowError" Content="Error" />
                    <Button Click="ShowQuestion" Content="Question" />
                    <Button Click="ShowLongMessage" Content="Long message" />
                </WrapPanel>
                <WrapPanel ItemSpacing="10" LineSpacing="10">
                    <Button Click="ShowOk" Content="OK" />
                    <Button Click="ShowOkCancel" Content="OK / Cancel" />
                    <Button Click="ShowYesNo" Content="Yes / No" />
                    <Button Click="ShowYesNoCancel" Content="Yes / No / Cancel" />
                </WrapPanel>
            </StackPanel>
        </o:ControlShowcase>

        <o:ControlShowcase Header="Overlay and owned window" SourceKey="feedback-message-box-hosting">
            <o:ControlShowcase.CodeBlocks>
                <o:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                <o:ShowcaseCodeBlock
                    Code="{Binding HostingCode}"
                    Header="C#"
                    Language="csharp" />
            </o:ControlShowcase.CodeBlocks>
            <WrapPanel ItemSpacing="10" LineSpacing="10">
                <Button Click="ShowOverlayMessage" Content="Overlay with full mask" />
                <Button Click="ShowOwnedWindow" Content="Owned draggable window" />
                <Button Click="ShowUntitledWindow" Content="Untitled window" />
            </WrapPanel>
        </o:ControlShowcase>
    </demo:DemoPage>
</UserControl>