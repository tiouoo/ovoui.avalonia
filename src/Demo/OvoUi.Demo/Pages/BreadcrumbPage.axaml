<UserControl
    mc:Ignorable="d"
    x:Class="OvoUi.Demo.Pages.BreadcrumbPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:o="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="Breadcrumb">
        <o:ControlShowcase Header="Basic" SourceKey="breadcrumb-basic">
            <StackPanel Spacing="20">
                <o:Breadcrumb>
                    <o:BreadcrumbItem Content="Home" />
                    <o:BreadcrumbItem Content="Library" />
                    <o:BreadcrumbItem Content="Documents" IsReadOnly="True" />
                </o:Breadcrumb>
                <o:Breadcrumb Separator="/">
                    <o:BreadcrumbItem Content="Workspace" Icon="⌂" />
                    <o:BreadcrumbItem Content="OvoUi" />
                    <o:BreadcrumbItem Content="Navigation" IsReadOnly="True" />
                </o:Breadcrumb>
                <o:Breadcrumb Separator="›">
                    <o:BreadcrumbItem Content="Root" />
                    <o:BreadcrumbItem Content="Folder" IsEnabled="False" />
                    <o:BreadcrumbItem Content="Current" IsReadOnly="True" />
                </o:Breadcrumb>
            </StackPanel>
        </o:ControlShowcase>
        <o:ControlShowcase Header="Custom items" SourceKey="breadcrumb-custom-items">
            <o:Breadcrumb Separator="•">
                <o:BreadcrumbItem Content="Dashboard" Icon="●" />
                <o:BreadcrumbItem Content="Reports" Icon="◆" />
                <o:BreadcrumbItem
                    Content="October"
                    Icon="■"
                    IsReadOnly="True" />
            </o:Breadcrumb>
        </o:ControlShowcase>
    </demo:DemoPage>
</UserControl>