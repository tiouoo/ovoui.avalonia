<UserControl
    x:Class="OvoUi.Demo.Pages.ThemeVariantScopePage"
    x:DataType="pages:ThemeVariantScopePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:pages="clr-namespace:OvoUi.Demo.Pages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="ThemeVariantScope">
        <ovo:ControlShowcase Header="Runtime theme scope" SourceKey="layout-theme-variant-runtime">
            <ovo:ControlShowcase.CodeBlocks>
                <ovo:ShowcaseCodeBlock Header="axaml" Language="axaml" />
                <ovo:ShowcaseCodeBlock
                    Code="{Binding SourceCode}"
                    Header="C#"
                    Language="csharp" />
            </ovo:ControlShowcase.CodeBlocks>
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="UseDefaultTheme" Content="Default" />
                    <Button Click="UseLightTheme" Content="Light" />
                    <Button Click="UseDarkTheme" Content="Dark" />
                </StackPanel>
                <ThemeVariantScope Name="demoScope" RequestedThemeVariant="Dark">
                    <Border
                        Background="{DynamicResource PopupBackgroundBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource OvoCornerRadius}"
                        Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="h3" Text="Scoped controls" />
                            <TextBox Text="Editable text" Width="280" />
                            <CalendarDatePicker Width="220" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Primary action" />
                                <HyperlinkButton Content="Learn more" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ThemeVariantScope>
            </StackPanel>
        </ovo:ControlShowcase>

        <ovo:ControlShowcase Header="Independent light and dark scopes" SourceKey="layout-theme-variant-independent">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <ThemeVariantScope RequestedThemeVariant="Light">
                    <Border
                        Background="{DynamicResource PopupBackgroundBrush}"
                        CornerRadius="8"
                        Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="Light" />
                            <ToggleSwitch Content="Setting" IsChecked="True" />
                        </StackPanel>
                    </Border>
                </ThemeVariantScope>
                <ThemeVariantScope Grid.Column="1" RequestedThemeVariant="Dark">
                    <Border
                        Background="{DynamicResource PopupBackgroundBrush}"
                        CornerRadius="8"
                        Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="Dark" />
                            <ToggleSwitch Content="Setting" IsChecked="True" />
                        </StackPanel>
                    </Border>
                </ThemeVariantScope>
            </Grid>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>