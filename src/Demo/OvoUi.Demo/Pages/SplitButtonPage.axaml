<UserControl
    d:DesignHeight="720"
    d:DesignWidth="1000"
    mc:Ignorable="d"
    x:Class="OvoUi.Demo.Pages.SplitButtonPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:o="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="SplitButton">
        <o:ControlShowcase Header="SplitButton" SourceKey="split-button-basic">
            <WrapPanel
                ItemSpacing="12"
                LineSpacing="12"
                Margin="10,0">
                <SplitButton Content="Save">
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="Save" />
                            <MenuItem Header="Save as..." />
                            <Separator />
                            <MenuItem Header="Save a copy" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <SplitButton Content="Export">
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="Export as PDF" />
                            <MenuItem Header="Export as image" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <SplitButton Content="Unavailable" IsEnabled="False">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="No available actions" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </WrapPanel>
        </o:ControlShowcase>

        <o:ControlShowcase Header="Themes" SourceKey="split-button-themes">
            <WrapPanel
                ItemSpacing="12"
                LineSpacing="12"
                Margin="10,0">
                <SplitButton Content="Basic" Theme="{StaticResource BasicSplitButtonTheme}">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Basic option" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <SplitButton Content="Border" Theme="{StaticResource BorderSplitButtonTheme}">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Border option" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <SplitButton Content="Solid" Theme="{StaticResource SolidSplitButtonTheme}">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Solid option" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </WrapPanel>
        </o:ControlShowcase>

        <o:ControlShowcase Header="Semantic colors" SourceKey="split-button-colors">
            <WrapPanel
                ItemSpacing="12"
                LineSpacing="12"
                Margin="10,0">
                <SplitButton Classes="accent" Content="Accent">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Create item" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <SplitButton Classes="info" Content="Info">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="View details" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <SplitButton Classes="success" Content="Success">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Publish now" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <SplitButton Classes="warn" Content="Warning">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Review changes" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <SplitButton Classes="danger" Content="Danger">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Move to trash" />
                            <MenuItem Header="Delete permanently" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </WrapPanel>
        </o:ControlShowcase>

        <o:ControlShowcase Header="ToggleSplitButton" SourceKey="toggle-split-button">
            <WrapPanel
                ItemSpacing="12"
                LineSpacing="12"
                Margin="10,0">
                <ToggleSplitButton Content="Auto save">
                    <ToggleSplitButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="Every minute" />
                            <MenuItem Header="Every five minutes" />
                            <MenuItem Header="On focus change" />
                        </MenuFlyout>
                    </ToggleSplitButton.Flyout>
                </ToggleSplitButton>
                <ToggleSplitButton
                    Content="Sync"
                    IsChecked="True"
                    Theme="{StaticResource BorderSplitButtonTheme}">
                    <ToggleSplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Sync settings" />
                        </MenuFlyout>
                    </ToggleSplitButton.Flyout>
                </ToggleSplitButton>
                <ToggleSplitButton
                    Classes="success"
                    Content="Published"
                    IsChecked="True"
                    Theme="{StaticResource SolidSplitButtonTheme}">
                    <ToggleSplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Publishing options" />
                        </MenuFlyout>
                    </ToggleSplitButton.Flyout>
                </ToggleSplitButton>
                <ToggleSplitButton
                    Content="Unavailable"
                    IsChecked="True"
                    IsEnabled="False">
                    <ToggleSplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="No available actions" />
                        </MenuFlyout>
                    </ToggleSplitButton.Flyout>
                </ToggleSplitButton>
            </WrapPanel>
        </o:ControlShowcase>
    </demo:DemoPage>
</UserControl>