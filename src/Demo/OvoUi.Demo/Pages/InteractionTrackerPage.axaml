<UserControl
    x:Class="OvoUi.Demo.Pages.InteractionTrackerPage"
    x:DataType="pages:InteractionTrackerDemoModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:pages="using:OvoUi.Demo.Pages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="InteractionTracker">
        <ovo:ControlShowcase Header="Composition interaction without a ScrollViewer" SourceKey="smooth-scroll-interaction-tracker">
            <ovo:ControlShowcase.CodeBlocks>
                <ovo:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                <ovo:ShowcaseCodeBlock
                    Code="{Binding SourceCode}"
                    Header="C#"
                    Language="csharp" />
            </ovo:ControlShowcase.CodeBlocks>
            <StackPanel Spacing="12">
                <TextBlock Text="Drag or use the wheel anywhere in the canvas. The tiles follow the same tracker through composition expressions. Toggle inertia, or send position requests and a custom animation." TextWrapping="Wrap" />
                <WrapPanel>
                    <Button
                        Click="Move_OnClick"
                        Content="Reset"
                        Margin="0,0,8,8"
                        Tag="reset" />
                    <Button
                        Click="Move_OnClick"
                        Content="Move by 80, 40"
                        Margin="0,0,8,8"
                        Tag="by" />
                    <Button
                        Click="Move_OnClick"
                        Content="Animate to end"
                        Margin="0,0,16,8"
                        Tag="animate" />
                    <CheckBox
                        Content="Inertia"
                        IsChecked="True"
                        IsCheckedChanged="Inertia_OnChanged"
                        Name="InertiaToggle" />
                </WrapPanel>
                <TextBlock
                    Name="TrackerStatus"
                    Text="Ready"
                    TextWrapping="Wrap" />
                <Border
                    Background="#164D8DFF"
                    ClipToBounds="True"
                    Height="340"
                    Loaded="Surface_OnLoaded"
                    Name="InputSurface"
                    SizeChanged="Surface_OnSizeChanged"
                    Unloaded="Surface_OnUnloaded">
                    <Canvas>
                        <Border
                            Background="#CC4D8DFF"
                            CornerRadius="12"
                            Height="80"
                            Name="PrimaryTile"
                            Width="110">
                            <TextBlock
                                Foreground="White"
                                HorizontalAlignment="Center"
                                Text="Position"
                                VerticalAlignment="Center" />
                        </Border>
                        <Border
                            Background="#CC299C7B"
                            Canvas.Left="140"
                            Canvas.Top="100"
                            CornerRadius="12"
                            Height="80"
                            IsHitTestVisible="False"
                            Name="FollowerTile"
                            Width="110">
                            <TextBlock
                                Foreground="White"
                                HorizontalAlignment="Center"
                                Text="Half speed"
                                VerticalAlignment="Center" />
                        </Border>
                        <Border
                            Background="#CCAD5AC0"
                            CornerRadius="12"
                            Height="80"
                            IsHitTestVisible="False"
                            Name="ReversedTile"
                            Width="110">
                            <TextBlock
                                Foreground="White"
                                HorizontalAlignment="Center"
                                Text="Reversed axes"
                                VerticalAlignment="Center" />
                        </Border>
                    </Canvas>
                </Border>
            </StackPanel>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>