<UserControl
    x:Class="OvoUi.Demo.Pages.AvatarPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="Avatar">
        <ovo:ControlShowcase Header="Sizes and shapes" SourceKey="shows-avatar-sizes">
            <StackPanel Spacing="14">
                <WrapPanel ItemSpacing="12" LineSpacing="12">
                    <ovo:Avatar Classes="extra_extra_small red" Content="2X" />
                    <ovo:Avatar Classes="extra_small pink" Content="XS" />
                    <ovo:Avatar Classes="small purple" Content="S" />
                    <ovo:Avatar Classes="default violet" Content="D" />
                    <ovo:Avatar Classes="medium indigo" Content="M" />
                    <ovo:Avatar Classes="large blue" Content="L" />
                    <ovo:Avatar Classes="extralarge cyan" Content="XL" />
                </WrapPanel>
                <WrapPanel ItemSpacing="12" LineSpacing="12">
                    <ovo:Avatar Classes="small square teal" Content="S" />
                    <ovo:Avatar Classes="default square green" Content="D" />
                    <ovo:Avatar Classes="medium square lime" Content="M" />
                    <ovo:Avatar Classes="large square orange" Content="L" />
                    <ovo:Avatar Classes="extralarge square grey" Content="XL" />
                </WrapPanel>
            </StackPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Color palette" SourceKey="shows-avatar-colors">
            <WrapPanel ItemSpacing="12" LineSpacing="12">
                <ovo:Avatar Classes="red" Content="R" />
                <ovo:Avatar Classes="pink" Content="P" />
                <ovo:Avatar Classes="purple" Content="P" />
                <ovo:Avatar Classes="violet" Content="V" />
                <ovo:Avatar Classes="indigo" Content="I" />
                <ovo:Avatar Classes="blue" Content="B" />
                <ovo:Avatar Classes="lightblue" Content="LB" />
                <ovo:Avatar Classes="cyan" Content="C" />
                <ovo:Avatar Classes="teal" Content="T" />
                <ovo:Avatar Classes="green" Content="G" />
                <ovo:Avatar Classes="lightgreen" Content="LG" />
                <ovo:Avatar Classes="lime" Content="L" />
                <ovo:Avatar Classes="yellow" Content="Y" />
                <ovo:Avatar Classes="amber" Content="A" />
                <ovo:Avatar Classes="orange" Content="O" />
                <ovo:Avatar Classes="grey" Content="G" />
            </WrapPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Hover mask and states" SourceKey="shows-avatar-interaction">
            <WrapPanel ItemSpacing="18" LineSpacing="12">
                <ovo:Avatar Classes="large red" Content="HI">
                    <ovo:Avatar.HoverMask>
                        <Border Background="{DynamicResource SystemAccentColor}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <PathIcon
                                    Data="M3,5 L21,5 21,19 3,19 Z M8,5 L10,2 14,2 16,5 M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8"
                                    Foreground="White"
                                    Height="24"
                                    Width="24" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="White"
                                    Text="Change" />
                            </StackPanel>
                        </Border>
                    </ovo:Avatar.HoverMask>
                </ovo:Avatar>
                <ovo:Avatar Classes="large square teal" Content="OV">
                    <ovo:Avatar.HoverMask>
                        <Border Background="#A0000000">
                            <TextBlock
                                Foreground="White"
                                HorizontalAlignment="Center"
                                Text="Edit"
                                VerticalAlignment="Center" />
                        </Border>
                    </ovo:Avatar.HoverMask>
                </ovo:Avatar>
                <ovo:Avatar
                    Classes="large grey"
                    Content="NA"
                    IsEnabled="False" />
            </WrapPanel>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>