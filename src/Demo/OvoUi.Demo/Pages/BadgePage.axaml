<UserControl
    x:Class="OvoUi.Demo.Pages.BadgePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="Badge">
        <ovo:ControlShowcase Header="Badge examples" SourceKey="shows-badge">
            <WrapPanel ItemSpacing="28">
                <ovo:Badge Header="8">
                    <Button Content="Inbox" />
                </ovo:Badge>
                <ovo:Badge Header="120" OverflowCount="99">
                    <Button Content="Messages" />
                </ovo:Badge>
                <ovo:Badge
                    Background="{DynamicResource ErrorColor}"
                    BorderBrush="{DynamicResource ErrorColor}"
                    CornerPosition="TopRight"
                    Dot="True">
                    <Button Content="Online" />
                </ovo:Badge>
                <ovo:Badge CornerPosition="BottomRight" Header="3">
                    <Button Content="Disabled" IsEnabled="False" />
                </ovo:Badge>
            </WrapPanel>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>