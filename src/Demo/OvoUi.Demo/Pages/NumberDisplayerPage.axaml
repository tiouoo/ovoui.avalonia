<UserControl
    x:DataType="pages:NumberDisplayerDemoViewModel"
    x:Class="OvoUi.Demo.Pages.NumberDisplayerPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:pages="using:OvoUi.Demo.Pages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="NumberDisplayer">
        <ovo:ControlShowcase Header="NumberDisplayer examples" SourceKey="shows-number-displayer">
            <StackPanel Spacing="16">
                <WrapPanel ItemSpacing="30">
                    <ovo:Int32Displayer
                        Duration="0:0:1"
                        FontSize="32"
                        Value="{Binding #Int.Value}" />
                    <ovo:DoubleDisplayer
                        Duration="0:0:.6"
                        FontSize="32"
                        StringFormat="F2"
                        Value="{Binding #Double.Value}" />
                </WrapPanel>
                <NumericUpDown
                    Maximum="9999999"
                    Name="Int"
                    Value="1280" />
                <Slider
                    Maximum="100"
                    Name="Double"
                    Value="42.5" />
            </StackPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Change values with animation" SourceKey="shows-number-displayer-change">
            <ovo:ControlShowcase.CodeBlocks>
                <ovo:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                <ovo:ShowcaseCodeBlock
                    Code="{Binding SourceCode}"
                    Header="C#"
                    Language="csharp" />
            </ovo:ControlShowcase.CodeBlocks>
            <StackPanel Spacing="18">
                <Button
                    Command="{Binding ChangeCommand}"
                    Content="Change values"
                    HorizontalAlignment="Left" />
                <Grid
                    ColumnDefinitions="Auto,*"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    RowSpacing="12">
                    <TextBlock Text="Int32" />
                    <ovo:Int32Displayer
                        Duration="0:0:1"
                        FontSize="28"
                        Grid.Column="1"
                        StringFormat="N0"
                        Value="{Binding Value}" />
                    <TextBlock Grid.Row="1" Text="Int64" />
                    <ovo:Int64Displayer
                        Duration="0:0:1.2"
                        FontSize="28"
                        Grid.Column="1"
                        Grid.Row="1"
                        StringFormat="N0"
                        Value="{Binding LongValue}" />
                    <TextBlock Grid.Row="2" Text="Double" />
                    <ovo:DoubleDisplayer
                        Duration="0:0:0.8"
                        FontSize="28"
                        Grid.Column="1"
                        Grid.Row="2"
                        StringFormat="N2"
                        Value="{Binding DoubleValue}" />
                    <TextBlock Grid.Row="3" Text="Date" />
                    <ovo:DateDisplay
                        Duration="0:0:1"
                        FontSize="24"
                        Grid.Column="1"
                        Grid.Row="3"
                        StringFormat="yyyy-MM-dd"
                        Value="{Binding DateValue}" />
                </Grid>
                <TextBlock Text="The values interpolate to their new targets instead of jumping immediately." TextWrapping="Wrap" />
            </StackPanel>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>