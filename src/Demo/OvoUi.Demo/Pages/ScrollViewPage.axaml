<UserControl
    x:Class="OvoUi.Demo.Pages.ScrollViewPage"
    x:DataType="pages:ScrollViewDemoModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:pages="using:OvoUi.Demo.Pages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <ovo:OvoScrollViewTheme />
    </UserControl.Styles>
    <demo:DemoPage Text="OvoScrollView">
        <ovo:ControlShowcase Header="Pan, zoom and elastic overscroll" SourceKey="smooth-scroll-view-zoom">
            <ovo:ControlShowcase.CodeBlocks>
                <ovo:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                <ovo:ShowcaseCodeBlock
                    Code="{Binding ZoomCode}"
                    Header="C#"
                    Language="csharp" />
            </ovo:ControlShowcase.CodeBlocks>
            <StackPanel Spacing="12">
                <TextBlock Text="Use the wheel to zoom, drag to pan, or pinch with two fingers. Drag past an edge to feel the spring return." TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal">
                    <Button
                        Click="Zoom_OnClick"
                        Content="Zoom in"
                        Margin="0,0,8,8"
                        Tag="in" />
                    <Button
                        Click="Zoom_OnClick"
                        Content="Zoom out"
                        Margin="0,0,8,8"
                        Tag="out" />
                    <Button
                        Click="Zoom_OnClick"
                        Content="100%"
                        Margin="0,0,8,8"
                        Tag="reset" />
                    <Button
                        Click="Zoom_OnClick"
                        Content="Minimum"
                        Margin="0,0,8,8"
                        Tag="min" />
                    <Button
                        Click="Zoom_OnClick"
                        Content="Maximum"
                        Margin="0,0,16,8"
                        Tag="max" />
                    <TextBlock Text="{Binding #ZoomView.ZoomFactor, StringFormat='Zoom: {0:P0}'}" VerticalAlignment="Center" />
                </WrapPanel>
                <ovo:OvoScrollView
                    ContentOrientation="Both"
                    Height="360"
                    HorizontalScrollBarVisibility="Auto"
                    IsZoomEnabled="True"
                    MaxZoomFactor="4"
                    MinZoomFactor="0.25"
                    Name="ZoomView"
                    VerticalScrollBarVisibility="Auto">
                    <Grid
                        ColumnDefinitions="*,*"
                        Height="800"
                        RowDefinitions="*,*"
                        Width="1200">
                        <Border Background="#334D8DFF">
                            <TextBlock
                                FontSize="48"
                                HorizontalAlignment="Center"
                                Text="Explore"
                                VerticalAlignment="Center" />
                        </Border>
                        <Border Background="#334FC1A5" Grid.Column="1">
                            <TextBlock
                                FontSize="48"
                                HorizontalAlignment="Center"
                                Text="Pan"
                                VerticalAlignment="Center" />
                        </Border>
                        <Border Background="#33EFAD57" Grid.Row="1">
                            <TextBlock
                                FontSize="48"
                                HorizontalAlignment="Center"
                                Text="Pinch"
                                VerticalAlignment="Center" />
                        </Border>
                        <Border
                            Background="#33C889DD"
                            Grid.Column="1"
                            Grid.Row="1">
                            <TextBlock
                                FontSize="48"
                                HorizontalAlignment="Center"
                                Text="Zoom"
                                VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </ovo:OvoScrollView>
            </StackPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Horizontal layout and independent scroll modes" SourceKey="smooth-scroll-view-orientation">
            <ovo:ControlShowcase.CodeBlocks>
                <ovo:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                <ovo:ShowcaseCodeBlock
                    Code="{Binding ModeCode}"
                    Header="C#"
                    Language="csharp" />
            </ovo:ControlShowcase.CodeBlocks>
            <StackPanel Spacing="12">
                <TextBlock Text="ContentOrientation controls how content grows. ScrollMode controls which axes accept input. A vertical wheel scrolls a horizontal-only view." TextWrapping="Wrap" />
                <ToggleSwitch
                    Content="Enable horizontal input"
                    IsChecked="True"
                    Name="HorizontalEnabled" />
                <ovo:OvoScrollView
                    ContentOrientation="Horizontal"
                    Height="170"
                    HorizontalScrollBarVisibility="Visible"
                    HorizontalScrollMode="{Binding #HorizontalEnabled.IsChecked, Converter={x:Static pages:ScrollViewDemoModel.ScrollModeConverter}}"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="#334D8DFF" Width="300">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Text="One"
                                VerticalAlignment="Center" />
                        </Border>
                        <Border Background="#334FC1A5" Width="300">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Text="Two"
                                VerticalAlignment="Center" />
                        </Border>
                        <Border Background="#33EFAD57" Width="300">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Text="Three"
                                VerticalAlignment="Center" />
                        </Border>
                        <Border Background="#33C889DD" Width="300">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Text="Four"
                                VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </ovo:OvoScrollView>
            </StackPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Nested scrolling and chaining" SourceKey="smooth-scroll-view-chaining">
            <StackPanel Spacing="12">
                <ToggleSwitch
                    Content="Continue scrolling the parent at an inner edge"
                    IsChecked="True"
                    Name="ChainingEnabled" />
                <ovo:OvoScrollView Height="300" IsScrollChainingEnabled="False">
                    <StackPanel Spacing="16">
                        <Border Background="#224D8DFF" Height="90">
                            <TextBlock Margin="16" Text="Outer view: scroll down into the inner view" />
                        </Border>
                        <ovo:OvoScrollView
                            Height="180"
                            IsScrollChainingEnabled="{Binding #ChainingEnabled.IsChecked}"
                            Margin="24,0">
                            <StackPanel Spacing="8">
                                <Border Background="#334FC1A5" Height="100">
                                    <TextBlock Margin="16" Text="Inner view / top" />
                                </Border>
                                <Border Background="#334FC1A5" Height="100">
                                    <TextBlock Margin="16" Text="Inner view / middle" />
                                </Border>
                                <Border Background="#334FC1A5" Height="100">
                                    <TextBlock Margin="16" Text="Inner view / bottom" />
                                </Border>
                            </StackPanel>
                        </ovo:OvoScrollView>
                        <Border Background="#22EFAD57" Height="320">
                            <TextBlock Margin="16" Text="Outer view: continued" />
                        </Border>
                    </StackPanel>
                </ovo:OvoScrollView>
            </StackPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Snap points and alignment" SourceKey="smooth-scroll-view-snaps">
            <StackPanel Spacing="12">
                <TextBlock Text="Scroll and release to settle on a card. Snap points also support vertical content and Near, Center or Far alignment." TextWrapping="Wrap" />
                <ovo:OvoScrollView
                    ContentOrientation="Horizontal"
                    Height="200"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalSnapPointsAlignment="Center"
                    HorizontalSnapPointsType="Mandatory"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Background="#334D8DFF" Width="260">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Text="Snap / 1"
                                VerticalAlignment="Center" />
                        </Border>
                        <Border Background="#334FC1A5" Width="260">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Text="Snap / 2"
                                VerticalAlignment="Center" />
                        </Border>
                        <Border Background="#33EFAD57" Width="260">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Text="Snap / 3"
                                VerticalAlignment="Center" />
                        </Border>
                        <Border Background="#33C889DD" Width="260">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Text="Snap / 4"
                                VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </ovo:OvoScrollView>
            </StackPanel>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>