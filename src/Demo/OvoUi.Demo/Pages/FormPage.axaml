<UserControl
    x:Class="OvoUi.Demo.Pages.FormPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="Form">
        <ovo:ControlShowcase Header="Left-aligned labels" SourceKey="form-left-labels">
            <ovo:Form
                HorizontalAlignment="Left"
                LabelPosition="Left"
                LabelWidth="140"
                Width="520">
                <TextBox
                    PlaceholderText="Required"
                    ovo:FormItem.IsRequired="True"
                    ovo:FormItem.Label="Name" />
                <TextBox PlaceholderText="name@example.com" ovo:FormItem.Label="Email" />
                <ComboBox PlaceholderText="Choose a role" ovo:FormItem.Label="Role">
                    <ComboBoxItem>Developer</ComboBoxItem>
                    <ComboBoxItem>Designer</ComboBoxItem>
                </ComboBox>
                <Button
                    Content="Submit"
                    HorizontalAlignment="Stretch"
                    ovo:FormItem.NoLabel="True" />
            </ovo:Form>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Top labels" SourceKey="form-top-labels">
            <ovo:Form
                HorizontalAlignment="Left"
                LabelPosition="Top"
                Width="520">
                <TextBox ovo:FormItem.Label="Project name" />
                <TextBox
                    AcceptsReturn="True"
                    Classes="TextArea"
                    Height="90"
                    ovo:FormItem.Label="Description" />
                <CheckBox Content="Make project public" ovo:FormItem.NoLabel="True" />
            </ovo:Form>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Grouped form" SourceKey="form-groups">
            <ovo:Form
                HorizontalAlignment="Left"
                LabelPosition="Left"
                LabelWidth="150"
                Width="560">
                <ovo:FormGroup Header="Account">
                    <TextBox ovo:FormItem.Label="Username" />
                    <TextBox PasswordChar="•" ovo:FormItem.Label="Password" />
                </ovo:FormGroup>
                <ovo:FormGroup Header="Preferences">
                    <ToggleSwitch IsChecked="True" ovo:FormItem.Label="Notifications" />
                    <Slider
                        Maximum="100"
                        Value="60"
                        ovo:FormItem.Label="Volume" />
                </ovo:FormGroup>
            </ovo:Form>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>