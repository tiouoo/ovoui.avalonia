<UserControl
    x:Class="OvoUi.Demo.Pages.DividerPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="Divider">
        <ovo:ControlShowcase Header="Horizontal alignment" SourceKey="layout-divider-horizontal">
            <StackPanel Spacing="20">
                <ovo:Divider HorizontalContentAlignment="Left">Left</ovo:Divider>
                <ovo:Divider HorizontalContentAlignment="Center">Center</ovo:Divider>
                <ovo:Divider HorizontalContentAlignment="Right">Right</ovo:Divider>
                <ovo:Divider HorizontalContentAlignment="Stretch">Stretch</ovo:Divider>
                <ovo:Divider />
            </StackPanel>
        </ovo:ControlShowcase>

        <ovo:ControlShowcase Header="Vertical and rich content" SourceKey="layout-divider-vertical-rich">
            <StackPanel Spacing="20">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Overview" VerticalAlignment="Center" />
                    <ovo:Divider Height="28" Orientation="Vertical" />
                    <TextBlock Text="Details" VerticalAlignment="Center" />
                    <ovo:Divider Height="28" Orientation="Vertical" />
                    <TextBlock Text="History" VerticalAlignment="Center" />
                </StackPanel>
                <ovo:Divider>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse
                            Fill="{DynamicResource SystemAccentColor}"
                            Height="8"
                            Width="8" />
                        <TextBlock FontWeight="SemiBold" Text="Active section" />
                    </StackPanel>
                </ovo:Divider>
                <ovo:Divider IsEnabled="False">Disabled</ovo:Divider>
            </StackPanel>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>