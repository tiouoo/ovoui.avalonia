<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="OvoUi.Demo.Pages.SelectableTextBlockPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:o="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="SelectableTextBlock">
        <o:ControlShowcase Header="SelectableTextBlock" SourceKey="selectable-text-block-1">
            <StackPanel Margin="10,0" Spacing="18">
                <SelectableTextBlock Text="Common selectable text" />
                <SelectableTextBlock Classes="h1" Text="H1 Heading" />
                <SelectableTextBlock Classes="h2" Text="H2 Heading" />
                <SelectableTextBlock Classes="h3" Text="H3 Heading" />
                <SelectableTextBlock Classes="h4" Text="H4 Heading" />
                <SelectableTextBlock Classes="h5" Text="H5 Heading" />
                <SelectableTextBlock Classes="h6" Text="H6 Heading" />
                <SelectableTextBlock Classes="accent" Text="Accent Text" />
                <SelectableTextBlock Classes="success" Text="Success Text" />
                <SelectableTextBlock Classes="info" Text="Information Text" />
                <SelectableTextBlock Classes="warn" Text="Warning Text" />
                <SelectableTextBlock Classes="danger" Text="Danger Text" />
                <SelectableTextBlock Classes="error" Text="Error Text" />
                <SelectableTextBlock IsEnabled="False" Text="Disabled Text" />
            </StackPanel>
        </o:ControlShowcase>
    </demo:DemoPage>
</UserControl>