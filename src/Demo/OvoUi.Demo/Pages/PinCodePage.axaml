<UserControl
    x:Class="OvoUi.Demo.Pages.PinCodePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="PinCode">
        <ovo:ControlShowcase Header="Input modes" SourceKey="pin-code-modes">
            <StackPanel HorizontalAlignment="Left" Spacing="18">
                <ovo:PinCode Count="4" />
                <ovo:PinCode Count="6" Mode="Digit" />
                <ovo:PinCode Count="6" Mode="Letter" />
                <ovo:PinCode Count="6" PasswordChar="•" />
            </StackPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Sizes and states" SourceKey="pin-code-states">
            <StackPanel HorizontalAlignment="Left" Spacing="18">
                <ovo:PinCode Classes="Small" Count="4" />
                <ovo:PinCode Count="4" />
                <ovo:PinCode Classes="Large" Count="4" />
                <ovo:PinCode Count="4" IsEnabled="False" />
            </StackPanel>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>