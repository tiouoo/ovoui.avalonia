<UserControl
    x:Class="OvoUi.Demo.Pages.DualBadgePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <StreamGeometry x:Key="DownloadIcon">M12,2 L12,15 M6,10 L12,16 18,10 M4,20 L20,20</StreamGeometry>
    </UserControl.Resources>
    <demo:DemoPage Text="DualBadge">
        <ovo:ControlShowcase Header="Flat" SourceKey="shows-dual-badge-flat">
            <WrapPanel ItemSpacing="14" LineSpacing="12">
                <ovo:DualBadge Content="35k" />
                <ovo:DualBadge Content="35k" Icon="{StaticResource DownloadIcon}" />
                <ovo:DualBadge Content="35k" Header="downloads" />
                <ovo:DualBadge
                    Content="35k"
                    Header="downloads"
                    Icon="{StaticResource DownloadIcon}" />
            </WrapPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Flat square" SourceKey="shows-dual-badge-flat-square">
            <WrapPanel ItemSpacing="14" LineSpacing="12">
                <ovo:DualBadge Classes="flat_square" Content="35k" />
                <ovo:DualBadge
                    Classes="flat_square"
                    Content="35k"
                    Icon="{StaticResource DownloadIcon}" />
                <ovo:DualBadge
                    Classes="flat_square"
                    Content="35k"
                    Header="downloads" />
                <ovo:DualBadge
                    Classes="flat_square"
                    Content="35k"
                    Header="downloads"
                    Icon="{StaticResource DownloadIcon}" />
            </WrapPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Plastic" SourceKey="shows-dual-badge-plastic">
            <WrapPanel ItemSpacing="14" LineSpacing="12">
                <ovo:DualBadge Classes="plastic" Content="35k" />
                <ovo:DualBadge
                    Classes="plastic"
                    Content="35k"
                    Icon="{StaticResource DownloadIcon}" />
                <ovo:DualBadge
                    Classes="plastic"
                    Content="35k"
                    Header="downloads" />
                <ovo:DualBadge
                    Classes="plastic"
                    Content="35k"
                    Header="downloads"
                    Icon="{StaticResource DownloadIcon}" />
            </WrapPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="For the badge" SourceKey="shows-dual-badge-for-badge">
            <WrapPanel ItemSpacing="14" LineSpacing="12">
                <ovo:DualBadge Classes="for_badge" Content="35K" />
                <ovo:DualBadge
                    Classes="for_badge"
                    Content="35K"
                    Icon="{StaticResource DownloadIcon}" />
                <ovo:DualBadge
                    Classes="for_badge"
                    Content="35K"
                    Header="DOWNLOADS" />
                <ovo:DualBadge
                    Classes="for_badge"
                    Content="35K"
                    Header="DOWNLOADS"
                    Icon="{StaticResource DownloadIcon}" />
            </WrapPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Custom colors and states" SourceKey="shows-dual-badge-custom">
            <WrapPanel ItemSpacing="14" LineSpacing="12">
                <ovo:DualBadge
                    Background="#2563EB"
                    Content="passing"
                    Header="build"
                    HeaderBackground="#1E3A8A" />
                <ovo:DualBadge
                    Background="#7C3AED"
                    Classes="plastic"
                    Content="92%"
                    Header="coverage"
                    HeaderBackground="#4C1D95"
                    Icon="{StaticResource DownloadIcon}" />
                <ovo:DualBadge
                    Classes="for_badge"
                    Content="N/A"
                    Header="DISABLED"
                    IsEnabled="False" />
            </WrapPanel>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>