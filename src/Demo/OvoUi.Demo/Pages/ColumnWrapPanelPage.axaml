<UserControl
    x:DataType="pages:ColumnWrapPanelPage"
    x:Class="OvoUi.Demo.Pages.ColumnWrapPanelPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:pages="using:OvoUi.Demo.Pages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="ColumnWrapPanel">
        <ovo:ControlShowcase Header="Column-aware wrapping" SourceKey="layout-column-wrap-panel">
            <StackPanel Spacing="12">
                <Slider
                    Maximum="6"
                    Minimum="2"
                    Name="Columns"
                    TickFrequency="1"
                    Value="4" />
                <TextBlock Text="{Binding #Columns.Value, StringFormat='Columns: {0:F0}'}" />
                <ovo:ColumnWrapPanel Column="{Binding #Columns.Value}">
                    <Button
                        Content="Short"
                        Margin="4"
                        Width="120" />
                    <Button
                        Content="Two-column item"
                        Margin="4"
                        Width="260" />
                    <Button
                        Content="Short"
                        Margin="4"
                        Width="120" />
                    <Button
                        Content="Wide item"
                        Margin="4"
                        Width="380" />
                    <Button
                        Content="Short"
                        Margin="4"
                        Width="120" />
                </ovo:ColumnWrapPanel>
            </StackPanel>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>