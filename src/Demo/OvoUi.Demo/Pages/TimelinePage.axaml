<UserControl
    x:Class="OvoUi.Demo.Pages.TimelinePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="Timeline">
        <ovo:ControlShowcase Header="Timeline examples" SourceKey="shows-timeline">
            <StackPanel Spacing="20">
                <ovo:Timeline Mode="Left">
                    <ovo:TimelineItem
                        Content="Request accepted"
                        Header="Received"
                        Type="Success" />
                    <ovo:TimelineItem
                        Content="Preparing package"
                        Header="Processing"
                        Type="Ongoing" />
                    <ovo:TimelineItem Content="Pending" Header="Delivery" />
                </ovo:Timeline>
                <ovo:Timeline Mode="Alternate">
                    <ovo:TimelineItem
                        Content="Complete"
                        Header="Design"
                        Position="Left"
                        Type="Success" />
                    <ovo:TimelineItem
                        Content="In progress"
                        Header="Review"
                        Position="Right"
                        Type="Warning" />
                </ovo:Timeline>
            </StackPanel>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>