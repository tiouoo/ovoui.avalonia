<UserControl
    x:Class="OvoUi.Demo.Pages.SmoothScrollViewerPage"
    x:DataType="pages:SmoothScrollViewerDemoModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:pages="using:OvoUi.Demo.Pages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <ovo:OvoScrollViewerTheme />
    </UserControl.Styles>
    <demo:DemoPage Text="Smooth ScrollViewer">
        <ovo:ControlShowcase Header="Virtualized list and custom bring-into-view animation" SourceKey="smooth-scroll-viewer-list">
            <ovo:ControlShowcase.CodeBlocks>
                <ovo:ShowcaseCodeBlock Header="axaml" Language="axaml" />
                <ovo:ShowcaseCodeBlock
                    Code="{Binding ListCode}"
                    Header="C#"
                    Language="csharp" />
            </ovo:ControlShowcase.CodeBlocks>
            <StackPanel Spacing="12">
                <TextBlock Text="OvoScrollViewerTheme is loaded only on this page. This ListBox contains 10,000 rows and keeps virtualization enabled." TextWrapping="Wrap" />
                <WrapPanel>
                    <Button
                        Click="BringItem_OnClick"
                        Content="Bring a random item into view"
                        Margin="0,0,16,8" />
                    <CheckBox Content="Use teleport animation" Name="CustomAnimation" />
                </WrapPanel>
                <ListBox
                    Height="300"
                    ItemsSource="{Binding Items}"
                    Loaded="VirtualList_OnLoaded"
                    Name="VirtualList"
                    SelectionMode="Multiple"
                    Unloaded="VirtualList_OnUnloaded">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Margin="8" Text="{Binding}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Text selection, caret and wheel scrolling" SourceKey="smooth-scroll-viewer-text">
            <ovo:ControlShowcase.CodeBlocks>
                <ovo:ShowcaseCodeBlock Header="axaml" Language="axaml" />
                <ovo:ShowcaseCodeBlock
                    Code="{Binding TextCode}"
                    Header="C#"
                    Language="csharp" />
            </ovo:ControlShowcase.CodeBlocks>
            <StackPanel Spacing="12">
                <TextBlock Text="Edit, select, use the keyboard and move the caret beyond the visible lines. The TextBox's internal ScrollViewer uses the same smooth presenter." TextWrapping="Wrap" />
                <TextBox
                    AcceptsReturn="True"
                    Height="220"
                    Name="SmoothTextBox"
                    Text="{Binding Text, Mode=TwoWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Anchoring while content changes" SourceKey="smooth-scroll-viewer-anchors">
            <ovo:ControlShowcase.CodeBlocks>
                <ovo:ShowcaseCodeBlock Header="axaml" Language="axaml" />
                <ovo:ShowcaseCodeBlock
                    Code="{Binding AnchorCode}"
                    Header="C#"
                    Language="csharp" />
            </ovo:ControlShowcase.CodeBlocks>
            <StackPanel Spacing="12">
                <TextBlock Text="Scroll down, then insert or resize rows above the viewport. The current anchor stays in place." TextWrapping="Wrap" />
                <WrapPanel>
                    <Button
                        Click="InsertAnchor_OnClick"
                        Content="Insert at top"
                        Margin="0,0,8,8" />
                    <Button
                        Click="ResizeAnchors_OnClick"
                        Content="Resize rows"
                        Margin="0,0,8,8" />
                    <Button
                        Click="RemoveAnchor_OnClick"
                        Content="Remove first row"
                        Margin="0,0,8,8" />
                    <TextBlock
                        Name="AnchorStatus"
                        Text="Anchor: scroll down to select"
                        VerticalAlignment="Center" />
                </WrapPanel>
                <ScrollViewer
                    Height="260"
                    Name="AnchorViewer"
                    ScrollChanged="AnchorViewer_OnScrollChanged">
                    <ItemsControl ItemsSource="{Binding AnchorItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pages:SmoothAnchorItem">
                                <Border
                                    Background="{DynamicResource ControlBackground}"
                                    BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1"
                                    Height="{Binding Height}"
                                    Loaded="Anchor_Loaded"
                                    Margin="0,0,0,4"
                                    Padding="12"
                                    Unloaded="Anchor_Unloaded">
                                    <TextBlock Text="{Binding Title}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Mouse panning and wheel direction" SourceKey="smooth-scroll-viewer-mouse">
            <ScrollViewer
                Height="200"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">
                <ScrollViewer.Styles>
                    <Style Selector="ovo|OvoScrollPresenter">
                        <Setter Property="ContentOrientation" Value="Horizontal" />
                        <Setter Property="ScrollFeatures" Value="MousePressedScroll,MousePressedScrollEnertia,WheelSwapDirections" />
                    </Style>
                </ScrollViewer.Styles>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Background="#334D8DFF" Width="400">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Text="Drag with the mouse"
                            VerticalAlignment="Center" />
                    </Border>
                    <Border Background="#334FC1A5" Width="400">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Text="Release to coast"
                            VerticalAlignment="Center" />
                    </Border>
                    <Border Background="#33EFAD57" Width="400">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Text="The wheel scrolls horizontally"
                            VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>