<UserControl
    x:Class="OvoUi.Demo.Pages.KeyGestureInputPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:generic="clr-namespace:System.Collections.Generic;assembly=System.Collections"
    xmlns:o="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="KeyGestureInput">
        <o:ControlShowcase Header="Capture shortcuts" SourceKey="key-gesture-capture">
            <StackPanel
                HorizontalAlignment="Left"
                Spacing="16"
                Width="420">
                <o:KeyGestureInput />
                <o:KeyGestureInput
                    Classes="clearButton"
                    InnerLeftContent="Shortcut"
                    InnerRightContent="Press keys" />
                <o:KeyGestureInput HorizontalContentAlignment="Left" />
                <o:KeyGestureInput InnerLeftContent="Accept only A,B and C">
                    <o:KeyGestureInput.AcceptableKeys>
                        <generic:List x:TypeArguments="Key">
                            <Key>A</Key>
                            <Key>B</Key>
                            <Key>C</Key>
                        </generic:List>
                    </o:KeyGestureInput.AcceptableKeys>
                </o:KeyGestureInput>
            </StackPanel>
        </o:ControlShowcase>
        <o:ControlShowcase Header="States" SourceKey="key-gesture-states">
            <WrapPanel ItemSpacing="16">
                <o:KeyGestureInput
                    Classes="clear"
                    InnerLeftContent="Clearable"
                    Width="300" />
                <o:KeyGestureInput
                    InnerLeftContent="Disabled"
                    IsEnabled="False"
                    Width="300" />
            </WrapPanel>
        </o:ControlShowcase>
    </demo:DemoPage>
</UserControl>