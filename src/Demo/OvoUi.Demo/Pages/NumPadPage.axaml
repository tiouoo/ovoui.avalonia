<UserControl
    x:Class="OvoUi.Demo.Pages.NumPadPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="NumPad">
        <ovo:ControlShowcase Header="Numeric input targets" SourceKey="num-pad-targets">
            <StackPanel
                HorizontalAlignment="Left"
                Spacing="14"
                Width="360">
                <TextBox PlaceholderText="Plain numeric text" ovo:NumPad.Attach="True" />
                <NumericUpDown
                    Maximum="999"
                    Minimum="0"
                    PlaceholderText="Decimal value"
                    ovo:NumPad.Attach="True" />
                <ovo:OvoNumericIntUpDown
                    InnerLeftContent="Integer"
                    PlaceholderText="OVO numeric input"
                    ovo:NumPad.Attach="True" />
                <ovo:IPv4Box InputMode="Fast" ovo:NumPad.Attach="True" />
            </StackPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Embedded NumPad" SourceKey="num-pad-embedded">
            <StackPanel HorizontalAlignment="Left" Spacing="12">
                <TextBox Name="ExplicitTarget" Width="282" />
                <ovo:NumPad Target="{Binding #ExplicitTarget}" />
            </StackPanel>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>