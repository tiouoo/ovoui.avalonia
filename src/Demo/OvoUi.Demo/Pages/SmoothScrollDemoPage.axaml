<UserControl
    x:Class="OvoUi.Demo.Pages.SmoothScrollDemoPage"
    x:DataType="pages:SmoothScrollDemoModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:pages="using:OvoUi.Demo.Pages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="Smooth Scroll Demo">
        <TextBlock Text="All original sample scenarios. Each example loads only the theme it uses; the application and navigation retain their default scrolling." TextWrapping="Wrap" />
        <TabControl Name="SampleTabs">
            <TabItem Header="Zooming">
                <ovo:ControlShowcase Header="Pan, pinch and zoom interactive content" SourceKey="smooth-scroll-original-zoom">
                    <ovo:ControlShowcase.Styles>
                        <ovo:OvoScrollViewTheme />
                    </ovo:ControlShowcase.Styles>
                    <ovo:ControlShowcase.CodeBlocks>
                        <ovo:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                        <ovo:ShowcaseCodeBlock
                            Code="{Binding ZoomCode}"
                            Header="C#"
                            Language="csharp" />
                    </ovo:ControlShowcase.CodeBlocks>
                    <StackPanel Spacing="12">
                        <TextBlock Text="Wheel or pinch to zoom; drag to pan with elastic edges. The slider inside the zoomed content remains interactive." TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                Click="Zoom_OnClick"
                                Content="+"
                                Name="ReferenceZoomIn"
                                Tag="in" />
                            <TextBlock Text="{Binding #ReferenceZoom.ZoomFactor, StringFormat='{}{0:P1}'}" VerticalAlignment="Center" />
                            <Button
                                Click="Zoom_OnClick"
                                Content="−"
                                Name="ReferenceZoomOut"
                                Tag="out" />
                        </StackPanel>
                        <ovo:OvoScrollView
                            ContentOrientation="Both"
                            Height="340"
                            HorizontalScrollBarVisibility="Hidden"
                            IsZoomEnabled="True"
                            Name="ReferenceZoom"
                            VerticalScrollBarVisibility="Hidden">
                            <Grid
                                ColumnDefinitions="*,*"
                                Height="800"
                                RowDefinitions="*,*"
                                Width="1200">
                                <Border Background="#334D8DFF">
                                    <TextBlock
                                        FontSize="48"
                                        HorizontalAlignment="Center"
                                        Text="Zoom"
                                        VerticalAlignment="Center" />
                                </Border>
                                <Border Background="#334FC1A5" Grid.Column="1">
                                    <TextBlock
                                        FontSize="48"
                                        HorizontalAlignment="Center"
                                        Text="Pan"
                                        VerticalAlignment="Center" />
                                </Border>
                                <Border Background="#33EFAD57" Grid.Row="1">
                                    <TextBlock
                                        FontSize="48"
                                        HorizontalAlignment="Center"
                                        Text="Pinch"
                                        VerticalAlignment="Center" />
                                </Border>
                                <Border
                                    Background="#33C889DD"
                                    Grid.Column="1"
                                    Grid.Row="1">
                                    <TextBlock
                                        FontSize="48"
                                        HorizontalAlignment="Center"
                                        Text="Explore"
                                        VerticalAlignment="Center" />
                                </Border>
                                <Slider
                                    Grid.ColumnSpan="2"
                                    Margin="24"
                                    Name="ReferenceSlider"
                                    Value="50"
                                    VerticalAlignment="Top"
                                    ZIndex="1" />
                            </Grid>
                        </ovo:OvoScrollView>
                    </StackPanel>
                </ovo:ControlShowcase>
            </TabItem>
            <TabItem Header="List">
                <ovo:ControlShowcase Header="Virtualization and replaceable bring-into-view animation" SourceKey="smooth-scroll-original-list">
                    <ovo:ControlShowcase.Styles>
                        <ovo:OvoScrollViewerTheme />
                    </ovo:ControlShowcase.Styles>
                    <ovo:ControlShowcase.CodeBlocks>
                        <ovo:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                        <ovo:ShowcaseCodeBlock
                            Code="{Binding ListCode}"
                            Header="C#"
                            Language="csharp" />
                    </ovo:ControlShowcase.CodeBlocks>
                    <StackPanel Spacing="12">
                        <WrapPanel>
                            <Button
                                Click="BringItem_OnClick"
                                Content="Bring random item into view"
                                Margin="0,0,12,8"
                                Name="ReferenceBringItem" />
                            <ComboBox
                                ItemsSource="{Binding AnimationModes}"
                                Margin="0,0,0,8"
                                Name="AnimationMode"
                                SelectedIndex="0" />
                        </WrapPanel>
                        <ListBox
                            Height="340"
                            ItemsSource="{Binding Items}"
                            Loaded="List_OnLoaded"
                            Name="ReferenceList"
                            SelectionMode="Multiple"
                            Unloaded="List_OnUnloaded">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="x:Int32">
                                    <TextBlock Margin="8" Text="{Binding}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ovo:ControlShowcase>
            </TabItem>
            <TabItem Header="TextBox">
                <ovo:ControlShowcase Header="Editable text, selection and caret navigation" SourceKey="smooth-scroll-original-textbox">
                    <ovo:ControlShowcase.Styles>
                        <ovo:OvoScrollViewerTheme />
                    </ovo:ControlShowcase.Styles>
                    <ovo:ControlShowcase.CodeBlocks>
                        <ovo:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                        <ovo:ShowcaseCodeBlock
                            Code="{Binding TextCode}"
                            Header="C#"
                            Language="csharp" />
                    </ovo:ControlShowcase.CodeBlocks>
                    <TextBox
                        AcceptsReturn="True"
                        Height="380"
                        Name="ReferenceText"
                        Text="{Binding Text, Mode=TwoWay}"
                        TextWrapping="Wrap" />
                </ovo:ControlShowcase>
            </TabItem>
            <TabItem Header="Chaining">
                <ovo:ControlShowcase Header="Vertical and horizontal nested scrolling" SourceKey="smooth-scroll-original-chaining">
                    <ovo:ControlShowcase.Styles>
                        <ovo:OvoScrollViewerTheme />
                    </ovo:ControlShowcase.Styles>
                    <ovo:ControlShowcase.CodeBlocks>
                        <ovo:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                        <ovo:ShowcaseCodeBlock
                            Code="{Binding ChainingCode}"
                            Header="C#"
                            Language="csharp" />
                    </ovo:ControlShowcase.CodeBlocks>
                    <StackPanel Spacing="12">
                        <ToggleSwitch
                            Content="Continue scrolling the parent at an inner edge"
                            IsChecked="True"
                            Name="ReferenceChaining" />
                        <ScrollViewer Height="360" Name="ReferenceOuter">
                            <StackPanel Spacing="16">
                                <TextBlock FontWeight="Bold" Text="Vertical" />
                                <ScrollViewer
                                    Height="200"
                                    IsScrollChainingEnabled="{Binding #ReferenceChaining.IsChecked}"
                                    Name="ReferenceVertical">
                                    <ItemsControl ItemsSource="{Binding Children}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border
                                                    Background="#224D8DFF"
                                                    Height="84"
                                                    Margin="0,0,0,12"
                                                    Padding="16">
                                                    <TextBlock Text="{Binding}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock FontWeight="Bold" Text="Horizontal" />
                                <ScrollViewer
                                    Height="160"
                                    HorizontalScrollBarVisibility="Auto"
                                    IsScrollChainingEnabled="{Binding #ReferenceChaining.IsChecked}"
                                    Name="ReferenceHorizontal"
                                    VerticalScrollBarVisibility="Disabled">
                                    <ScrollViewer.Styles>
                                        <Style Selector="ovo|OvoScrollPresenter">
                                            <Setter Property="ContentOrientation" Value="Horizontal" />
                                        </Style>
                                    </ScrollViewer.Styles>
                                    <ItemsControl ItemsSource="{Binding Cards}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border
                                                    Background="#224FC1A5"
                                                    Margin="0,0,24,0"
                                                    Padding="16"
                                                    Width="300">
                                                    <TextBlock Text="{Binding}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Border Background="#22EFAD57" Height="240">
                                    <TextBlock Margin="16" Text="Outer viewer: keep scrolling" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </ovo:ControlShowcase>
            </TabItem>
            <TabItem Header="Anchor">
                <ovo:ControlShowcase Header="Anchor candidates, incremental resizing and scroll events" SourceKey="smooth-scroll-original-anchor">
                    <ovo:ControlShowcase.Styles>
                        <ovo:OvoScrollViewerTheme />
                    </ovo:ControlShowcase.Styles>
                    <ovo:ControlShowcase.CodeBlocks>
                        <ovo:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                        <ovo:ShowcaseCodeBlock
                            Code="{Binding AnchorCode}"
                            Header="C#"
                            Language="csharp" />
                    </ovo:ControlShowcase.CodeBlocks>
                    <StackPanel Spacing="12">
                        <WrapPanel>
                            <Button
                                Click="Resize_OnClick"
                                Content="Change items size"
                                Margin="0,0,12,8"
                                Name="ReferenceResize" />
                            <TextBlock
                                Name="ReferenceAnchorStatus"
                                Text="Anchor: none · ScrollChanged: 0"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                        </WrapPanel>
                        <ScrollViewer
                            Height="340"
                            Name="ReferenceAnchors"
                            ScrollChanged="Anchors_OnScrollChanged">
                            <ItemsControl ItemsSource="{Binding AnchorItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="pages:SmoothAnchorItem">
                                        <Border
                                            Background="{DynamicResource ControlBackground}"
                                            BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1"
                                            Height="{Binding Height}"
                                            Loaded="Anchor_Loaded"
                                            Padding="8"
                                            Unloaded="Anchor_Unloaded">
                                            <StackPanel Orientation="Horizontal" Spacing="16">
                                                <TextBlock Text="{Binding Title}" />
                                                <TextBlock Text="{Binding Height, StringFormat='Height: {0}'}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </ovo:ControlShowcase>
            </TabItem>
            <TabItem Header="InteractionTracker">
                <pages:InteractionTrackerPage />
            </TabItem>
        </TabControl>
    </demo:DemoPage>
</UserControl>