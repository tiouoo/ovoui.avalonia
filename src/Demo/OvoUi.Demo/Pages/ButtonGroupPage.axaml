<UserControl
    d:DesignHeight="720"
    d:DesignWidth="1000"
    mc:Ignorable="d"
    x:Class="OvoUi.Demo.Pages.ButtonGroupPage"
    x:DataType="pages:ButtonGroupPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:pages="clr-namespace:OvoUi.Demo.Pages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="ButtonGroup">
        <ovo:ControlShowcase Header="Basic" SourceKey="button-group-basic">
            <StackPanel Margin="10,0" Spacing="16">
                <ovo:ButtonGroup>
                    <Button Content="Day" />
                    <Button Content="Week" />
                    <Button Content="Month" />
                    <Button Content="Year" />
                </ovo:ButtonGroup>

                <ovo:ButtonGroup>
                    <Button Classes="accent" Content="Save" />
                    <Button Classes="info" Content="Preview" />
                    <Button Classes="success" Content="Publish" />
                    <Button Classes="warn" Content="Archive" />
                    <Button Classes="danger" Content="Delete" />
                </ovo:ButtonGroup>
            </StackPanel>
        </ovo:ControlShowcase>

        <ovo:ControlShowcase Header="States" SourceKey="button-group-states">
            <StackPanel Margin="10,0" Spacing="16">
                <ovo:ButtonGroup>
                    <Button Content="Previous" />
                    <Button Content="Page 2" IsEnabled="False" />
                    <Button Content="Next" />
                </ovo:ButtonGroup>

                <ovo:ButtonGroup IsEnabled="False">
                    <Button Content="Cut" />
                    <Button Content="Copy" />
                    <Button Content="Paste" />
                </ovo:ButtonGroup>
            </StackPanel>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>