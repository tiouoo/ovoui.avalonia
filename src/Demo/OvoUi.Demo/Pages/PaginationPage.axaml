<UserControl
    mc:Ignorable="d"
    x:Class="OvoUi.Demo.Pages.PaginationPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:demo="using:OvoUi.Demo.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="Pagination">
        <ovo:ControlShowcase Header="Basic" SourceKey="pagination-basic">
            <StackPanel Spacing="12">
                <TextBlock>
                    <Run Text="Current page: " />
                    <Run Text="{Binding #pages.CurrentPage}" />
                </TextBlock>
                <ovo:Pagination
                    CurrentPage="5"
                    PageSize="10"
                    TotalCount="240"
                    x:Name="pages" />
            </StackPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Page size and quick jump" SourceKey="pagination-options">
            <StackPanel Spacing="12">
                <WrapPanel ItemSpacing="20">
                    <ToggleSwitch
                        Content="Page size"
                        IsChecked="True"
                        x:Name="sizes" />
                    <ToggleSwitch
                        Content="Quick jump"
                        IsChecked="True"
                        x:Name="jump" />
                </WrapPanel>
                <ovo:Pagination
                    CurrentPage="3"
                    PageSizeOptions="10, 20, 50, 100"
                    ShowPageSizeSelector="{Binding #sizes.IsChecked}"
                    ShowQuickJump="{Binding #jump.IsChecked}"
                    TotalCount="600" />
            </StackPanel>
        </ovo:ControlShowcase>
        <ovo:ControlShowcase Header="Tiny and read-only" SourceKey="pagination-tiny">
            <StackPanel Spacing="16">
                <ovo:Pagination
                    PageSize="1"
                    Theme="{DynamicResource TinyPagination}"
                    TotalCount="20" />
                <ovo:Pagination
                    Classes="read_only"
                    CurrentPage="8"
                    PageSize="1"
                    Theme="{DynamicResource TinyPagination}"
                    TotalCount="20" />
            </StackPanel>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>