<Application
    Name="OvoUi.Demo"
    RequestedThemeVariant="Default"
    x:Class="OvoUi.Demo.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="Resources/Resources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <ovo:OvoUiTheme Language="en_us" />
        <ovo:OvoAvaloniaEditTheme />
        <ovo:OvoShowcaseTheme />
        <Style Selector="ovo|ControlShowcase">
            <Setter Property="HeightBehavior" Value="Animated" />
        </Style>
        <ovo:OvoUiFont />
    </Application.Styles>
</Application>
