<UserControl
    d:DesignHeight="720"
    d:DesignWidth="900"
    mc:Ignorable="d"
    x:Class="OvoUi.Demo.Views.Pages.ExamplePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            HorizontalAlignment="Stretch"
            Margin="24"
            MaxWidth="960"
            Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="Example" />
                <TextBlock
                    Opacity="0.68"
                    Text="用于验证 OvoUi 在桌面、浏览器和移动端上的基础样式与交互。"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="常用操作" />
                    <WrapPanel>
                        <Button Content="主要操作" Margin="0,0,10,10" />
                        <Button Classes="Danger" Content="危险操作" Margin="0,0,10,10" />
                        <ToggleButton Content="切换状态" Margin="0,0,10,10" />
                        <ovo:IconButton Content="图标按钮" Margin="0,0,10,10">
                            <ovo:IconButton.Icon>
                                <StreamGeometry>M12,2 A10,10 0 1 0 22,12 A10,10 0 0 0 12,2 M8,12 L11,15 L17,9</StreamGeometry>
                            </ovo:IconButton.Icon>
                        </ovo:IconButton>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="输入控件" />
                    <TextBox HorizontalAlignment="Stretch" MaxWidth="520" PlaceholderText="请输入内容" />
                    <ComboBox HorizontalAlignment="Stretch" MaxWidth="520" PlaceholderText="请选择一项">
                        <ComboBoxItem Content="Avalonia" />
                        <ComboBoxItem Content="OvoUi" />
                        <ComboBoxItem Content="Cross-platform" />
                    </ComboBox>
                    <CheckBox Content="在所有平台保持一致体验" IsChecked="True" />
                    <Slider Maximum="100" Value="64" />
                </StackPanel>
            </Border>

            <Border
                Background="{DynamicResource SystemAccentColorOpacity01}"
                CornerRadius="6"
                Padding="16">
                <Grid ColumnDefinitions="Auto,*">
                    <PathIcon
                        Data="M12,2 A10,10 0 1 0 22,12 A10,10 0 0 0 12,2 M12,7 V13 M12,17 V17.1"
                        Height="20"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top"
                        Width="20" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock FontWeight="SemiBold" Text="Demo 已就绪" />
                        <TextBlock
                            Opacity="0.72"
                            Text="后续页面只需添加到导航模型，即可自动出现在侧栏并参与页面切换。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
