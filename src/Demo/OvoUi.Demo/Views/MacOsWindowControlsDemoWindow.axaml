<Window
    Height="620"
    MinHeight="520"
    MinWidth="760"
    Title="macOS Window Controls Editor"
    Width="900"
    WindowStartupLocation="CenterOwner"
    x:Class="OvoUi.Demo.Views.MacOsWindowControlsDemoWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Native macOS window controls" />

        <Grid Grid.Row="1" ColumnDefinitions="Auto,110,Auto,110,Auto,110" ColumnSpacing="8">
            <TextBlock Text="Origin X" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Name="OriginX" Value="14" />
            <TextBlock Grid.Column="2" Text="Origin Y" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="3" Name="OriginY" Value="2" />
            <TextBlock Grid.Column="4" Text="Spacing" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="5" Name="Spacing" Value="20" />
        </Grid>

        <ScrollViewer Grid.Row="2">
            <Grid ColumnDefinitions="110,80,80,80,80,90,90,90" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="10">
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="X" />
                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Y" />
                <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Width" />
                <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Height" />
                <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="Opacity" />
                <TextBlock Grid.Column="6" FontWeight="SemiBold" Text="Visible" />
                <TextBlock Grid.Column="7" FontWeight="SemiBold" Text="Enabled" />

                <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Close" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Grid.Row="1" Name="CloseX" Value="14" />
                <NumericUpDown Grid.Column="2" Grid.Row="1" Name="CloseY" Value="2" />
                <NumericUpDown Grid.Column="3" Grid.Row="1" Minimum="1" Name="CloseWidth" Value="14" />
                <NumericUpDown Grid.Column="4" Grid.Row="1" Minimum="1" Name="CloseHeight" Value="14" />
                <NumericUpDown Grid.Column="5" Grid.Row="1" Increment="0.1" Maximum="1" Minimum="0" Name="CloseOpacity" Value="1" />
                <CheckBox Grid.Column="6" Grid.Row="1" IsChecked="True" Name="CloseVisible" />
                <CheckBox Grid.Column="7" Grid.Row="1" IsChecked="True" Name="CloseEnabled" />

                <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Minimize" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Grid.Row="2" Name="MinimizeX" Value="34" />
                <NumericUpDown Grid.Column="2" Grid.Row="2" Name="MinimizeY" Value="2" />
                <NumericUpDown Grid.Column="3" Grid.Row="2" Minimum="1" Name="MinimizeWidth" Value="14" />
                <NumericUpDown Grid.Column="4" Grid.Row="2" Minimum="1" Name="MinimizeHeight" Value="14" />
                <NumericUpDown Grid.Column="5" Grid.Row="2" Increment="0.1" Maximum="1" Minimum="0" Name="MinimizeOpacity" Value="1" />
                <CheckBox Grid.Column="6" Grid.Row="2" IsChecked="True" Name="MinimizeVisible" />
                <CheckBox Grid.Column="7" Grid.Row="2" IsChecked="True" Name="MinimizeEnabled" />

                <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Zoom" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Grid.Row="3" Name="ZoomX" Value="54" />
                <NumericUpDown Grid.Column="2" Grid.Row="3" Name="ZoomY" Value="2" />
                <NumericUpDown Grid.Column="3" Grid.Row="3" Minimum="1" Name="ZoomWidth" Value="14" />
                <NumericUpDown Grid.Column="4" Grid.Row="3" Minimum="1" Name="ZoomHeight" Value="14" />
                <NumericUpDown Grid.Column="5" Grid.Row="3" Increment="0.1" Maximum="1" Minimum="0" Name="ZoomOpacity" Value="1" />
                <CheckBox Grid.Column="6" Grid.Row="3" IsChecked="True" Name="ZoomVisible" />
                <CheckBox Grid.Column="7" Grid.Row="3" IsChecked="True" Name="ZoomEnabled" />
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <TextBlock Name="StatusText" Text="Change values, then apply them to this window." VerticalAlignment="Center" />
            <Button Click="UseSpacing" Content="Use origin + spacing" Grid.Column="1" />
            <Button Classes="accent" Click="ApplyOptions" Content="Apply" Grid.Column="2" />
        </Grid>
    </Grid>
</Window>
