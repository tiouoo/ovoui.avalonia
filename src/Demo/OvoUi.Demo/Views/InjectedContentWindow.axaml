<Window
    x:Class="OvoUi.Demo.Views.InjectedContentWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    CanResize="False"
    ShowInTaskbar="False"
    WindowDecorations="None"
    TransparencyLevelHint="Transparent"
    Width="800"
    Height="450">
    <Grid Background="#520B1118">
        <Border
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="460"
            Padding="28"
            Background="#E6202832"
            BorderBrush="#70FFFFFF"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="12">
                <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="White" Text="OVO UI" />
                <TextBlock Foreground="#DFFFFFFF" Text="This Avalonia content is hosted inside the selected native window." TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="True" Height="4" />
                <Button HorizontalAlignment="Left" Content="Interactive content" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
