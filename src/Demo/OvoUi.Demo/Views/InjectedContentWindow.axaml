<Window
    Background="Transparent"
    CanResize="False"
    Height="450"
    ShowInTaskbar="False"
    TransparencyLevelHint="Transparent"
    Width="800"
    WindowDecorations="None"
    x:Class="OvoUi.Demo.Views.InjectedContentWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#520B1118">
        <Border
            Background="#E6202832"
            BorderBrush="#70FFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            HorizontalAlignment="Center"
            MaxWidth="460"
            Padding="28"
            VerticalAlignment="Center">
            <StackPanel Spacing="12">
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="OVO UI" />
                <TextBlock
                    Foreground="#DFFFFFFF"
                    Text="This Avalonia content is hosted inside the selected native window."
                    TextWrapping="Wrap" />
                <ProgressBar Height="4" IsIndeterminate="True" />
                <Button Content="Interactive content" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
    </Grid>
</Window>