<ovo:OvoWindow
    Height="780"
    Icon="avares://OvoUi.Demo/Assets/icon.ico"
    MinHeight="600"
    MinWidth="940"
    Padding="0"
    Title="OvoUi.Demo"
    Width="1285"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="OvoUi.Demo.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:views="using:OvoUi.Demo.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ovo:OvoWindow.Styles>
        <Style Selector="Separator">
            <Setter Property="Background" Value="{DynamicResource TranslucentLineBrush}" />
        </Style>
        <Style Selector="ovo|ControlShowcase">
            <Setter Property="Background" Value="{DynamicResource TranslucentPopupBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TranslucentLineBrush}" />
        </Style>
        <Style Selector="Border.control-showcase-divider">
            <Setter Property="Background" Value="{DynamicResource TranslucentLineBrush}" />
        </Style>
    </ovo:OvoWindow.Styles>
    <ovo:OvoTitleBar.LeadingContent>
        <StackPanel
            IsHitTestVisible="False"
            Margin="12,0"
            Name="BrandContent"
            Orientation="Horizontal"
            Spacing="10">
            <Image Height="18" Source="{StaticResource OvoUiIcon}" />
            <TextBlock
                Margin="0,2,0,0"
                Text="OvoUi.Demo"
                VerticalAlignment="Top" />
        </StackPanel>
    </ovo:OvoTitleBar.LeadingContent>
    <ovo:OvoTitleBar.TrailingContent>
        <Button
            Classes="caption"
            Margin="0,0,7,0"
            ToolTip.Tip="Settings">
            <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Header="Theme">
                        <MenuItem
                            Click="SetThemeDefault"
                            GroupName="app-theme"
                            Header="Default"
                            IsChecked="True"
                            Name="ThemeDefaultItem"
                            ToggleType="Radio" />
                        <MenuItem
                            Click="SetThemeLight"
                            GroupName="app-theme"
                            Header="Light"
                            Name="ThemeLightItem"
                            ToggleType="Radio" />
                        <MenuItem
                            Click="SetThemeDark"
                            GroupName="app-theme"
                            Header="Dark"
                            Name="ThemeDarkItem"
                            ToggleType="Radio" />
                    </MenuItem>
                    <MenuItem Header="Language">
                        <MenuItem
                            Click="SetLanguageEnglish"
                            GroupName="app-language"
                            Header="English"
                            IsChecked="True"
                            Name="LanguageEnglishItem"
                            ToggleType="Radio" />
                        <MenuItem
                            Click="SetLanguageChinese"
                            GroupName="app-language"
                            Header="Chinese"
                            Name="LanguageChineseItem"
                            ToggleType="Radio" />
                    </MenuItem>
                    <MenuItem Header="Background">
                        <MenuItem
                            Click="SetBackgroundDefault"
                            GroupName="window-background"
                            Header="Default"
                            IsChecked="True"
                            Name="BackgroundDefaultItem"
                            ToggleType="Radio" />
                        <MenuItem
                            Click="SetBackgroundMica"
                            GroupName="window-background"
                            Header="Mica"
                            Name="BackgroundMicaItem"
                            ToggleType="Radio" />
                        <MenuItem
                            Click="SetBackgroundAcrylic"
                            GroupName="window-background"
                            Header="Acrylic"
                            Name="BackgroundAcrylicItem"
                            ToggleType="Radio" />
                        <MenuItem
                            Click="SetBackgroundBlur"
                            GroupName="window-background"
                            Header="Blur"
                            Name="BackgroundBlurItem"
                            ToggleType="Radio" />
                        <MenuItem
                            Click="SetBackgroundTransparent"
                            GroupName="window-background"
                            Header="Transparent"
                            Name="BackgroundTransparentItem"
                            ToggleType="Radio" />
                    </MenuItem>
                </MenuFlyout>
            </Button.Flyout>
            <TextBlock
                FontFamily="{DynamicResource OvoIconFontFamily}"
                FontSize="14"
                FontWeight="Light"
                Text="&#xe627;" />
        </Button>
    </ovo:OvoTitleBar.TrailingContent>
    <views:DemoView Margin="0,-12,0,0" />
</ovo:OvoWindow>
