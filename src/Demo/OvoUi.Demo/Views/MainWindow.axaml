<ovo:OvoWindow
    Height="830"
    Icon="avares://OvoUi.Demo/Assets/icon.ico"
    MinHeight="520"
    MinWidth="680"
    Padding="0"
    Title="OvoUi.Demo"
    Width="1350"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="OvoUi.Demo.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:views="using:OvoUi.Demo.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ovo:OvoTitleBar.LeadingContent>
        <StackPanel
            IsHitTestVisible="False"
            Margin="12,0"
            Orientation="Horizontal"
            Spacing="10">
            <Image Height="18" Source="{StaticResource OvoUiIcon}" />
            <TextBlock
                Margin="0,2,0,0"
                Text="OvoUi.Demo"
                VerticalAlignment="Top" />
        </StackPanel>
    </ovo:OvoTitleBar.LeadingContent>
    <views:DemoView Margin="0,-12,0,0" />
</ovo:OvoWindow>
