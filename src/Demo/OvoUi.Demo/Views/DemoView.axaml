<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="OvoUi.Demo.Views.DemoView"
    x:DataType="models:DemoViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OvoUi.Demo.Models"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:showcase="using:OvoUi.AvaloniaEdit.Showcase.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <ovo:NavMenu
            Classes="FlatScrollBar"
            EnableSearch="True"
            ExpandWidth="240"
            HeaderBinding="{Binding Title}"
            IsHorizontalCollapsed="False"
            ItemsSource="{Binding Pages}"
            Margin="15,15,5,15"
            SearchPlaceholderText="{Binding SearchText}"
            SearchPlacement="Top"
            SelectedItem="{Binding SelectedPage}"
            SubMenuBinding="{Binding Children}"
            x:Name="NavMenu">
            <ovo:NavMenu.Styles>
                <Style Selector="ovo|NavMenu /template/ ItemsPresenter#PART_ItemsPresenter">
                    <Setter Property="Margin" Value="0,0,6,0" />
                </Style>
                <Style Selector="ovo|NavMenuItem:first-level">
                    <Setter Property="IsVerticalCollapsed" Value="True" />
                </Style>
            </ovo:NavMenu.Styles>
            <ovo:NavMenu.ItemTemplate>
                <DataTemplate DataType="models:Page">
                    <ovo:NavMenuItem IsVerticalCollapsed="True" />
                </DataTemplate>
            </ovo:NavMenu.ItemTemplate>
        </ovo:NavMenu>
        <TransitioningContentControl Content="{Binding SelectedPage.Content}">
            <TransitioningContentControl.PageTransition>
                <showcase:SlideFadePageTransition EnterFromLeft="True" />
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>
    </DockPanel>
</UserControl>
