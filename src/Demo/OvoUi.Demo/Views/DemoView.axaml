<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="OvoUi.Demo.Views.DemoView"
    x:DataType="models:DemoViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OvoUi.Demo.Models"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource OvoCornerRadius}"
            DockPanel.Dock="Left"
            Margin="15,15,-5,15">
            <ovo:NavMenu
                Classes="FlatScrollBar"
                CollapseWidth="56"
                EnableSearch="True"
                ExpandWidth="240"
                HeaderBinding="{Binding Title}"
                IconBinding="{Binding Icon}"
                ItemsSource="{Binding Pages}"
                Margin="10,10,4,10"
                SearchPlaceholderText="Search..."
                SearchPlacement="Top"
                SelectedItem="{Binding SelectedPage}"
                SubMenuBinding="{Binding Children}"
                x:Name="NavMenu">
                <ovo:NavMenu.Styles>
                    <Style Selector="ovo|NavMenu /template/ ItemsPresenter#PART_ItemsPresenter">
                        <Setter Property="Margin" Value="0,0,6,0" />
                    </Style>
                    <Style Selector="ovo|NavMenuItem:first-level">
                        <Setter Property="IsVerticalCollapsed" Value="True" />
                    </Style>
                </ovo:NavMenu.Styles>
                <ovo:NavMenu.IconTemplate>
                    <DataTemplate DataType="x:String">
                        <PathIcon
                            Data="{Binding}"
                            Height="19"
                            Margin="2,0,-1,0"
                            Width="19" />
                    </DataTemplate>
                </ovo:NavMenu.IconTemplate>
                <ovo:NavMenu.ItemTemplate>
                    <DataTemplate DataType="models:Page">
                        <ovo:NavMenuItem IsVerticalCollapsed="True" />
                    </DataTemplate>
                </ovo:NavMenu.ItemTemplate>
            </ovo:NavMenu>
        </Border>
        <ContentControl Content="{Binding SelectedPage.Content}" />
    </DockPanel>
</UserControl>
