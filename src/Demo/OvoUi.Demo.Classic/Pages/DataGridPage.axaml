<UserControl
    x:Class="OvoUi.Demo.Classic.Pages.DataGridPage"
    x:CompileBindings="False"
    xmlns="https://github.com/avaloniaui"
    xmlns:demo="using:OvoUi.Demo.Classic.Controls"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <demo:DemoPage Text="DataGrid">
        <ovo:ControlShowcase Header="DataGrid examples" SourceKey="shows-data-grid">
            <ovo:ControlShowcase.CodeBlocks>
                <ovo:ShowcaseCodeBlock Header="AXAML" Language="axaml" />
                <ovo:ShowcaseCodeBlock
                    Code="{Binding SourceCode}"
                    Header="C#"
                    Language="csharp" />
            </ovo:ControlShowcase.CodeBlocks>
            <DataGrid
                AutoGenerateColumns="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                GridLinesVisibility="All"
                ItemsSource="{Binding People}"
                SelectedIndex="0">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Binding="{Binding Name}"
                        Header="Name"
                        Width="*" />
                    <DataGridTextColumn
                        Binding="{Binding Role}"
                        Header="Role"
                        Width="*" />
                    <DataGridCheckBoxColumn Binding="{Binding Active}" Header="Active" />
                </DataGrid.Columns>
            </DataGrid>
        </ovo:ControlShowcase>
    </demo:DemoPage>
</UserControl>