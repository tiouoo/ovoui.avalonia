<Application
    x:Class="OvoUi.Demo.Classic.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Styles>
        <ovo:OvoUiTheme Language="en_us" />
        <ovo:OvoUiDataGridTheme />
        <ovo:OvoAvaloniaEditTheme />
        <ovo:OvoShowcaseTheme />
        <ovo:OvoUiFont />

        <Style Selector="ovo|ControlShowcase">
            <Setter Property="HeightBehavior" Value="Animated" />
        </Style>
    </Application.Styles>
</Application>
