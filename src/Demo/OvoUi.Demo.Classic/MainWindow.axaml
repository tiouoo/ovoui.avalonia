<ovo:OvoWindow
    Height="780"
    MinHeight="600"
    MinWidth="940"
    Padding="0"
    Title="OvoUi Classic Demo"
    Width="1285"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="OvoUi.Demo.Classic.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:views="using:OvoUi.Demo.Classic.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ovo:OvoWindow.Styles>
        <Style Selector="Separator">
            <Setter Property="Background" Value="{DynamicResource TranslucentLineBrush}" />
        </Style>
        <Style Selector="ovo|ControlShowcase">
            <Setter Property="Background" Value="{DynamicResource TranslucentPopupBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TranslucentLineBrush}" />
        </Style>
        <Style Selector="Border.control-showcase-divider">
            <Setter Property="Background" Value="{DynamicResource TranslucentLineBrush}" />
        </Style>
    </ovo:OvoWindow.Styles>
    <ovo:OvoTitleBar.LeadingContent>
        <TextBlock Margin="12,0" Text="OvoUi Classic Demo" IsHitTestVisible="False" />
    </ovo:OvoTitleBar.LeadingContent>
    <views:DemoView Margin="0,-12,0,0" />
</ovo:OvoWindow>