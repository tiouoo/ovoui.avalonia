<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>OvoUi</PackageId>
        <AssemblyName>OvoUi</AssemblyName>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsAotCompatible>true</IsAotCompatible>
        <Title>OvoUi</Title>
        <Description>An Avalonia UI control library and theme.</Description>
        <PackageTags>avalonia;ui;controls;theme</PackageTags>
        <PackageIcon>icon_256.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4"/>
        <PackageReference Include="System.Reactive" Version="7.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="..\..\assets\iconfont.ttf">
            <Link>Assets\iconfont.ttf</Link>
        </AvaloniaResource>
        <None Include="..\..\assets\icon_256.png" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
