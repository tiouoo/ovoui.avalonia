<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:collections="clr-namespace:Avalonia.Collections;assembly=Avalonia.Base"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StreamGeometry x:Key="CommandBarOverflowButtonGlyph">
        M7 12a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0Z
        M14.5 12a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0Z
        M19.5 14.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z
    </StreamGeometry>

    <ControlTheme TargetType="Button" x:Key="CommandBarButtonBaseTheme">
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Name="PART_Border"
                    Padding="{TemplateBinding Padding}">
                    <StackPanel
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        Name="PART_LayoutRoot"
                        Spacing="4"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                        <ContentPresenter Foreground="{TemplateBinding Foreground}" Name="PART_IconPresenter">
                            <ContentPresenter.DataTemplates>
                                <DataTemplate DataType="Geometry">
                                    <PathIcon Data="{Binding}" Theme="{DynamicResource InnerPathIcon}" />
                                </DataTemplate>
                            </ContentPresenter.DataTemplates>
                        </ContentPresenter>
                        <TextBlock
                            FontSize="12"
                            Foreground="{TemplateBinding Foreground}"
                            MaxLines="1"
                            Name="PART_Label"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Width" Value="64" />
        <Setter Property="MinHeight" Value="40" />

        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Style Selector="^:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource ControlPointeroverBackground}" />
        </Style>

        <Style Selector="^:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource ControlPressedBackground}" />
        </Style>

        <Style Selector="^:disabled">
            <Style Selector="^ /template/ ContentPresenter#PART_IconPresenter">
                <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
            </Style>
            <Style Selector="^ /template/ TextBlock#PART_Label">
                <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
            </Style>
        </Style>
    </ControlTheme>

    <!--  CommandBarButton  -->
    <ControlTheme
        BasedOn="{StaticResource CommandBarButtonBaseTheme}"
        TargetType="CommandBarButton"
        x:Key="{x:Type CommandBarButton}">

        <Style Selector="^ /template/ TextBlock#PART_Label">
            <Setter Property="Text" Value="{TemplateBinding Label}" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_IconPresenter">
            <Setter Property="Content" Value="{TemplateBinding Icon}" />
        </Style>

        <!--  IsCompact: hide label, use compact width  -->
        <Style Selector="^[IsCompact=True]">
            <Setter Property="Width" Value="40" />
            <Style Selector="^ /template/ TextBlock#PART_Label">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>

        <!--  LabelPosition=Collapsed: hide label, use compact width  -->
        <Style Selector="^[LabelPosition=Collapsed]">
            <Setter Property="Width" Value="40" />
            <Style Selector="^ /template/ TextBlock#PART_Label">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>

        <!--  LabelPosition=Right: horizontal layout, auto-width  -->
        <Style Selector="^[LabelPosition=Right]">
            <Setter Property="Width" Value="{x:Static x:Double.NaN}" />
            <Setter Property="MinWidth" Value="40" />
            <Style Selector="^ /template/ StackPanel#PART_LayoutRoot">
                <Setter Property="Orientation" Value="Horizontal" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_IconPresenter">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="^ /template/ TextBlock#PART_Label">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style>

        <!--  IsInOverflow: full-width horizontal layout for use inside overflow popup  -->
        <Style Selector="^[IsInOverflow=True]">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Width" Value="{x:Static x:Double.NaN}" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,6" />
            <Style Selector="^ /template/ StackPanel#PART_LayoutRoot">
                <Setter Property="Orientation" Value="Horizontal" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_IconPresenter">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="^ /template/ TextBlock#PART_Label">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style>
    </ControlTheme>

    <!--  CommandBarToggleButton  -->
    <ControlTheme
        BasedOn="{StaticResource CommandBarButtonBaseTheme}"
        TargetType="CommandBarToggleButton"
        x:Key="{x:Type CommandBarToggleButton}">

        <Style Selector="^ /template/ TextBlock#PART_Label">
            <Setter Property="Text" Value="{TemplateBinding Label}" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_IconPresenter">
            <Setter Property="Content" Value="{TemplateBinding Icon}" />
        </Style>

        <Style Selector="^:checked">
            <Style Selector="^ /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource SystemAccentColorOpacity02}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_IconPresenter">
                <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
            </Style>
            <Style Selector="^:pointerover /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource SystemAccentColorOpacity03}" />
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource SystemAccentColorOpacity03}" />
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#PART_IconPresenter">
                <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
            </Style>
        </Style>

        <!--  IsCompact: hide label, use compact width  -->
        <Style Selector="^[IsCompact=True]">
            <Setter Property="Width" Value="40" />
            <Style Selector="^ /template/ TextBlock#PART_Label">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>

        <!--  LabelPosition=Collapsed: hide label, use compact width  -->
        <Style Selector="^[LabelPosition=Collapsed]">
            <Setter Property="Width" Value="40" />
            <Style Selector="^ /template/ TextBlock#PART_Label">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>

        <!--  LabelPosition=Right: horizontal layout, auto-width  -->
        <Style Selector="^[LabelPosition=Right]">
            <Setter Property="Width" Value="{x:Static x:Double.NaN}" />
            <Setter Property="MinWidth" Value="40" />
            <Style Selector="^ /template/ StackPanel#PART_LayoutRoot">
                <Setter Property="Orientation" Value="Horizontal" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_IconPresenter">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="^ /template/ TextBlock#PART_Label">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style>

        <!--  IsInOverflow: full-width horizontal layout for use inside overflow popup  -->
        <Style Selector="^[IsInOverflow=True]">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Width" Value="{x:Static x:Double.NaN}" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,6" />
            <Style Selector="^ /template/ StackPanel#PART_LayoutRoot">
                <Setter Property="Orientation" Value="Horizontal" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_IconPresenter">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="^ /template/ TextBlock#PART_Label">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style>
    </ControlTheme>

    <!--  CommandBarSeparator  -->
    <ControlTheme TargetType="CommandBarSeparator" x:Key="{x:Type CommandBarSeparator}">
        <Setter Property="Background" Value="{DynamicResource LineBrush}" />
        <Setter Property="Width" Value="1" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Template">
            <ControlTemplate TargetType="CommandBarSeparator">
                <Border
                    Background="{TemplateBinding Background}"
                    MinHeight="{TemplateBinding MinHeight}"
                    Width="{TemplateBinding Width}" />
            </ControlTemplate>
        </Setter>

        <!--  IsInOverflow: horizontal line separator  -->
        <Style Selector="^[IsInOverflow=True]">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Width" Value="{x:Static x:Double.NaN}" />
            <Setter Property="Height" Value="1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="4" />
        </Style>
    </ControlTheme>

    <!--  CommandBar  -->
    <ControlTheme TargetType="CommandBar" x:Key="{x:Type CommandBar}">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource OvoCornerRadius}" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate TargetType="CommandBar">
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    MinHeight="{TemplateBinding MinHeight}"
                    Padding="{TemplateBinding Padding}">
                    <Panel>
                        <DockPanel KeyboardNavigation.TabNavigation="Cycle">
                            <!--  Overflow button (docked right)  -->
                            <CommandBarButton
                                DockPanel.Dock="Right"
                                Icon="{DynamicResource CommandBarOverflowButtonGlyph}"
                                IsCompact="True"
                                IsVisible="{TemplateBinding IsOverflowButtonVisible}"
                                Name="PART_OverflowButton" />

                            <!--  Custom content (docked left)  -->
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                DockPanel.Dock="Left"
                                Name="PART_ContentPresenter"
                                VerticalAlignment="Center" />

                            <!--  Primary commands (fills remaining space, right-aligned)  -->
                            <ItemsControl
                                ClipToBounds="True"
                                HorizontalAlignment="Right"
                                ItemsSource="{Binding VisiblePrimaryCommands, RelativeSource={RelativeSource TemplatedParent}}"
                                Name="PART_PrimaryCommands"
                                VerticalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DockPanel>

                        <!--  Overflow popup  -->
                        <Popup
                            IsLightDismissEnabled="True"
                            IsOpen="{TemplateBinding IsOpen,
                                                     Mode=TwoWay}"
                            Name="PART_OverflowPopup"
                            Placement="Bottom"
                            PlacementTarget="{Binding #PART_OverflowButton}"
                            WindowManagerAddShadowHint="False">
                            <Border
                                Background="{DynamicResource PopupBackgroundBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                BoxShadow="{DynamicResource PopupBoxShadow}"
                                CornerRadius="{DynamicResource OvoCornerRadius}"
                                Margin="8"
                                MaxHeight="400"
                                MaxWidth="600"
                                MinHeight="16"
                                Padding="0,4">

                                <ItemsControl ItemsSource="{Binding OverflowItems, RelativeSource={RelativeSource TemplatedParent}}" Name="PART_OverflowPresenter">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>