<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme TargetType="ContextMenu" x:Key="SukiContextMenuStyle">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Template">
            <ControlTemplate>
                <LayoutTransformControl
                    Cursor="Arrow"
                    Margin="1,0,0,0"
                    Name="PART_LayoutTransform"
                    Opacity="1"
                    RenderTransformOrigin="0%, 0%">
                    <Panel Cursor="Arrow">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Margin="16" />
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BoxShadow="{DynamicResource PopupBoxShadow}"
                            ClipToBounds="False"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Margin="15">
                            <Panel Margin="4">
                                <ItemsPresenter
                                    HorizontalAlignment="Left"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    KeyboardNavigation.TabNavigation="Continue"
                                    Name="PART_ItemsPresenter"
                                    VerticalAlignment="Center" />
                            </Panel>
                        </Border>
                    </Panel>
                </LayoutTransformControl>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme
        BasedOn="{StaticResource SukiContextMenuStyle}"
        TargetType="ContextMenu"
        x:Key="{x:Type ContextMenu}" />
</ResourceDictionary>
