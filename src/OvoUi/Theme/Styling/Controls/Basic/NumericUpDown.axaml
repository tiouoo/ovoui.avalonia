<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.PreviewWith>
        <StackPanel
            Margin="20"
            Spacing="20"
            Width="300">
            <NumericUpDown Classes="border" />
            <NumericUpDown Classes="border_focus" />
            <NumericUpDown Theme="{StaticResource BasicNumericUpDownTheme}" />
            <NumericUpDown Theme="{StaticResource BorderNumericUpDownTheme}" />
            <NumericUpDown Theme="{StaticResource LooklessNumericUpDownTheme}" />
        </StackPanel>
    </Design.PreviewWith>

    <ControlTheme TargetType="NumericUpDown" x:Key="BasicNumericUpDownTheme">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{DynamicResource OvoCornerRadius}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <ControlTemplate TargetType="NumericUpDown">
                <DataValidationErrors>
                    <ButtonSpinner
                        AllowSpin="{TemplateBinding AllowSpin}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        ButtonSpinnerLocation="{TemplateBinding ButtonSpinnerLocation}"
                        HorizontalContentAlignment="Stretch"
                        MinWidth="0"
                        Name="PART_Spinner"
                        ShowButtonSpinner="{TemplateBinding ShowButtonSpinner}"
                        VerticalContentAlignment="Stretch">
                        <TextBox
                            AcceptsReturn="False"
                            Classes="no_error"
                            Classes.border="{Binding Classes, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ovo:ClassesContainsConverter.Instance}, ConverterParameter=border}"
                            Classes.border_focus="{Binding Classes, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ovo:ClassesContainsConverter.Instance}, ConverterParameter=border_focus}"
                            Classes.clear="{Binding Classes, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ovo:ClassesContainsConverter.Instance}, ConverterParameter=clear}"
                            Classes.text_area="{Binding Classes, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ovo:ClassesContainsConverter.Instance}, ConverterParameter=text_area}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            DataValidationErrors.Errors="{Binding $parent[NumericUpDown].(DataValidationErrors.Errors)}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}"
                            Height="{TemplateBinding Height}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            InnerLeftContent="{TemplateBinding InnerLeftContent}"
                            InnerRightContent="{TemplateBinding InnerRightContent}"
                            IsReadOnly="{TemplateBinding IsReadOnly}"
                            MinHeight="{TemplateBinding MinHeight}"
                            Name="PART_TextBox"
                            PlaceholderText="{TemplateBinding PlaceholderText}"
                            Text="{TemplateBinding Text}"
                            TextWrapping="NoWrap"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ButtonSpinner>
                </DataValidationErrors>
            </ControlTemplate>
        </Setter>



        <Style Selector="^:error">
            <Style Selector="^ /template/ TextBox#PART_TextBox">
                <Setter Property="Background" Value="{DynamicResource DataValidationErrorsBackground}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
            <Style Selector="^:pointerover /template/ TextBox#PART_TextBox">
                <Setter Property="Background" Value="{DynamicResource DataValidationErrorsPointeroverBackground}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
            <Style Selector="^:pressed /template/ TextBox#PART_TextBox">
                <Setter Property="Background" Value="{DynamicResource DataValidationErrorsPressedBackground}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
            <Style Selector="^:focus /template/ TextBox#PART_TextBox">
                <Setter Property="Background" Value="{DynamicResource DataValidationErrorsSelectedBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DataValidationErrorsSelectedBorderBrush}" />
            </Style>
        </Style>
    </ControlTheme>

    <ControlTheme
        BasedOn="{StaticResource BasicNumericUpDownTheme}"
        TargetType="NumericUpDown"
        x:Key="LooklessNumericUpDownTheme">
        <Style Selector="^ /template/ TextBox#PART_TextBox">
            <Setter Property="Theme" Value="{StaticResource LooklessTextBoxTheme}" />
        </Style>
        <Style Selector="^.text_area /template/ TextBox#PART_TextBox">
            <Setter Property="Padding" Value="10,5,8,5" />
        </Style>
    </ControlTheme>

    <ControlTheme
        BasedOn="{StaticResource LooklessNumericUpDownTheme}"
        TargetType="NumericUpDown"
        x:Key="SolidNumericUpDownTheme">
        <Style Selector="^ /template/ TextBox#PART_TextBox">
            <Setter Property="Theme" Value="{StaticResource SolidTextBoxTheme}" />
        </Style>
    </ControlTheme>

    <ControlTheme
        BasedOn="{StaticResource LooklessNumericUpDownTheme}"
        TargetType="NumericUpDown"
        x:Key="BorderNumericUpDownTheme">
        <Style Selector="^ /template/ TextBox#PART_TextBox">
            <Setter Property="Theme" Value="{StaticResource BorderTextBoxTheme}" />
        </Style>
    </ControlTheme>

    <ControlTheme
        BasedOn="{StaticResource SolidNumericUpDownTheme}"
        TargetType="NumericUpDown"
        x:Key="{x:Type NumericUpDown}" />

</ResourceDictionary>