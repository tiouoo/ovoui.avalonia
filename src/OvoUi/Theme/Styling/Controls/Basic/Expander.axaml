<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Background="Aquamarine" Padding="20">
            <StackPanel Spacing="20">
                <Expander Header="Expander" IsExpanded="True">
                    <TextBlock Text="Content" />
                </Expander>
                <Expander Header="Expander" IsExpanded="True">
                    <TextBlock Text="Content" />
                </Expander>
                <Expander Header="Expander" IsExpanded="True">
                    <TextBlock Text="Content" />
                </Expander>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <ControlTheme TargetType="Expander" x:Key="StandardExpanderTheme">
        <Setter Property="TextBlock.TextAlignment" Value="Start" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="CornerRadius" Value="{DynamicResource OvoCornerRadius}" />
        <Setter Property="ContentTransition" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource OvoFontFamily}" />
        <Setter Property="FontWeight" Value="{DynamicResource OvoFontWeight}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Name="PART_RootBorder">
                    <Border CornerRadius="{TemplateBinding CornerRadius}" Name="PART_InnerBorder">
                        <Panel>
                            <ovo:ContentExpander
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Name="PART_ContentExpand"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

                            <LayoutTransformControl Name="PART_ToggleTransform">
                                <DockPanel>
                                    <Border
                                        CornerRadius="10"
                                        DockPanel.Dock="Bottom"
                                        Height="0"
                                        HorizontalAlignment="Stretch"
                                        Name="PART_BottomBorder"
                                        Opacity="0.8" />

                                    <ToggleButton
                                        Background="Transparent"
                                        BorderThickness="0"
                                        DockPanel.Dock="Right"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        IsChecked="{TemplateBinding IsExpanded,
                                                                    Mode=TwoWay}"
                                        Name="PART_ToggleButton"
                                        Padding="10,8,10,8"
                                        Theme="{StaticResource TransparentToggleButton}"
                                        VerticalAlignment="Center">
                                        <DockPanel>
                                            <TextBlock
                                                DockPanel.Dock="Right"
                                                FontFamily="{DynamicResource OvoIconFontFamily}"
                                                FontSize="17"
                                                FontWeight="Light"
                                                Foreground="{DynamicResource InnerForegroundBrush}"
                                                HorizontalAlignment="Center"
                                                Margin="10,0,0,0"
                                                Name="PART_Icon"
                                                RenderTransform="translate(0px, 0px) rotate(0deg)"
                                                RenderTransformOrigin="50%,50%"
                                                UseLayoutRounding="False"
                                                VerticalAlignment="Center">
                                                <TextBlock.Transitions>
                                                    <Transitions>
                                                        <TransformOperationsTransition Duration="0:0:0.14" Property="RenderTransform" />
                                                    </Transitions>
                                                </TextBlock.Transitions>
                                            </TextBlock>
                                            <ContentPresenter
                                                Content="{TemplateBinding Header}"
                                                FontWeight="{DynamicResource OvoFontWeight}"
                                                VerticalAlignment="Center" />
                                        </DockPanel>
                                    </ToggleButton>
                                </DockPanel>
                            </LayoutTransformControl>
                        </Panel>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:not(.no-transitions) /template/ ovo|ContentExpander#PART_ContentExpand">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition
                        Duration="0.5"
                        Easing="ExponentialEaseOut"
                        Property="Multiplier" />
                    <DoubleTransition
                        Duration="0.5"
                        Easing="ExponentialEaseOut"
                        Property="Opacity" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="^ /template/ Border#PART_InnerBorder">
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="^ /template/ LayoutTransformControl#PART_ToggleTransform">
            <Setter Property="ClipToBounds" Value="False" />
        </Style>

        <Style Selector="^ /template/ ovo|ContentExpander#PART_ContentExpand">
            <Setter Property="Multiplier" Value="0" />
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="^:expanded /template/ ovo|ContentExpander#PART_ContentExpand">
            <Setter Property="Multiplier" Value="1" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:expanded /template/ TextBlock#PART_Icon">
            <Setter Property="RenderTransform" Value="translate(0px, 0px) rotate(180deg)" />
        </Style>

        <Style Selector="^:up">
            <Style Selector="^ /template/ TextBlock#PART_Icon">
                <Setter Property="Text" Value="&#xe645;" />
            </Style>

            <Style Selector="^ /template/ ovo|ContentExpander#PART_ContentExpand">
                <Setter Property="Orientation" Value="Vertical" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Margin" Value="0,0,0,32" />
            </Style>

            <Style Selector="^ /template/ LayoutTransformControl#PART_ToggleTransform">
                <Setter Property="VerticalAlignment" Value="Bottom" />
            </Style>

            <Style Selector="^ /template/ Border#PART_BottomBorder">
                <Setter Property="DockPanel.Dock" Value="Top" />
            </Style>
        </Style>

        <Style Selector="^:down">
            <Style Selector="^ /template/ TextBlock#PART_Icon">
                <Setter Property="Text" Value="&#xe623;" />
            </Style>

            <Style Selector="^ /template/ ovo|ContentExpander#PART_ContentExpand">
                <Setter Property="Orientation" Value="Vertical" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,32,0,0" />
            </Style>

            <Style Selector="^ /template/ LayoutTransformControl#PART_ToggleTransform">
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
        </Style>

        <Style Selector="^:left">
            <Style Selector="^ /template/ TextBlock#PART_Icon">
                <Setter Property="Text" Value="&#xe623;" />
            </Style>
            <Style Selector="^ /template/ ovo|ContentExpander#PART_ContentExpand">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Margin" Value="0,0,32,0" />
            </Style>

            <Style Selector="^ /template/ LayoutTransformControl#PART_ToggleTransform">
                <Setter Property="LayoutTransform" Value="rotate(90deg)" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
        </Style>

        <Style Selector="^:right">
            <Style Selector="^ /template/ TextBlock#PART_Icon">
                <Setter Property="Text" Value="&#xe645;" />
            </Style>
            <Style Selector="^ /template/ ovo|ContentExpander#PART_ContentExpand">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="32,0,0,0" />
            </Style>

            <Style Selector="^ /template/ LayoutTransformControl#PART_ToggleTransform">
                <Setter Property="LayoutTransform" Value="rotate(90deg)" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style Selector="^ /template/ Border#PART_BottomBorder">
                <Setter Property="DockPanel.Dock" Value="Top" />
            </Style>
        </Style>
    </ControlTheme>

    <ControlTheme
        BasedOn="{StaticResource StandardExpanderTheme}"
        TargetType="Expander"
        x:Key="{x:Type Expander}" />
</ResourceDictionary>