<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- <DatePickerPresenter YearVisible="False" /> -->
            <DatePickerPresenter Classes="border_focus" />
        </Border>
    </Design.PreviewWith>

    <ControlTheme TargetType="DatePickerPresenter" x:Key="{x:Type DatePickerPresenter}">
        <Setter Property="Width" Value="296" />
        <Setter Property="MinWidth" Value="296" />
        <Setter Property="MaxHeight" Value="304" />
        <Setter Property="FontWeight" Value="{DynamicResource OvoFontWeight}" />
        <Setter Property="FontFamily" Value="{DynamicResource OvoFontFamily}" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource OvoCornerRadius}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="DatePickerPresenter">
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    BoxShadow="{DynamicResource PopupBoxShadow}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    HorizontalAlignment="Stretch"
                    Margin="4"
                    Name="Background"
                    Padding="0">
                    <Border ClipToBounds="True" CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid Name="ContentPanel" RowDefinitions="*,Auto">
                            <Grid ColumnDefinitions="*,1,*,1,*" Name="PART_PickerContainer">

                                <Grid.Styles>
                                    <Style Selector="DateTimePickerPanel &gt; ListBoxItem">
                                        <Setter Property="Theme" Value="{StaticResource DatePickerItemTheme}" />
                                    </Style>
                                </Grid.Styles>

                                <Panel Name="PART_MonthHost">
                                    <Border
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="0"
                                        Name="PART_MonthBorder">
                                        <Panel>
                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                                <DateTimePickerPanel
                                                    ItemHeight="36"
                                                    Name="PART_MonthSelector"
                                                    PanelType="Month"
                                                    ShouldLoop="True" />
                                            </ScrollViewer>
                                        </Panel>
                                    </Border>
                                </Panel>


                                <Panel Grid.Column="2" Name="PART_DayHost">
                                    <Border BorderBrush="{DynamicResource LineBrush}">
                                        <Panel>
                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                                <DateTimePickerPanel
                                                    ItemHeight="36"
                                                    Name="PART_DaySelector"
                                                    PanelType="Day"
                                                    ShouldLoop="True" />
                                            </ScrollViewer>
                                        </Panel>
                                    </Border>
                                </Panel>

                                <Panel Grid.Column="4" Name="PART_YearHost">
                                    <Border
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="0"
                                        Name="PART_YearBorder">
                                        <Panel>
                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                                <DateTimePickerPanel
                                                    ItemHeight="36"
                                                    Name="PART_YearSelector"
                                                    PanelType="Year"
                                                    ShouldLoop="False" />
                                            </ScrollViewer>
                                        </Panel>
                                    </Border>
                                </Panel>
                            </Grid>

                            <Grid
                                ColumnDefinitions="*,Auto,*"
                                Grid.Row="1"
                                Name="AcceptDismissGrid">
                                <Button
                                    CornerRadius="{DynamicResource OvoCornerRadius}"
                                    Grid.Column="0"
                                    Height="30"
                                    HorizontalAlignment="Stretch"
                                    Margin="3,4,3,3"
                                    Name="PART_AcceptButton"
                                    Padding="0,6"
                                    Theme="{StaticResource DatePickerButtonTheme}"
                                    VerticalAlignment="Stretch">
                                    <PathIcon
                                        Data="{DynamicResource Check}"
                                        Foreground="{DynamicResource InnerForegroundBrush}"
                                        Height="15"
                                        Width="12" />
                                </Button>
                                <Rectangle
                                    Fill="{DynamicResource LineBrush}"
                                    Grid.Column="1"
                                    Margin="-2,0,0,0"
                                    Width="1" />
                                <Button
                                    CornerRadius="{DynamicResource OvoCornerRadius}"
                                    Grid.Column="2"
                                    Height="30"
                                    HorizontalAlignment="Stretch"
                                    Margin="3,4,3,3"
                                    Name="PART_DismissButton"
                                    Padding="0,6"
                                    Theme="{StaticResource DatePickerButtonTheme}"
                                    VerticalAlignment="Stretch">
                                    <PathIcon
                                        Data="{DynamicResource Close}"
                                        Foreground="{DynamicResource InnerForegroundBrush}"
                                        Height="15"
                                        Width="15" />
                                </Button>
                                <Rectangle
                                    Fill="{DynamicResource LineBrush}"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Height="1"
                                    VerticalAlignment="Top" />
                            </Grid>
                        </Grid>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Panel">
            <Style Selector="^:pointerover RepeatButton">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>

        <Style Selector="^[DayVisible=True] /template/ Border#PART_MonthBorder">
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>
        <Style Selector="^[DayVisible=True] /template/ Border#PART_YearBorder">
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>
        <Style Selector="^[MonthVisible=True] /template/ Border#PART_YearBorder">
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>
    </ControlTheme>

    <ControlTheme TargetType="DatePicker" x:Key="BasicDatePickerTheme">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource OvoCornerRadius}" />
        <Setter Property="FontWeight" Value="{DynamicResource OvoFontWeight}" />
        <Setter Property="FontFamily" Value="{DynamicResource OvoFontFamily}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <ControlTemplate TargetType="DatePicker">
                <DataValidationErrors>
                    <Grid
                        ColumnDefinitions="*, Auto"
                        Margin="{TemplateBinding Padding}"
                        Name="LayoutRoot">
                        <Button
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Cursor="Hand"
                            DataValidationErrors.Errors="{TemplateBinding (DataValidationErrors.Errors)}"
                            Foreground="{TemplateBinding Foreground}"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{TemplateBinding IsEnabled}"
                            MinHeight="{TemplateBinding MinHeight}"
                            MinWidth="298"
                            Name="PART_FlyoutButton"
                            Theme="{StaticResource DatePickerFlyoutButtonTheme}"
                            VerticalAlignment="Stretch"
                            Width="298">
                            <Grid ColumnDefinitions="*, Auto">
                                <Grid
                                    ColumnDefinitions="78*,Auto,132*,Auto,78*"
                                    Grid.Column="0"
                                    Name="PART_ButtonContentGrid">
                                    <TextBlock
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        HorizontalAlignment="Center"
                                        Name="PART_DayTextBlock"
                                        Padding="12,0"
                                        Text="{DynamicResource Lang.Day}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        HorizontalAlignment="Center"
                                        Name="PART_MonthTextBlock"
                                        Padding="12,0"
                                        Text="{DynamicResource Lang.Month}"
                                        TextAlignment="Left"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        HorizontalAlignment="Center"
                                        Name="PART_YearTextBlock"
                                        Padding="12,0"
                                        Text="{DynamicResource Lang.Year}"
                                        VerticalAlignment="Center" />
                                    <Rectangle
                                        Fill="{DynamicResource LineBrush}"
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        Name="PART_FirstSpacer"
                                        Width="1" />
                                    <Rectangle
                                        Fill="{DynamicResource LineBrush}"
                                        Grid.Column="3"
                                        HorizontalAlignment="Center"
                                        Name="PART_SecondSpacer"
                                        Width="1" />
                                </Grid>
                                <PathIcon
                                    Data="F1 M448,512z M0,0z M128,0C110.3,0,96,14.3,96,32L96,64 64,64C28.7,64,0,92.7,0,128L0,176 448,176 448,128C448,92.7,419.3,64,384,64L352,64 352,32C352,14.3 337.7,0 320,0 302.3,0 288,14.3 288,32L288,64 160,64 160,32C160,14.3,145.7,0,128,0z M0,224L0,416C0,451.3,28.7,480,64,480L384,480C419.3,480,448,451.3,448,416L448,224 0,224z"
                                    Foreground="{DynamicResource InnerForegroundBrush}"
                                    Grid.Column="1"
                                    Height="14"
                                    Margin="0,0,8,0"
                                    Name="PART_Icon"
                                    Width="20" />
                            </Grid>
                        </Button>
                        <Popup
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            InheritsTransform="True"
                            IsLightDismissEnabled="True"
                            Name="PART_Popup"
                            Placement="Bottom"
                            PlacementTarget="{TemplateBinding}"
                            WindowManagerAddShadowHint="False">
                            <DatePickerPresenter Name="PART_PickerPresenter" />
                        </Popup>
                        <Button
                            Command="{Binding $parent[DatePicker].Clear}"
                            Focusable="False"
                            Grid.Column="1"
                            IsVisible="False"
                            Margin="0,0,9,0"
                            Name="ClearButton"
                            Theme="{DynamicResource InputStandardClearIcon}">
                            <PathIcon
                                Data="{DynamicResource Close}"
                                Foreground="{DynamicResource InnerForegroundBrush}"
                                Height="11"
                                Width="16" />
                        </Button>
                    </Grid>
                </DataValidationErrors>
            </ControlTemplate>
        </Setter>

        <Style Selector="^.clearButton:pointerover, ^.ClearButton:pointerover">
            <Style Selector="^:not(:hasnodate) /template/ Button#ClearButton">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^:not(:hasnodate) /template/ PathIcon#PART_Icon">
                <Setter Property="Opacity" Value="0" />
            </Style>
        </Style>

        <Style Selector="^:disabled /template/ PathIcon#PART_Icon">
            <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
        </Style>

        <Style Selector="^:hasnodate /template/ Button#PART_FlyoutButton TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
        </Style>

        <Style Selector="^.border">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style Selector="^:pointerover">
                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style Selector="^:focus">
                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </Style>
        <Style Selector="^.border_focus:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorLight1}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="^.border_focus:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorLight1}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </ControlTheme>

    <ControlTheme
        BasedOn="{StaticResource BasicDatePickerTheme}"
        TargetType="DatePicker"
        x:Key="LooklessDatePickerTheme">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
    </ControlTheme>

    <ControlTheme
        BasedOn="{StaticResource LooklessDatePickerTheme}"
        TargetType="DatePicker"
        x:Key="SolidDatePickerTheme">
        <Style Selector="^:pointerover /template/ Button#PART_FlyoutButton">
            <Setter Property="Background" Value="{DynamicResource ControlPointeroverBackground}" />
        </Style>
        <Style Selector="^:pressed /template/ Button#PART_FlyoutButton">
            <Setter Property="Background" Value="{DynamicResource ControlPressedBackground}" />
        </Style>
        <Style Selector="^:disabled /template/ Button#PART_FlyoutButton">
            <Setter Property="Background" Value="{DynamicResource ControlDisabledBackground}" />
        </Style>
    </ControlTheme>

    <ControlTheme
        BasedOn="{StaticResource LooklessDatePickerTheme}"
        TargetType="DatePicker"
        x:Key="BorderDatePickerTheme">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Style Selector="^:pointerover /template/ Button#PART_FlyoutButton">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="^:focus /template/ Button#PART_FlyoutButton">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorLight1}" />
        </Style>
    </ControlTheme>

    <ControlTheme
        BasedOn="{StaticResource SolidDatePickerTheme}"
        TargetType="DatePicker"
        x:Key="{x:Type DatePicker}" />

    <ControlTheme TargetType="Button" x:Key="DatePickerFlyoutButtonTheme">
        <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter
                    Background="{TemplateBinding Background}"
                    BackgroundSizing="{TemplateBinding BackgroundSizing}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Content="{TemplateBinding Content}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Foreground="{TemplateBinding Foreground}"
                    HorizontalContentAlignment="Stretch"
                    Name="PART_ContentPresenter"
                    VerticalContentAlignment="Stretch" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlPointeroverBackground}" />
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlDisabledBackground}" />
        </Style>
        <Style Selector="^:error /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ErrorColorOpacity01}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorColor}" />
        </Style>
    </ControlTheme>

    <ControlTheme
        BasedOn="{StaticResource {x:Type ListBoxItem}}"
        TargetType="ListBoxItem"
        x:Key="DatePickerItemTheme">
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="CornerRadius" Value="{DynamicResource OvoCornerRadius}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6,4" />
        <Style Selector="^:selected">
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="^:selected /template/ Rectangle#SelectionIndicator">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:not(:selected) /template/ Rectangle#SelectionIndicator">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>

    <ControlTheme TargetType="Button" x:Key="DatePickerButtonTheme">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,3" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter
                        Background="{TemplateBinding Background}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        Name="ContentPresenter"
                        Padding="{TemplateBinding Padding}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlPointeroverBackground}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlPressedBackground}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
