<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <StackPanel
            Height="400"
            Margin="20"
            Width="400">
            <TabStrip Theme="{DynamicResource BorderTabStrip}">
                <TabStripItem Content="文档" />
                <TabStripItem Content="快速起步" IsEnabled="False" />
                <TabStripItem Content="帮助" IsSelected="True" />
            </TabStrip>
        </StackPanel>
    </Design.PreviewWith>

    <ControlTheme TargetType="TabStrip" x:Key="{x:Type TabStrip}">
        <Setter Property="FontSize" Value="{DynamicResource OvoFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource OvoFontWeight}" />
        <Setter Property="FontFamily" Value="{DynamicResource OvoFontFamily}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <ControlTemplate TargetType="TabStrip">
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalAlignment}">
                    <Panel>
                        <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" Name="PART_ItemsPresenter" />
                        <Border Name="PART_BorderSeparator" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Border#PART_BorderSeparator">
            <Setter Property="Background" Value="{DynamicResource OvoTabSeparatorBrush}" />
            <Setter Property="Height" Value="1" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
    </ControlTheme>

    <ControlTheme
        BasedOn="{StaticResource {x:Type TabStrip}}"
        TargetType="TabStrip"
        x:Key="DefaultTabStrip" />

    <ControlTheme
        BasedOn="{StaticResource {x:Type TabStrip}}"
        TargetType="TabStrip"
        x:Key="LineTabStrip">
        <Setter Property="ItemContainerTheme" Value="{StaticResource LineTabStripItem}" />
    </ControlTheme>

    <ControlTheme
        BasedOn="{StaticResource {x:Type TabStrip}}"
        TargetType="TabStrip"
        x:Key="CardTabStrip">
        <Setter Property="ItemContainerTheme" Value="{StaticResource CardTabStripItem}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <ControlTemplate TargetType="TabStrip">
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalAlignment}">
                    <Panel>
                        <Border Name="PART_BorderSeparator" />
                        <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" Name="PART_ItemsPresenter" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme
        BasedOn="{StaticResource {x:Type TabStrip}}"
        TargetType="TabStrip"
        x:Key="ButtonTabStrip">
        <Setter Property="ItemContainerTheme" Value="{StaticResource ButtonTabStripItem}" />
        <Style Selector="^ /template/ Border#PART_BorderSeparator">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>

    <ControlTheme
        BasedOn="{StaticResource {x:Type TabStrip}}"
        TargetType="TabStrip"
        x:Key="BorderTabStrip">
        <Setter Property="ItemContainerTheme" Value="{StaticResource BorderTabStripItem}" />
        <Style Selector="^ /template/ Border#PART_BorderSeparator">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>


    <ControlTheme TargetType="TabStripItem" x:Key="BaseTabStripItem">
        <Setter Property="FontSize" Value="{DynamicResource OvoFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource OvoFontWeight}" />
        <Setter Property="FontFamily" Value="{DynamicResource OvoFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource OvoTabHeaderForeground}" />
        <Setter Property="Background" Value="{DynamicResource OvoTabHeaderBackground}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="TabStripItem">
                <ContentPresenter
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    FontFamily="{TemplateBinding FontFamily}"
                    FontWeight="{TemplateBinding FontWeight}"
                    Foreground="{TemplateBinding Foreground}"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    Name="PART_ContentPresenter"
                    Padding="{TemplateBinding Padding}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                    <ContentPresenter.Transitions>
                        <Transitions>
                            <BrushTransition Duration="0:0:0.05" Property="Background" />
                            <BrushTransition Duration="0:0:0.05" Property="BorderBrush" />
                            <ThicknessTransition Duration="0:0:0.05" Property="BorderThickness" />
                        </Transitions>
                    </ContentPresenter.Transitions>
                </ContentPresenter>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="FontWeight" Value="{DynamicResource OvoFontWeight}" />
            <Setter Property="Foreground" Value="{DynamicResource OvoTabHeaderSelectedForeground}" />
        </Style>

        <Style Selector="^:not(:selected)">
            <Setter Property="Cursor" Value="Hand" />
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource OvoTabHeaderPointerOverForeground}" />
            </Style>
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlDisabledBackground}" />
        </Style>
    </ControlTheme>

    <ControlTheme
        BasedOn="{StaticResource BaseTabStripItem}"
        TargetType="TabStripItem"
        x:Key="{x:Type TabStripItem}">
        <Setter Property="Padding" Value="8 4" />
        <Setter Property="BorderThickness" Value="0 0 0 2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource OvoTabIndicatorBrush}" />
        </Style>

        <Style Selector="^:not(:selected)">
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BorderBrush" Value="{DynamicResource OvoTabHeaderPointerOverBorderBrush}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BorderBrush" Value="{DynamicResource OvoTabHeaderPressedBorderBrush}" />
            </Style>
        </Style>
    </ControlTheme>

    <ControlTheme
        BasedOn="{StaticResource BaseTabStripItem}"
        TargetType="TabStripItem"
        x:Key="LineTabStripItem">
        <Setter Property="Margin" Value="0 0 24 0" />
        <Setter Property="Padding" Value="4 16 4 14" />
        <Setter Property="BorderThickness" Value="0 0 0 2" />
        <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource OvoTabIndicatorBrush}" />
        </Style>

        <Style Selector="^:not(:selected)">
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BorderBrush" Value="{DynamicResource OvoTabHeaderPointerOverBorderBrush}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BorderBrush" Value="{DynamicResource OvoTabHeaderPressedBorderBrush}" />
            </Style>
        </Style>
    </ControlTheme>

    <ControlTheme
        BasedOn="{StaticResource BaseTabStripItem}"
        TargetType="TabStripItem"
        x:Key="CardTabStripItem">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Margin" Value="0 0 8 0" />
        <Setter Property="MinHeight" Value="{DynamicResource OvoTabItemHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12 0" />
        <Setter Property="BorderThickness" Value="1 1 1 0" />
        <Setter Property="CornerRadius" Value="{DynamicResource OvoCornerRadius}" />
        <Style Selector="^:selected">
            <Setter Property="BorderBrush" Value="{DynamicResource OvoTabSeparatorBrush}" />
        </Style>
        <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OvoTabCardHeaderSelectedBackground}" />
        </Style>

        <Style Selector="^:not(:selected)">
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource OvoTabCardHeaderPointerOverBackground}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource OvoTabCardHeaderPressedBackground}" />
            </Style>
        </Style>
    </ControlTheme>

    <ControlTheme
        BasedOn="{StaticResource BaseTabStripItem}"
        TargetType="TabStripItem"
        x:Key="ButtonTabStripItem">
        <Setter Property="Margin" Value="0 0 8 0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="{DynamicResource OvoTabItemHeight}" />
        <Setter Property="Padding" Value="12 0" />
        <Setter Property="CornerRadius" Value="{DynamicResource OvoCornerRadius}" />

        <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource OvoTabButtonHeaderSelectedForeground}" />
            <Setter Property="Background" Value="{DynamicResource OvoTabButtonHeaderSelectedBackground}" />
        </Style>

        <Style Selector="^:not(:selected)">
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource OvoTabButtonHeaderPointerOverBackground}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource OvoTabButtonHeaderPressedBackground}" />
            </Style>
        </Style>
    </ControlTheme>


    <ControlTheme TargetType="TabStripItem" x:Key="BorderTabStripItem">
        <Setter Property="Margin" Value="0 0 8 0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="{DynamicResource OvoTabItemHeight}" />
        <Setter Property="Padding" Value="12 0" />
        <Setter Property="CornerRadius" Value="{DynamicResource OvoCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource OvoTabBorderBrush}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="TabStripItem">
                <Border
                    BorderThickness="1"
                    CornerRadius="{DynamicResource OvoCornerRadius}"
                    Name="SelectBorder">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Duration="0:0:0.2" Property="BorderBrush" />
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        FontFamily="{TemplateBinding FontFamily}"
                        FontWeight="{TemplateBinding FontWeight}"
                        Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        Name="PART_ContentPresenter"
                        Padding="{TemplateBinding Padding}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Duration="0:0:0.2" Property="BorderBrush" />
            </Transitions>
        </Setter>

        <Style Selector="^:selected">
            <Setter Property="BorderBrush" Value="{DynamicResource OvoTabIndicatorBrush}" />
            <Style Selector="^ Border#SelectBorder">
                <Setter Property="BorderBrush" Value="{DynamicResource OvoTabIndicatorBrush}" />
            </Style>
        </Style>

        <Style Selector="^:not(:selected)">
            <Setter Property="Cursor" Value="Hand" />
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource OvoTabButtonHeaderPointerOverBackground}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource OvoTabButtonHeaderPressedBackground}" />
            </Style>
        </Style>
    </ControlTheme>

</ResourceDictionary>
