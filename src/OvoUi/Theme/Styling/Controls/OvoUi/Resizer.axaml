<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="ResizerThumbWidth">6</x:Double>
    <x:Double x:Key="ResizerThumbHeight">6</x:Double>

    <ControlTheme TargetType="ovo:WindowResizerThumb" x:Key="{x:Type ovo:WindowResizerThumb}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ovo:WindowResizerThumb">
                <ovo:PureRectangle
                    Background="{TemplateBinding Background}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme TargetType="ovo:DialogResizerThumb" x:Key="{x:Type ovo:DialogResizerThumb}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ovo:DialogResizerThumb">
                <Panel>
                    <ovo:PureRectangle
                        Background="{TemplateBinding Background}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme TargetType="ovo:DialogResizer" x:Key="{x:Type ovo:DialogResizer}">
        <Setter Property="Template">
            <ControlTemplate TargetType="ovo:DialogResizer">
                <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, *, Auto">
                    <ovo:DialogResizerThumb
                        Cursor="TopLeftCorner"
                        Grid.Column="0"
                        Grid.Row="0"
                        Name="{x:Static ovo:DialogResizer.PART_TopLeft}"
                        ResizeDirection="TopLeft" />
                    <ovo:DialogResizerThumb
                        Cursor="TopSide"
                        Grid.Column="1"
                        Grid.Row="0"
                        Height="{DynamicResource ResizerThumbHeight}"
                        Name="{x:Static ovo:DialogResizer.PART_Top}"
                        ResizeDirection="Top" />
                    <ovo:DialogResizerThumb
                        Cursor="TopRightCorner"
                        Grid.Column="2"
                        Grid.Row="0"
                        Name="{x:Static ovo:DialogResizer.PART_TopRight}"
                        ResizeDirection="TopRight" />
                    <ovo:DialogResizerThumb
                        Cursor="LeftSide"
                        Grid.Column="0"
                        Grid.Row="1"
                        Name="{x:Static ovo:DialogResizer.PART_Left}"
                        ResizeDirection="Left"
                        Width="{DynamicResource ResizerThumbWidth}" />
                    <ovo:DialogResizerThumb
                        Cursor="RightSide"
                        Grid.Column="2"
                        Grid.Row="1"
                        Name="{x:Static ovo:DialogResizer.PART_Right}"
                        ResizeDirection="Right"
                        Width="{DynamicResource ResizerThumbWidth}" />
                    <ovo:DialogResizerThumb
                        Cursor="BottomLeftCorner"
                        Grid.Column="0"
                        Grid.Row="2"
                        Name="{x:Static ovo:DialogResizer.PART_BottomLeft}"
                        ResizeDirection="BottomLeft" />
                    <ovo:DialogResizerThumb
                        Cursor="BottomSide"
                        Grid.Column="1"
                        Grid.Row="2"
                        Height="{DynamicResource ResizerThumbHeight}"
                        Name="{x:Static ovo:DialogResizer.PART_Bottom}"
                        ResizeDirection="Bottom" />
                    <ovo:DialogResizerThumb
                        Cursor="BottomRightCorner"
                        Grid.Column="2"
                        Grid.Row="2"
                        Name="{x:Static ovo:DialogResizer.PART_BottomRight}"
                        ResizeDirection="BottomRight" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme TargetType="ovo:WindowResizer" x:Key="{x:Type ovo:WindowResizer}">
        <Setter Property="Template">
            <ControlTemplate TargetType="ovo:WindowResizer">
                <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, *, Auto">
                    <ovo:WindowResizerThumb
                        Cursor="TopLeftCorner"
                        Grid.Column="0"
                        Grid.Row="0"
                        ResizeDirection="TopLeft" />
                    <ovo:WindowResizerThumb
                        Cursor="TopSide"
                        Grid.Column="1"
                        Grid.Row="0"
                        Height="{DynamicResource ResizerThumbHeight}"
                        ResizeDirection="Top" />
                    <ovo:WindowResizerThumb
                        Cursor="TopRightCorner"
                        Grid.Column="2"
                        Grid.Row="0"
                        ResizeDirection="TopRight" />
                    <ovo:WindowResizerThumb
                        Cursor="LeftSide"
                        Grid.Column="0"
                        Grid.Row="1"
                        ResizeDirection="Left"
                        Width="{DynamicResource ResizerThumbWidth}" />
                    <ovo:WindowResizerThumb
                        Cursor="RightSide"
                        Grid.Column="2"
                        Grid.Row="1"
                        ResizeDirection="Right"
                        Width="{DynamicResource ResizerThumbWidth}" />
                    <ovo:WindowResizerThumb
                        Cursor="BottomLeftCorner"
                        Grid.Column="0"
                        Grid.Row="2"
                        ResizeDirection="BottomLeft" />
                    <ovo:WindowResizerThumb
                        Cursor="BottomSide"
                        Grid.Column="1"
                        Grid.Row="2"
                        Height="{DynamicResource ResizerThumbHeight}"
                        ResizeDirection="Bottom" />
                    <ovo:WindowResizerThumb
                        Cursor="BottomRightCorner"
                        Grid.Column="2"
                        Grid.Row="2"
                        ResizeDirection="BottomRight" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>