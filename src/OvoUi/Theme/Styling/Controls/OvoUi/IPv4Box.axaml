<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <StackPanel Margin="20">
            <ovo:IPv4Box />
        </StackPanel>
    </Design.PreviewWith>

    <MenuFlyout x:Key="IPv4BoxMenuFlyout">
        <MenuItem
            Command="{Binding $parent[ovo:IPv4Box].Cut}"
            Header="{DynamicResource Lang.Cut}"
            InputGesture="{x:Static ovo:IPv4Box.CutKeyGesture}"
            x:Name="TextBoxContextFlyoutCutItem">
            <MenuItem.Icon>
                <PathIcon
                    Data="M256 192l-39.5-39.5c4.9-12.6 7.5-26.2 7.5-40.5C224 50.1 173.9 0 112 0S0 50.1 0 112s50.1 112 112 112c14.3 0 27.9-2.7 40.5-7.5L192 256l-39.5 39.5c-12.6-4.9-26.2-7.5-40.5-7.5C50.1 288 0 338.1 0 400s50.1 112 112 112s112-50.1 112-112c0-14.3-2.7-27.9-7.5-40.5L499.2 76.8c7.1-7.1 7.1-18.5 0-25.6c-28.3-28.3-74.1-28.3-102.4 0L256 192zm22.6 150.6L396.8 460.8c28.3 28.3 74.1 28.3 102.4 0c7.1-7.1 7.1-18.5 0-25.6L342.6 278.6l-64 64zM64 112a48 48 0 1 1 96 0 48 48 0 1 1 -96 0zm48 240a48 48 0 1 1 0 96 48 48 0 1 1 0-96z"
                    Margin="2,0,0,0"
                    Width="15" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem
            Command="{Binding $parent[ovo:IPv4Box].Copy}"
            Header="{DynamicResource Lang.Copy}"
            InputGesture="{x:Static ovo:IPv4Box.CopyKeyGesture}"
            x:Name="TextBoxContextFlyoutCopyItem">
            <MenuItem.Icon>
                <PathIcon
                    Data="M192 0c-41.8 0-77.4 26.7-90.5 64L64 64C28.7 64 0 92.7 0 128L0 448c0 35.3 28.7 64 64 64l256 0c35.3 0 64-28.7 64-64l0-320c0-35.3-28.7-64-64-64l-37.5 0C269.4 26.7 233.8 0 192 0zm0 64a32 32 0 1 1 0 64 32 32 0 1 1 0-64zM112 192l160 0c8.8 0 16 7.2 16 16s-7.2 16-16 16l-160 0c-8.8 0-16-7.2-16-16s7.2-16 16-16z"
                    Height="17"
                    Margin="1,0,0,0" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem
            Command="{Binding $parent[ovo:IPv4Box].Paste}"
            Header="{DynamicResource Lang.Paste}"
            InputGesture="{x:Static ovo:IPv4Box.PasteKeyGesture}"
            x:Name="TextBoxContextFlyoutPasteItem">
            <MenuItem.Icon>
                <PathIcon
                    Data="M160 0c-23.7 0-44.4 12.9-55.4 32L48 32C21.5 32 0 53.5 0 80L0 400c0 26.5 21.5 48 48 48l144 0 0-272c0-44.2 35.8-80 80-80l48 0 0-16c0-26.5-21.5-48-48-48l-56.6 0C204.4 12.9 183.7 0 160 0zM272 128c-26.5 0-48 21.5-48 48l0 272 0 16c0 26.5 21.5 48 48 48l192 0c26.5 0 48-21.5 48-48l0-220.1c0-12.7-5.1-24.9-14.1-33.9l-67.9-67.9c-9-9-21.2-14.1-33.9-14.1L320 128l-48 0zM160 40a24 24 0 1 1 0 48 24 24 0 1 1 0-48z"
                    Margin="2,0,0,0"
                    Width="15" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem
            Command="{Binding $parent[ovo:IPv4Box].Clear}"
            Header="{DynamicResource Lang.Clear}"
            x:Name="TextBoxContextFlyoutClearItem">
            <MenuItem.Icon>
                <PathIcon
                    Data="F1 M1024,1024z M0,0z M372.32,111.84C379.36,90.88,398.88,76.8,420.96,76.8L603.2,76.8C625.28,76.8,644.8,90.88,651.84,111.84L665.6,153.6 819.2,153.6C847.52,153.6 870.4,176.48 870.4,204.8 870.4,233.12 847.52,256 819.2,256L204.8,256C176.48,256 153.6,233.12 153.6,204.8 153.6,176.48 176.48,153.6 204.8,153.6L358.4,153.6 372.32,111.84z M204.8,332.8L819.2,332.8 819.2,819.2C819.2,875.68,773.28,921.6,716.8,921.6L307.2,921.6C250.72,921.6,204.8,875.68,204.8,819.2L204.8,332.8z M345.6,435.2C324.32,435.2,307.2,452.32,307.2,473.6L307.2,780.8C307.2,802.08 324.32,819.2 345.6,819.2 366.88,819.2 384,802.08 384,780.8L384,473.6C384,452.32,366.88,435.2,345.6,435.2z M512,435.2C490.72,435.2,473.6,452.32,473.6,473.6L473.6,780.8C473.6,802.08 490.72,819.2 512,819.2 533.28,819.2 550.4,802.08 550.4,780.8L550.4,473.6C550.4,452.32,533.28,435.2,512,435.2z M678.4,435.2C657.12,435.2,640,452.32,640,473.6L640,780.8C640,802.08 657.12,819.2 678.4,819.2 699.68,819.2 716.8,802.08 716.8,780.8L716.8,473.6C716.8,452.32,699.68,435.2,678.4,435.2z"
                    Margin="1,0,0,0"
                    Width="18" />
            </MenuItem.Icon>
        </MenuItem>
    </MenuFlyout>

    <ControlTheme TargetType="{x:Type ovo:IPv4Box}" x:Key="{x:Type ovo:IPv4Box}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="ShowLeadingZero" Value="True" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="{DynamicResource OvoCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBoxTextCaretBrush}" />
        <Setter Property="ContextFlyout" Value="{DynamicResource IPv4BoxMenuFlyout}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ovo:IPv4Box">
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Name="PART_Border">
                    <Grid ColumnDefinitions="1*, Auto, 1*, Auto, 1*, Auto, 1*" Width="{TemplateBinding Width}">
                        <TextPresenter
                            CaretBrush="{TemplateBinding CaretBrush}"
                            Cursor="IBeam"
                            Grid.Column="0"
                            MinWidth="8"
                            Name="{x:Static ovo:IPv4Box.PART_FirstTextPresenter}"
                            SelectionBrush="{TemplateBinding SelectionBrush}"
                            SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                            TextAlignment="{TemplateBinding TextAlignment}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Focusable="False"
                            Foreground="{TemplateBinding Foreground}"
                            Grid.Column="1"
                            Margin="0,4"
                            Text="."
                            VerticalAlignment="Center" />
                        <TextPresenter
                            CaretBrush="{TemplateBinding CaretBrush}"
                            Cursor="IBeam"
                            Grid.Column="2"
                            MinWidth="8"
                            Name="{x:Static ovo:IPv4Box.PART_SecondTextPresenter}"
                            SelectionBrush="{TemplateBinding SelectionBrush}"
                            SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                            TextAlignment="{TemplateBinding TextAlignment}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Foreground="{TemplateBinding Foreground}"
                            Grid.Column="3"
                            Margin="0,4"
                            Text="."
                            VerticalAlignment="Center" />
                        <TextPresenter
                            CaretBrush="{TemplateBinding CaretBrush}"
                            Cursor="IBeam"
                            Grid.Column="4"
                            MinWidth="8"
                            Name="{x:Static ovo:IPv4Box.PART_ThirdTextPresenter}"
                            SelectionBrush="{TemplateBinding SelectionBrush}"
                            SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                            TextAlignment="{TemplateBinding TextAlignment}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Foreground="{TemplateBinding Foreground}"
                            Grid.Column="5"
                            Margin="0,4"
                            Text="."
                            VerticalAlignment="Center" />
                        <TextPresenter
                            CaretBrush="{TemplateBinding CaretBrush}"
                            Cursor="IBeam"
                            Grid.Column="6"
                            MinWidth="8"
                            Name="{x:Static ovo:IPv4Box.PART_FourthTextPresenter}"
                            SelectionBrush="{TemplateBinding SelectionBrush}"
                            SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                            TextAlignment="{TemplateBinding TextAlignment}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource ControlPointeroverBackground}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource ControlPressedBackground}" />
        </Style>
        <Style Selector="^:focus-within /template/ Border#PART_Border" />
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource ControlDisabledBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>