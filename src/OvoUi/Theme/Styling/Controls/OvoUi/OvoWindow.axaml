<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme TargetType="ovo:OvoWindow" x:Key="{x:Type ovo:OvoWindow}">
        <Setter Property="Background" Value="{DynamicResource BackgroundColor}" />
        <Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource BackgroundColor}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="FontSize" Value="{DynamicResource TioFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource TioFontWeight}" />
        <Setter Property="FontFamily" Value="{DynamicResource TioFontFamily}" />
        <Setter Property="FrameBorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="-1" />
        <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
        <Setter Property="WindowDecorationsTheme" Value="{DynamicResource OvoWindowDecorationsTheme}" />
        <Setter Property="WindowDecorations" Value="{x:Static WindowDecorations.Full}" />
        <Setter Property="IsManagedResizerVisible">
            <OnPlatform>
                <On Options="Default">
                    <system:Boolean>False</system:Boolean>
                </On>
                <On Options="Linux">
                    <system:Boolean>True</system:Boolean>
                </On>
            </OnPlatform>
        </Setter>
        <Setter Property="FrameBorderCornerRadius">
            <OnPlatform>
                <On Options="Default">
                    <CornerRadius>0</CornerRadius>
                </On>
                <On Options="Linux">
                    <CornerRadius>10</CornerRadius>
                </On>
            </OnPlatform>
        </Setter>
        <Setter Property="FrameBorderThickness">
            <OnPlatform>
                <On Options="Default">
                    <Thickness>0</Thickness>
                </On>
                <On Options="Linux">
                    <Thickness>1</Thickness>
                </On>
            </OnPlatform>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="ovo:OvoWindow">
                <VisualLayerManager Name="PART_VisualLayerManager">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding FrameBorderBrush}"
                        BorderThickness="{TemplateBinding FrameBorderThickness}"
                        ClipToBounds="True"
                        CornerRadius="{TemplateBinding FrameBorderCornerRadius}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Duration="0.2" Property="BorderBrush" />
                                <ThicknessTransition Duration="0.2" Property="BorderThickness" />
                                <CornerRadiusTransition Duration="0.2" Property="CornerRadius" />
                            </Transitions>
                        </Border.Transitions>
                        <Panel>
                            <Border ClipToBounds="True" CornerRadius="{TemplateBinding FrameContentCornerRadius}">
                                <Border.Transitions>
                                    <Transitions>
                                        <CornerRadiusTransition Duration="0.2" Property="CornerRadius" />
                                    </Transitions>
                                </Border.Transitions>
                                <Panel>
                                    <Border Name="PART_Root">
                                        <DockPanel>
                                            <LayoutTransformControl
                                                DockPanel.Dock="Top"
                                                Name="PART_TitleBarAnimationHost"
                                                RenderTransformOrigin="0%,0%">
                                                <ovo:OvoTitleBar
                                                    CloseButtonIcon="{TemplateBinding ovo:OvoTitleBar.CloseButtonIcon}"
                                                    ControlButtonMargin="{TemplateBinding ovo:OvoTitleBar.ControlButtonMargin}"
                                                    ExitFullScreenButtonIcon="{TemplateBinding ovo:OvoTitleBar.ExitFullScreenButtonIcon}"
                                                    FullScreenButtonIcon="{TemplateBinding ovo:OvoTitleBar.FullScreenButtonIcon}"
                                                    IsCloseButtonVisible="{TemplateBinding ovo:OvoTitleBar.IsCloseButtonVisible}"
                                                    IsFullScreenButtonVisible="{TemplateBinding ovo:OvoTitleBar.IsFullScreenButtonVisible}"
                                                    IsMaximizeButtonVisible="{TemplateBinding ovo:OvoTitleBar.IsMaximizeButtonVisible}"
                                                    IsMinimizeButtonVisible="{TemplateBinding ovo:OvoTitleBar.IsMinimizeButtonVisible}"
                                                    IsPinButtonVisible="{TemplateBinding ovo:OvoTitleBar.IsPinButtonVisible}"
                                                    LeadingContent="{TemplateBinding ovo:OvoTitleBar.LeadingContent}"
                                                    MaximizeButtonIcon="{TemplateBinding ovo:OvoTitleBar.MaximizeButtonIcon}"
                                                    MinimizeButtonIcon="{TemplateBinding ovo:OvoTitleBar.MinimizeButtonIcon}"
                                                    Name="PART_TitleBar"
                                                    PinButtonIcon="{TemplateBinding ovo:OvoTitleBar.PinButtonIcon}"
                                                    RestoreButtonIcon="{TemplateBinding ovo:OvoTitleBar.RestoreButtonIcon}"
                                                    TitleBarHeight="{TemplateBinding ovo:OvoTitleBar.TitleBarHeight}"
                                                    TitleBarMargin="{TemplateBinding ovo:OvoTitleBar.TitleBarMargin}"
                                                    TitleBarPadding="{TemplateBinding ovo:OvoTitleBar.TitleBarPadding}"
                                                    TrailingContent="{TemplateBinding ovo:OvoTitleBar.TrailingContent}"
                                                    UnpinButtonIcon="{TemplateBinding ovo:OvoTitleBar.UnpinButtonIcon}" />
                                            </LayoutTransformControl>
                                            <ContentPresenter
                                                Content="{Binding $parent[ovo:OvoWindow].Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                DockPanel.Dock="Bottom"
                                                HorizontalContentAlignment="{Binding $parent[ovo:OvoWindow].HorizontalContentAlignment}"
                                                Margin="{Binding $parent[ovo:OvoWindow].Padding}"
                                                Name="PART_ContentPresenter"
                                                VerticalContentAlignment="{Binding $parent[ovo:OvoWindow].VerticalContentAlignment}" />
                                        </DockPanel>
                                    </Border>
                                    <Panel>
                                        <ovo:OverlayDialogHost
                                            HostId="{Binding $parent[ovo:OvoWindow].HostId}"
                                            IsModalStatusReporter="True"
                                            IsTopLevel="True"
                                            Name="PART_DialogHost" />
                                    </Panel>
                                </Panel>
                            </Border>
                            <ovo:WindowResizer IsVisible="{TemplateBinding IsManagedResizerVisible}" />
                        </Panel>
                    </Border>
                </VisualLayerManager>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme TargetType="WindowDrawnDecorations" x:Key="OvoWindowDecorationsTheme">
        <Setter Property="DefaultTitleBarHeight" Value="43" />
        <Setter Property="Template">
            <WindowDrawnDecorationsTemplate>
                <WindowDrawnDecorationsContent>
                    <WindowDrawnDecorationsContent.Underlay>
                        <Panel />
                    </WindowDrawnDecorationsContent.Underlay>
                    <WindowDrawnDecorationsContent.Overlay>
                        <Panel />
                    </WindowDrawnDecorationsContent.Overlay>
                </WindowDrawnDecorationsContent>
            </WindowDrawnDecorationsTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
