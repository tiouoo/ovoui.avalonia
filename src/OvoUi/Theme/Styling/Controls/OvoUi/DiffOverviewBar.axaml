<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia">

    <ControlTheme
        x:Key="{x:Type ovo:DiffOverviewBar}"
        TargetType="ovo:DiffOverviewBar">
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="{x:Static ovo:DiffOverviewBar.PART_Track}"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    ClipToBounds="True"
                    CornerRadius="{DynamicResource OvoCornerRadius}">
                    <Panel>
                        <ovo:DiffOverviewMarkerLayer
                            IsHitTestVisible="False" AddedBrush="{DynamicResource SuccessColor}" RemovedBrush="{DynamicResource ErrorColor}" ModifiedBrush="{DynamicResource SystemAccentColor}"
                            Markers="{TemplateBinding Markers}" />
                        <Border
                            Name="{x:Static ovo:DiffOverviewBar.PART_Thumb}"
                            VerticalAlignment="Top"
                            Background="{DynamicResource SystemAccentColorOpacity02}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource OvoCornerRadius}" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>

