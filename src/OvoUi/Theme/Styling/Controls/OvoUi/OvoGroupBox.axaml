<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme TargetType="ovo:OvoGroupBox" x:Key="{x:Type ovo:OvoGroupBox}">
        <Setter Property="Padding" Value="10" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource OvoCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ovo:OvoGroupBox">
                <ovo:GroupBoxBorder
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    HeaderSpacing="{TemplateBinding HeaderSpacing}"
                    Padding="{TemplateBinding Padding}">
                    <ovo:GroupBoxBorder.Header>
                        <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" />
                    </ovo:GroupBoxBorder.Header>
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ovo:GroupBoxBorder>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>