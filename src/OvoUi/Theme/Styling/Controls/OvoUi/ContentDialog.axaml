<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme TargetType="ovo:ContentDialogHost" x:Key="{x:Type ovo:ContentDialogHost}">
        <Setter Property="Template">
            <ControlTemplate TargetType="ovo:ContentDialogHost">
                <Panel>
                    <Border Background="#66000000" Name="PART_OverlayMask" />
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme TargetType="ovo:ContentDialog" x:Key="{x:Type ovo:ContentDialog}">
        <Setter Property="MinWidth" Value="320" />
        <Setter Property="MaxWidth" Value="560" />
        <Setter Property="MaxHeight" Value="720" />
        <Setter Property="CornerRadius" Value="{DynamicResource OvoCornerRadius}" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ovo:ContentDialog">
                <Border
                    Background="{DynamicResource PopupBackgroundBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    BoxShadow="{DynamicResource PopupBoxShadow}"
                    ClipToBounds="True"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Margin="10"
                    Name="PART_Border">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <ContentPresenter
                            Content="{TemplateBinding Title}"
                            ContentTemplate="{TemplateBinding TitleTemplate}"
                            FontSize="18"
                            FontWeight="600"
                            Margin="24,20,24,0"
                            TextBlock.TextWrapping="Wrap" />
                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            Margin="24,14,24,0"
                            VerticalScrollBarVisibility="Auto">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Name="PART_ContentPresenter" />
                        </ScrollViewer>
                        <Grid
                            ColumnDefinitions="*,*,*,*,*,*"
                            Grid.Row="2"
                            Margin="24,18,24,20">
                            <Button
                                Content="{TemplateBinding SecondaryButtonText}"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{TemplateBinding IsSecondaryButtonEnabled}"
                                IsVisible="False"
                                Margin="0,0,4,0"
                                Name="{x:Static ovo:ContentDialog.PART_SecondaryButton}" />
                            <Button
                                Content="{TemplateBinding CloseButtonText}"
                                Grid.Column="2"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Stretch"
                                IsVisible="False"
                                Margin="4,0"
                                Name="{x:Static ovo:ContentDialog.PART_CloseButton}" />
                            <Button
                                Content="{TemplateBinding PrimaryButtonText}"
                                Grid.Column="4"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{TemplateBinding IsPrimaryButtonEnabled}"
                                IsVisible="False"
                                Margin="4,0,0,0"
                                Name="{x:Static ovo:ContentDialog.PART_PrimaryButton}" />
                        </Grid>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:open">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:hidden">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:primary /template/ Button#PART_PrimaryButton">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="6" />
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^:secondary /template/ Button#PART_SecondaryButton">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="6" />
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^:close /template/ Button#PART_CloseButton">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="6" />
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^:primary:secondary /template/ Button#PART_SecondaryButton">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style Selector="^:primary:secondary /template/ Button#PART_PrimaryButton">
            <Setter Property="Grid.Column" Value="3" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style Selector="^:primary:close /template/ Button#PART_CloseButton">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style Selector="^:primary:close /template/ Button#PART_PrimaryButton">
            <Setter Property="Grid.Column" Value="3" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style Selector="^:secondary:close /template/ Button#PART_SecondaryButton">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style Selector="^:secondary:close /template/ Button#PART_CloseButton">
            <Setter Property="Grid.Column" Value="3" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style Selector="^:primary:secondary:close /template/ Button#PART_SecondaryButton">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style Selector="^:primary:secondary:close /template/ Button#PART_CloseButton">
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style Selector="^:primary:secondary:close /template/ Button#PART_PrimaryButton">
            <Setter Property="Grid.Column" Value="4" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style Selector="^:fullsize">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="MaxWidth" Value="Infinity" />
            <Setter Property="MaxHeight" Value="Infinity" />
            <Style Selector="^ /template/ Border#PART_Border">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Margin" Value="0" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
