<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <HeaderedContentControl Theme="{DynamicResource CardBorderTheme}" Width="500">
            <ovo:Banner
                CanClose="True"
                Classes="Bordered"
                Content="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat"
                Header="Title"
                Type="Warning" />
        </HeaderedContentControl>
    </Design.PreviewWith>
    <ControlTheme TargetType="ovo:Banner" x:Key="{x:Type ovo:Banner}">
        <Setter Property="Padding" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ovo:Banner">
                <Border
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Name="PART_Container"
                    Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="*, Auto">
                        <Grid
                            ColumnDefinitions="Auto, *"
                            Grid.Column="0"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                            <!--  Icon Area  -->
                            <Panel
                                Grid.Column="0"
                                IsVisible="{TemplateBinding ShowIcon}"
                                Margin="0 0 12 0"
                                VerticalAlignment="Top">
                                <ContentPresenter Content="{TemplateBinding Icon}" />
                                <PathIcon
                                    Classes="large"
                                    IsVisible="{TemplateBinding Icon,
                                                                Converter={x:Static ObjectConverters.IsNull}}"
                                    Name="PART_BuildInIcon"
                                    Theme="{DynamicResource InnerPathIcon}" />
                            </Panel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <ContentPresenter
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    TextElement.FontSize="18"
                                    TextElement.FontWeight="600"
                                    TextTrimming="CharacterEllipsis" />
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Button
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            IsVisible="{TemplateBinding CanClose}"
                            Margin="12 0 0 0"
                            Name="{x:Static ovo:Banner.PART_CloseButton}"
                            Theme="{DynamicResource CloseButtonTheme}"
                            VerticalAlignment="Top" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^.Bordered">
            <Setter Property="CornerRadius" Value="{DynamicResource OvoCornerRadius}" />
        </Style>
        <Style Selector="^ /template/ PathIcon#PART_BuildInIcon">
            <Setter Property="Data" Value="{DynamicResource IconInfoCircle}" />
            <Setter Property="Foreground" Value="{DynamicResource InfoColor}" />
        </Style>
        <Style Selector="^[Type=Information]">
            <Style Selector="^.Bordered /template/ Border#PART_Container">
                <Setter Property="BorderBrush" Value="{DynamicResource InfoColor}" />
            </Style>
            <Style Selector="^ /template/ Border#PART_Container">
                <Setter Property="Background" Value="{DynamicResource InfoColorOpacity01}" />
            </Style>
        </Style>
        <Style Selector="^[Type=Success]">
            <Style Selector="^.Bordered /template/ Border#PART_Container">
                <Setter Property="BorderBrush" Value="{DynamicResource SuccessColor}" />
            </Style>
            <Style Selector="^ /template/ Border#PART_Container">
                <Setter Property="Background" Value="{DynamicResource SuccessColorOpacity01}" />
            </Style>
            <Style Selector="^ /template/ PathIcon#PART_BuildInIcon">
                <Setter Property="Data" Value="{DynamicResource IconTickCircle}" />
                <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
            </Style>
        </Style>
        <Style Selector="^[Type=Warning]">
            <Style Selector="^.Bordered /template/ Border#PART_Container">
                <Setter Property="BorderBrush" Value="{DynamicResource WarnColor}" />
            </Style>
            <Style Selector="^ /template/ Border#PART_Container">
                <Setter Property="Background" Value="{DynamicResource WarnColorOpacity01}" />
            </Style>
            <Style Selector="^ /template/ PathIcon#PART_BuildInIcon">
                <Setter Property="Data" Value="{DynamicResource IconAlertTriangle}" />
                <Setter Property="Foreground" Value="{DynamicResource WarnColor}" />
            </Style>
        </Style>
        <Style Selector="^[Type=Error]">
            <Style Selector="^.Bordered /template/ Border#PART_Container">
                <Setter Property="BorderBrush" Value="{DynamicResource ErrorColor}" />
            </Style>
            <Style Selector="^ /template/ Border#PART_Container">
                <Setter Property="Background" Value="{DynamicResource ErrorColorOpacity01}" />
            </Style>
            <Style Selector="^ /template/ PathIcon#PART_BuildInIcon">
                <Setter Property="Data" Value="{DynamicResource IconAlertCircle}" />
                <Setter Property="Foreground" Value="{DynamicResource ErrorColor}" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
