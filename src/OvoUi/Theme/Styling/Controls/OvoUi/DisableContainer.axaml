<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme TargetType="ovo:DisableContainer" x:Key="{x:Type ovo:DisableContainer}">
        <Setter Property="Template">
            <ControlTemplate TargetType="ovo:DisableContainer">
                <Panel>
                    <ContentPresenter Content="{TemplateBinding Content}" />
                    <ovo:PureRectangle
                        Background="Transparent"
                        Cursor="No"
                        IsVisible="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content.IsEnabled, Converter={x:Static BoolConverters.Not}}"
                        ToolTip.Tip="{TemplateBinding DisabledTip}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>