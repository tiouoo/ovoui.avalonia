<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.PreviewWith>
        <StackPanel Margin="20" Spacing="20">
            <ovo:GroupBorder Header="Header">
                <Border
                    Background="Aquamarine"
                    Height="300"
                    Margin="20"
                    Width="400" />
            </ovo:GroupBorder>
        </StackPanel>
    </Design.PreviewWith>

    <ControlTheme TargetType="ovo:GroupBorder" x:Key="{x:Type ovo:GroupBorder}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource OvoCornerRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid RowDefinitions="Auto,1,*">
                            <ContentPresenter Content="{TemplateBinding Header}" Grid.Row="0">
                                <ContentPresenter.DataTemplates>
                                    <DataTemplate DataType="x:String">
                                        <Panel>
                                            <SelectableTextBlock
                                                Foreground="{DynamicResource ForegroundBrush}"
                                                IsVisible="{Binding $parent[ovo:GroupBorder].IsHeaderSelectable}"
                                                Margin="14,10"
                                                Name="SelectableText"
                                                Text="{Binding}" />
                                            <TextBlock
                                                Foreground="{DynamicResource ForegroundBrush}"
                                                IsVisible="{Binding $parent[ovo:GroupBorder].IsHeaderSelectable,
                                                                     Converter={x:Static BoolConverters.Not}}"
                                                Margin="14,10"
                                                Name="Text"
                                                Text="{Binding}" />
                                        </Panel>
                                    </DataTemplate>
                                </ContentPresenter.DataTemplates>
                            </ContentPresenter>
                            <Border
                                Background="{TemplateBinding BorderBrush}"
                                Grid.Row="1"
                                Height="1" />
                            <ContentPresenter
                                Content="{Binding $parent[ovo:GroupBorder].Content}"
                                Grid.Row="2"
                                Padding="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
