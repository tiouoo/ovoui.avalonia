<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme TargetType="ovo:ImageViewer" x:Key="{x:Type ovo:ImageViewer}">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="Focusable" Value="True" />

        <Setter Property="Template">
            <ControlTemplate TargetType="{x:Type ovo:ImageViewer}">
                <VisualLayerManager Name="{x:Static ovo:ImageViewer.PART_Layer}">
                    <Border Background="{TemplateBinding Background}" ClipToBounds="True">
                        <ovo:ImageViewerPresenter
                            BlendMode="{TemplateBinding BlendMode}"
                            ClipToBounds="False"
                            Name="{x:Static ovo:ImageViewer.PART_Image}"
                            OffsetX="{TemplateBinding OffsetX}"
                            OffsetY="{TemplateBinding OffsetY}"
                            Source="{TemplateBinding Source}"
                            Stretch="{TemplateBinding Stretch}"
                            StretchDirection="{TemplateBinding StretchDirection}"
                            Zoom="{TemplateBinding Zoom}" />
                    </Border>
                </VisualLayerManager>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:moving">
            <Setter Property="Cursor" Value="DragMove" />
        </Style>
    </ControlTheme>
</ResourceDictionary>