<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <StackPanel Margin="20" Spacing="12">
            <ovo:LoadingIcon Classes="large" />
            <ovo:LoadingIcon Classes="large" Theme="{StaticResource LoadingIconTrailTheme}" />
        </StackPanel>
    </Design.PreviewWith>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush
                Color="#2e3238"
                Opacity="0.05"
                x:Key="LoadingMaskBackground" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush
                Color="#ffffff"
                Opacity="0.12"
                x:Key="LoadingMaskBackground" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <ControlTheme TargetType="ovo:LoadingIcon" x:Key="LoadingIconTheme">
        <Setter Property="IsLoading" Value="True" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ovo:LoadingIcon">
                <Arc
                    Height="{TemplateBinding Height}"
                    IsVisible="{TemplateBinding IsVisible}"
                    Name="PART_Arc"
                    StartAngle="0"
                    Stroke="{TemplateBinding Foreground}"
                    StrokeJoin="Round"
                    StrokeLineCap="Round"
                    SweepAngle="260"
                    Width="{TemplateBinding Width}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Arc#PART_Arc">
            <Setter Property="StrokeThickness" Value="3" />
        </Style>
        <Style Selector="^.small">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Style Selector="^ /template/ Arc#PART_Arc">
                <Setter Property="StrokeThickness" Value="2" />
            </Style>
        </Style>
        <Style Selector="^.large">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Style Selector="^ /template/ Arc#PART_Arc">
                <Setter Property="StrokeThickness" Value="5" />
            </Style>
        </Style>
        <Style Selector="^[IsLoading=True] /template/ Arc#PART_Arc">
            <Style.Animations>
                <Animation Duration="0:0:0.6" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>

    <ControlTheme TargetType="ovo:LoadingIcon" x:Key="LoadingIconTrailTheme">
        <Setter Property="IsLoading" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ovo:LoadingIcon">
                <Arc
                    Height="{TemplateBinding Height}"
                    IsVisible="{TemplateBinding IsVisible}"
                    Name="PART_Arc"
                    StartAngle="0"
                    StrokeJoin="Round"
                    StrokeLineCap="Round"
                    SweepAngle="300"
                    Width="{TemplateBinding Width}">
                    <Arc.Stroke>
                        <ConicGradientBrush Angle="50">
                            <GradientStops>
                                <GradientStop Color="Transparent" Offset="0.4" />
                                <GradientStop Color="{DynamicResource SystemAccentColor}" Offset="0.8" />
                                <GradientStop Color="{DynamicResource SystemAccentColor}" Offset="1" />
                            </GradientStops>
                        </ConicGradientBrush>
                    </Arc.Stroke>
                </Arc>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Arc#PART_Arc">
            <Setter Property="StrokeThickness" Value="3" />
        </Style>
        <Style Selector="^.small">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Style Selector="^ /template/ Arc#PART_Arc">
                <Setter Property="StrokeThickness" Value="2" />
            </Style>
        </Style>
        <Style Selector="^.large">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Style Selector="^ /template/ Arc#PART_Arc">
                <Setter Property="StrokeThickness" Value="5" />
            </Style>
        </Style>
        <Style Selector="^[IsLoading=True] /template/ Arc#PART_Arc">
            <Style.Animations>
                <Animation Duration="0:0:0.6" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>

    <ControlTheme TargetType="ovo:Loading" x:Key="{x:Type ovo:Loading}">
        <Setter Property="Background" Value="{DynamicResource LoadingMaskBackground}" />
        <Setter Property="Indicator">
            <Template>
                <ovo:LoadingIcon IsLoading="{Binding $parent[ovo:Loading].IsLoading, Mode=TwoWay}" Theme="{StaticResource LoadingIconTheme}" />
            </Template>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="ovo:Loading">
                <Panel IsVisible="{TemplateBinding IsLoading}">
                    <ovo:PureRectangle
                        Background="{TemplateBinding Background}"
                        HorizontalAlignment="Stretch"
                        IsHitTestVisible="True"
                        VerticalAlignment="Stretch" />
                    <Grid
                        HorizontalAlignment="Center"
                        RowDefinitions="Auto, *"
                        VerticalAlignment="Center">
                        <ContentPresenter Content="{TemplateBinding Indicator}" HorizontalAlignment="Center" />
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Grid.Row="1"
                            IsVisible="{TemplateBinding Content,
                                                        Converter={x:Static ObjectConverters.IsNotNull}}"
                            Name="PART_ContentPresenter" />
                    </Grid>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme TargetType="ovo:LoadingContainer" x:Key="{x:Type ovo:LoadingContainer}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="MessageForeground" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="Background" Value="{DynamicResource LoadingMaskBackground}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Indicator">
            <Template>
                <ovo:LoadingIcon IsLoading="{Binding $parent[ovo:LoadingContainer].IsLoading, Mode=TwoWay}" Theme="{StaticResource LoadingIconTheme}" />
            </Template>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="ovo:LoadingContainer">
                <Panel>
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        Name="PART_ContentPresenter"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    <ovo:Loading
                        Background="{TemplateBinding Background}"
                        Content="{TemplateBinding LoadingMessage}"
                        ContentTemplate="{TemplateBinding LoadingMessageTemplate}"
                        Foreground="{TemplateBinding MessageForeground}"
                        Indicator="{TemplateBinding Indicator}"
                        IsLoading="{TemplateBinding IsLoading}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:loading /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Effect" Value="blur(5)" />
        </Style>
    </ControlTheme>

    <ControlTheme
        BasedOn="{StaticResource LoadingIconTheme}"
        TargetType="ovo:LoadingIcon"
        x:Key="{x:Type ovo:LoadingIcon}" />

</ResourceDictionary>
