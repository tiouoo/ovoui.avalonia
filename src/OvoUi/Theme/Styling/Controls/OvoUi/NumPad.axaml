<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme TargetType="{x:Type ovo:NumPad}" x:Key="{x:Type ovo:NumPad}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ovo:NumPad">
                <Border Background="Transparent" Padding="6">
                    <Border.Styles>
                        <Style Selector="ovo|NumPadButton">
                            <Setter Property="NumMode" Value="{Binding $parent[ovo:NumPad].NumMode}" />
                            <Setter Property="Command" Value="{Binding $parent[ovo:NumPad].ProcessClick}" />
                            <Setter Property="CommandParameter" Value="{Binding $self}" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Height" Value="54" />
                            <Setter Property="Margin" Value="1" />
                            <Setter Property="Width" Value="54" />
                        </Style>
                    </Border.Styles>
                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="*,*,*,*,*">
                        <ToggleButton
                            CornerRadius="5"
                            Focusable="False"
                            Grid.Column="0"
                            Grid.Row="0"
                            IsChecked="{TemplateBinding NumMode,
                                                        Mode=TwoWay}"
                            Margin="1"
                            MinHeight="54"
                            MinWidth="54"
                            Padding="0"
                            Theme="{StaticResource LightToggleButton}">
                            <TextBlock Text="Num&#x0a;Lock" TextAlignment="Center" />
                        </ToggleButton>
                        <ovo:NumPadButton
                            FunctionContent="/"
                            FunctionKey="Divide"
                            Grid.Column="1"
                            Grid.Row="0"
                            NumContent="/"
                            NumKey="Divide" />
                        <ovo:NumPadButton
                            FunctionContent="*"
                            FunctionKey="Multiply"
                            Grid.Column="2"
                            Grid.Row="0"
                            NumContent="*"
                            NumKey="Multiply" />
                        <ovo:NumPadButton
                            FunctionContent="-"
                            FunctionKey="Subtract"
                            Grid.Column="3"
                            Grid.Row="0"
                            NumContent="-"
                            NumKey="Subtract" />

                        <ovo:NumPadButton
                            FunctionContent="Home"
                            FunctionKey="Home"
                            Grid.Column="0"
                            Grid.Row="1"
                            NumContent="7"
                            NumKey="NumPad7" />
                        <ovo:NumPadButton
                            FunctionContent="Up"
                            FunctionKey="Up"
                            Grid.Column="1"
                            Grid.Row="1"
                            NumContent="8"
                            NumKey="NumPad8" />
                        <ovo:NumPadButton
                            FunctionContent="Page Up"
                            FunctionKey="PageUp"
                            Grid.Column="2"
                            Grid.Row="1"
                            NumContent="9"
                            NumKey="NumPad9" />
                        <ovo:NumPadButton
                            FunctionContent="+"
                            FunctionKey="Add"
                            Grid.Column="3"
                            Grid.Row="1"
                            NumContent="+"
                            NumKey="Add" />

                        <ovo:NumPadButton
                            FunctionContent="Left"
                            FunctionKey="Left"
                            Grid.Column="0"
                            Grid.Row="2"
                            NumContent="4"
                            NumKey="NumPad4" />
                        <ovo:NumPadButton
                            FunctionKey="None"
                            Grid.Column="1"
                            Grid.Row="2"
                            NumContent="5"
                            NumKey="NumPad5" />
                        <ovo:NumPadButton
                            FunctionContent="Right"
                            FunctionKey="Right"
                            Grid.Column="2"
                            Grid.Row="2"
                            NumContent="6"
                            NumKey="NumPad6" />
                        <ovo:NumPadButton
                            FunctionContent="←"
                            FunctionKey="Back"
                            Grid.Column="3"
                            Grid.Row="2"
                            NumContent="←"
                            NumKey="Back" />

                        <ovo:NumPadButton
                            FunctionContent="End"
                            FunctionKey="End"
                            Grid.Column="0"
                            Grid.Row="3"
                            NumContent="1"
                            NumKey="NumPad1" />
                        <ovo:NumPadButton
                            FunctionContent="Down"
                            FunctionKey="Down"
                            Grid.Column="1"
                            Grid.Row="3"
                            NumContent="2"
                            NumKey="NumPad2" />
                        <ovo:NumPadButton
                            FunctionContent="Page Down"
                            FunctionKey="PageDown"
                            Grid.Column="2"
                            Grid.Row="3"
                            NumContent="3"
                            NumKey="NumPad3" />
                        <ovo:NumPadButton
                            FunctionContent="Enter"
                            FunctionKey="Enter"
                            Grid.Column="3"
                            Grid.Row="3"
                            Grid.RowSpan="2"
                            Height="NaN"
                            NumContent="Enter"
                            NumKey="Enter" />

                        <ovo:NumPadButton
                            FunctionContent="Insert"
                            FunctionKey="Insert"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Grid.Row="4"
                            NumContent="0"
                            NumKey="NumPad0"
                            Width="NaN" />
                        <ovo:NumPadButton
                            FunctionContent="Delete"
                            FunctionKey="Delete"
                            Grid.Column="2"
                            Grid.Row="4"
                            NumContent="."
                            NumKey="Decimal" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme TargetType="{x:Type ovo:NumPadButton}" x:Key="{x:Type ovo:NumPadButton}">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ovo:NumPadButton">
                <Border
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Name="PART_Background">
                    <Panel>
                        <ContentPresenter
                            Content="{TemplateBinding NumContent}"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=NumMode}"
                            VerticalAlignment="Center" />
                        <ContentPresenter
                            Content="{TemplateBinding FunctionContent}"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=!NumMode}"
                            VerticalAlignment="Center" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource ControlPointeroverBackground}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource ControlPressedBackground}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>