<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="Controls/OvoUi/@OvoUi.axaml" />
                <ResourceInclude Source="Controls/Basic/@Basic.axaml" />
                <ResourceInclude Source="Controls/ColorPicker/@ColorPicker.axaml" />
                <!-- DataGrid uses dynamic code; applications that need it can include
                     Controls/DataGrid/DataGrid.axaml explicitly in non-AOT builds. -->
                <ResourceInclude Source="Components/@Components.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    <StyleInclude Source="Styles/@Styles.axaml" />
</Styles>
