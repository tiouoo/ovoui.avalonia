<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:o="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="o|Skeleton[IsActive=True][IsLoading=True] /template/ o|PureRectangle#PART_ActiveBorder">
        <Style.Animations>
            <Animation
                Duration="0:0:1.4"
                Easing="CubicEaseInOut"
                FillMode="None"
                IterationCount="Infinite"
                PlaybackDirection="Alternate">
                <KeyFrame Cue="0%">
                    <Setter Property="Background" Value="{DynamicResource SkeletonStartAnimationBackground}" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Background" Value="{DynamicResource SkeletonEndAnimationBackground}" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
</Styles>
