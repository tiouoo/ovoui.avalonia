<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Button AccessText">
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
    <Style Selector="RadioButton AccessText">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
    <Style Selector="AutoCompleteBox /template/ TextBox /template/ ContentPresenter TextBlock">
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
    <Style Selector="ovo|KeyGestureInput /template/ ContentPresenter TextBlock">
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
    <Style Selector="TextBox /template/ DataValidationErrors ContentPresenter TextBlock">
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
</Styles>