<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="ForegroundColor">#282637</Color>
            <Color x:Key="InnerForegroundColor">#777282</Color>
            <Color x:Key="BackgroundColor">#f8f9fa</Color>
            <Color x:Key="LineColor">#e9e6ef</Color>
            <Color x:Key="PanelBackgroundColor">#f5f5f5</Color>
            <Color x:Key="PopupBackgroundColor">#ffffff</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>