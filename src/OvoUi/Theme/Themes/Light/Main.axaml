<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="ForegroundColor">#494c4f</Color>
            <Color x:Key="InnerForegroundColor">#565657</Color>
            <Color x:Key="BackgroundColor">#f8f9fa</Color>
            <Color x:Key="LineColor">#efeff1</Color>
            <Color x:Key="PanelBackgroundColor">#FDFEFEFE</Color>
            <Color x:Key="PopupBackgroundColor">#ffffff</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>