<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="ForegroundColor">#e6e1cf</Color>
            <Color x:Key="InnerForegroundColor">#c4c4c4</Color>
            <Color x:Key="BackgroundColor">#161617</Color>
            <Color x:Key="LineColor">#3b3833</Color>
            <Color x:Key="PanelBackgroundColor">#191a1c</Color>
            <Color x:Key="PopupBackgroundColor">#252525</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>