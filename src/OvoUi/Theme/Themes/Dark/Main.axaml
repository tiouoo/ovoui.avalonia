<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="ForegroundColor">#e6e1cf</Color>
            <Color x:Key="InnerForegroundColor">#d2c8dd</Color>
            <Color x:Key="BackgroundColor">#1d1b27</Color>
            <Color x:Key="LineColor">#3b3833</Color>
            <Color x:Key="PanelBackgroundColor">#252330</Color>
            <Color x:Key="PopupBackgroundColor">#181716</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>