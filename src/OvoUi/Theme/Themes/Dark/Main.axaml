<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="ForegroundColor">#e6e1cf</Color>
            <Color x:Key="InnerForegroundColor">#c4c4c4</Color>
            <Color x:Key="BackgroundColor">#161617</Color>
            <Color x:Key="LineColor">#3b3833</Color>
            <Color x:Key="PanelBackgroundColor">#191a1c</Color>
            <Color x:Key="PopupBackgroundColor">#252525</Color>

            <SolidColorBrush Color="{StaticResource ForegroundColor}" x:Key="ForegroundBrush" />
            <SolidColorBrush Color="{StaticResource InnerForegroundColor}" x:Key="InnerForegroundBrush" />
            <SolidColorBrush Color="{StaticResource BackgroundColor}" x:Key="BackgroundBrush" />
            <SolidColorBrush
                Color="{StaticResource LineColor}"
                Opacity="{DynamicResource SolidOpacity}"
                x:Key="LineBrush" />
            <SolidColorBrush
                Color="{StaticResource PanelBackgroundColor}"
                Opacity="{DynamicResource SolidOpacity}"
                x:Key="PanelBackgroundBrush" />
            <SolidColorBrush
                Color="{StaticResource PopupBackgroundColor}"
                Opacity="{DynamicResource SolidOpacity}"
                x:Key="PopupBackgroundBrush" />
            <SolidColorBrush
                Color="{StaticResource LineColor}"
                Opacity="{DynamicResource TranslucentOpacity}"
                x:Key="TranslucentLineBrush" />
            <SolidColorBrush
                Color="{StaticResource PanelBackgroundColor}"
                Opacity="{DynamicResource TranslucentOpacity}"
                x:Key="TranslucentPanelBackgroundBrush" />
            <SolidColorBrush
                Color="{StaticResource PopupBackgroundColor}"
                Opacity="{DynamicResource TranslucentOpacity}"
                x:Key="TranslucentPopupBackgroundBrush" />
            <SolidColorBrush
                Color="{StaticResource PanelBackgroundColor}"
                Opacity="{DynamicResource TranslucentOpacity}"
                x:Key="ShowcaseHeaderBackgroundBrush" />
            <SolidColorBrush
                Color="{StaticResource PopupBackgroundColor}"
                Opacity="{DynamicResource TranslucentOpacity}"
                x:Key="ShowcaseCodeBackgroundBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>