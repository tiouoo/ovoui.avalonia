<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush
        Color="#191d21"
        Opacity="{DynamicResource SolidOpacity}"
        x:Key="TitleBarBackgroundColor" />

    <SolidColorBrush
        Color="White"
        Opacity="0.08"
        x:Key="ItemPointeroverBackground" />
    <SolidColorBrush
        Color="White"
        Opacity="0.12"
        x:Key="ItemSelectedBackground" />

    <SolidColorBrush
        Color="#F9F9F9"
        Opacity="0.35"
        x:Key="DisabledForegroundBrush" />

    <SolidColorBrush
        Color="#FFFFFF"
        Opacity="0.12"
        x:Key="ControlBackground" />
    <SolidColorBrush
        Color="#FFFFFF"
        Opacity="0.16"
        x:Key="ControlPointeroverBackground" />
    <SolidColorBrush
        Color="#FFFFFF"
        Opacity="0.20"
        x:Key="ControlPressedBackground" />

    <BoxShadows x:Key="PopupBoxShadow">0 0 8 1 #28000000</BoxShadows>

</ResourceDictionary>
