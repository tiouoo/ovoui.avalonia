<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Title>OvoUi.AvaloniaEdit</Title>
        <Description>OvoUi code block and themed AvaloniaEdit integration with TextMate highlighting.</Description>
        <PackageTags>avalonia;avaloniaedit;code-editor;syntax-highlighting;textmate</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\OvoUi\OvoUi.csproj" />
    </ItemGroup>

    <ItemGroup>
      <AvaloniaResource Include="Assets\Highlighting\*.xshd" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
      <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    </ItemGroup>

</Project>
