<Styles
    x:Class="OvoUi.AvaloniaEdit.OvoAvaloniaEditTheme"
    xmlns="https://github.com/avaloniaui"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <system:Double x:Key="ControlContentThemeFontSize">14</system:Double>
            <FontFamily x:Key="ContentControlThemeFontFamily">Arial, sans-serif</FontFamily>
            <FontFamily x:Key="OvoCodeFontFamily">Cascadia Code, Consolas, Menlo, Monospace</FontFamily>
            <Thickness x:Key="ToolTipBorderThemeThickness">1</Thickness>
            <SolidColorBrush Color="{DynamicResource SystemAccentColor}" x:Key="TextViewLinkTextForeground" />
            <SolidColorBrush
                Color="{DynamicResource SystemAccentColor}"
                Opacity="0.24"
                x:Key="TextAreaSelectionBrush" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush Color="#FAFAFA" x:Key="ToolTipBackground" />
                    <SolidColorBrush Color="#494C4F" x:Key="ToolTipForeground" />
                    <SolidColorBrush Color="#26000000" x:Key="ToolTipBorderBrush" />
                    <SolidColorBrush Color="#FAFAFA" x:Key="OvoCodeEditorBackground" />
                    <SolidColorBrush Color="#F0F0F0" x:Key="OvoCodeHeaderBackground" />
                    <SolidColorBrush Color="#D3D4D5" x:Key="OvoCodeBorderBrush" />
                    <SolidColorBrush Color="#383A42" x:Key="OvoCodeForeground" />
                    <SolidColorBrush Color="#9D9D9F" x:Key="OvoCodeLineNumberForeground" />
                    <SolidColorBrush Color="#D4D4D4" x:Key="TextAreaSelectionBrush" />
                    <Color x:Key="SystemChromeMediumColor">#F0F0F0</Color>
                    <Color x:Key="SystemBaseLowColor">#26000000</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush Color="#292B2E" x:Key="ToolTipBackground" />
                    <SolidColorBrush Color="#E6E1CF" x:Key="ToolTipForeground" />
                    <SolidColorBrush Color="#33FFFFFF" x:Key="ToolTipBorderBrush" />
                    <SolidColorBrush Color="#181A1F" x:Key="OvoCodeEditorBackground" />
                    <SolidColorBrush Color="#22252B" x:Key="OvoCodeHeaderBackground" />
                    <SolidColorBrush Color="#343842" x:Key="OvoCodeBorderBrush" />
                    <SolidColorBrush Color="#D8DEE9" x:Key="OvoCodeForeground" />
                    <SolidColorBrush Color="#727A88" x:Key="OvoCodeLineNumberForeground" />
                    <SolidColorBrush Color="#264F78" x:Key="TextAreaSelectionBrush" />
                    <Color x:Key="SystemChromeMediumColor">#22252B</Color>
                    <Color x:Key="SystemBaseLowColor">#33FFFFFF</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush Color="#FAFAFA" x:Key="ToolTipBackground" />
                    <SolidColorBrush Color="#494C4F" x:Key="ToolTipForeground" />
                    <SolidColorBrush Color="#26000000" x:Key="ToolTipBorderBrush" />
                    <SolidColorBrush Color="#FAFAFA" x:Key="OvoCodeEditorBackground" />
                    <SolidColorBrush Color="#F0F0F0" x:Key="OvoCodeHeaderBackground" />
                    <SolidColorBrush Color="#D3D4D5" x:Key="OvoCodeBorderBrush" />
                    <SolidColorBrush Color="#383A42" x:Key="OvoCodeForeground" />
                    <SolidColorBrush Color="#9D9D9F" x:Key="OvoCodeLineNumberForeground" />
                    <SolidColorBrush Color="#D4D4D4" x:Key="TextAreaSelectionBrush" />
                    <Color x:Key="SystemChromeMediumColor">#F0F0F0</Color>
                    <Color x:Key="SystemBaseLowColor">#26000000</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="/Themes/CodeBlock.axaml" />
</Styles>
