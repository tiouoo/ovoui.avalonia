<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <PackageId>OvoUi.Lang</PackageId>
        <Description>Reactive, strongly typed Avalonia localization with configurable resource paths and multilingual IntelliSense.</Description>
        <PackageTags>avalonia;localization;i18n;resx;json;source-generator;aot</PackageTags>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <IsPackable>true</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4"/>
        <PackageReference Include="OvoUi.Lang.Generator" Version="[$(PackageVersion)]" PrivateAssets="none" Condition="'$(NuGetRelease)' == 'true'"/>
        <ProjectReference Include="../OvoUi.Lang.Generator/OvoUi.Lang.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" GlobalPropertiesToRemove="PublishAot;RuntimeIdentifier;SelfContained"/>
        <None Include="../../LICENSE" Pack="true" PackagePath="/"/>
        <None Include="buildTransitive/OvoUi.Lang.props" Pack="true" PackagePath="buildTransitive/"/>
    </ItemGroup>
</Project>
