<Project>
    <PropertyGroup>
        <Version>1.0.0</Version>
        <Authors>tiouo</Authors>
        <Company>tiouo</Company>
        <Product>OvoUi</Product>
        <Copyright>Copyright (c) 2026 tiouo</Copyright>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/tiouoo/ovoui.avalonia</RepositoryUrl>
        <PackageProjectUrl>https://github.com/tiouoo/ovoui.avalonia</PackageProjectUrl>
        <PackageIcon>icon_256.png</PackageIcon>
    </PropertyGroup>
    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)..\assets\icon_256.png" Pack="true" PackagePath="/" Visible="false"/>
    </ItemGroup>
</Project>
