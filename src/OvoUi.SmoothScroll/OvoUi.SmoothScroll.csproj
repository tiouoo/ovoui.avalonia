<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>OvoUi.SmoothScroll</PackageId>
        <AssemblyName>OvoUi.SmoothScroll</AssemblyName>
        <RootNamespace>OvoUi.SmoothScroll</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <LangVersion>latest</LangVersion>
        <DefineConstants>$(DefineConstants);OVO_SMOOTH_SCROLL</DefineConstants>
        <Title>OvoUi Smooth Scroll</Title>
        <Description>Smooth scrolling, panning, multi-touch zoom, elastic overscroll and composition interaction tracking for Avalonia.</Description>
        <PackageTags>avalonia;ovoui;scroll;pan;zoom;interaction;composition</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="..\OvoUi.Shared\Zoom\ZoomMinimap.cs" Link="Controls\ZoomMinimap.cs" />
        <IgnoresAccessChecksTo Include="Avalonia.Base"/>
        <IgnoresAccessChecksTo Include="Avalonia.Controls"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\OvoUi\OvoUi.csproj"/>
        <PackageReference Include="Avalonia" Version="12.1.4"/>
        <PackageReference Include="IgnoresAccessChecksToGenerator" Version="0.8.0" PrivateAssets="all"/>
        <PackageReference Include="PropertyGenerator.Avalonia" Version="1.3.1" PrivateAssets="all"/>
    </ItemGroup>
    <ItemGroup>
        <None Update="README.md;LICENSE.txt;THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\"/>
    </ItemGroup>
</Project>
