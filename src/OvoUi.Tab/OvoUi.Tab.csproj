<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>OvoUi.Tab</PackageId>
        <AssemblyName>OvoUi.Tab</AssemblyName>
        <RootNamespace>OvoUi.Tab</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Title>OvoUi Tab</Title>
        <Description>Animated, detachable tab hosts and tab windows for Avalonia applications.</Description>
        <PackageTags>avalonia;ui;tabs;tab-window;drag-drop</PackageTags>
        <PackageIcon>icon_256.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\OvoUi\OvoUi.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\assets\icon_256.png" Pack="true" PackagePath="\" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
