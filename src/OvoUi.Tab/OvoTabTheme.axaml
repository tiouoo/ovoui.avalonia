<Styles
    x:Class="OvoUi.Tab.OvoTabTheme"
    xmlns="https://github.com/avaloniaui"
    xmlns:ovo="https://github.com/tiouoo/ovoui.avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/OvoTabHost.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    <StyleInclude Source="/Themes/OvoTabScrollViewer.axaml" />
    <Style Selector="ovo|SelectionList.ovotab-list ovo|SelectionListItem Border.tab-root">
        <Setter Property="Background" Value="{DynamicResource OvoTabBackground}" />
    </Style>
    <Style Selector="ovo|SelectionList.ovotab-list ovo|SelectionListItem Button.tab-close">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ovo|SelectionList.ovotab-list ovo|SelectionListItem:pointerover Border.tab-root">
        <Setter Property="Background" Value="{DynamicResource OvoTabHover}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ovo|SelectionList.ovotab-list ovo|SelectionListItem:pointerover Button.tab-close">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ovo|SelectionList.ovotab-list ovo|SelectionListItem:selected Border.tab-root">
        <Setter Property="Background" Value="{DynamicResource OvoTabSelected}" />
    </Style>
    <Style Selector="ovo|SelectionList.ovotab-list ovo|SelectionListItem:selected Button.tab-close">
        <Setter Property="Opacity" Value="1" />
    </Style>
</Styles>
