<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Title>OvoUi Fonts</Title>
        <Description>Font resources for OvoUi Avalonia applications.</Description>
        <PackageTags>avalonia;ui;font;fonts</PackageTags>
        <PackageIcon>icon_256.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="..\..\assets\AlimamaFangYuanTi-Regular.ttf">
            <Link>AlimamaFangYuanTi-Regular.ttf</Link>
        </AvaloniaResource>
        <AvaloniaResource Include="..\..\assets\AlimamaFangYuanTi-Bold.ttf">
            <Link>AlimamaFangYuanTi-Bold.ttf</Link>
        </AvaloniaResource>
        <None Include="Assets\icon_256.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\OvoUi\OvoUi.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="OvoUiFont.axmal.cs">
        <DependentUpon>OvoUiTheme.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>

</Project>
